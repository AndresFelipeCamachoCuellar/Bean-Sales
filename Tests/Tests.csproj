<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proyecto de pruebas unitarias. NO está incluido en Bean-Sales.slnx a propósito:
    así `dotnet build` / `dotnet publish` de la solución y el workflow de despliegue
    (que apunta explícitamente a Web/Web.csproj) siguen funcionando igual que antes.

    Para correrlo:  dotnet test Tests/Tests.csproj
    Para añadirlo a la solución (opcional):  dotnet sln Bean-Sales.slnx add Tests/Tests.csproj
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!--
      Proveedor EF REAL para los tests de aislamiento multi-tenant (E5.2).

      ⚠️ Deliberadamente SQLite y NO Microsoft.EntityFrameworkCore.InMemory:
        · InMemory no traduce LINQ a SQL, así que un filtro mal construido (por ejemplo
          uno que EF no sabría traducir) pasaría en verde y reventaría en producción.
        · InMemory no soporta transacciones ni `rowversion`, que el proyecto ya usa en
          InventoryService y StockItem.
      Con SQLite en memoria (`DataSource=:memory:`) hay SQL de verdad, esquema de verdad y
      transacciones, y cada test corre contra una base limpia y aislada.

      La versión sigue a la del proveedor de SQL Server en Web/Web.csproj: si se sube una,
      hay que subir la otra o NuGet resolverá dos versiones distintas de EF Core.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Web\Web.csproj" />
  </ItemGroup>

</Project>
