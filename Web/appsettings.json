{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=BeanSales;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Shipping": {
    "Provider": "Fixed",
    "FallbackCost": 18000,
    "FallbackDays": 4,
    "QuoteCacheMinutes": 15,
    "CityCacheHours": 12,
    "Origin": {
      "DaneCode": "",
      "CityName": "",
      "Department": ""
    },
    "Defaults": {
      "WeightGrams": 500,
      "LengthCm": 20,
      "WidthCm": 12,
      "HeightCm": 8,
      "PackingFactor": 1.15,
      "MinBoxLengthCm": 15,
      "MinBoxWidthCm": 15,
      "MinBoxHeightCm": 10,
      "MaxPackageWeightKg": 30,
      "MinBillableWeightKg": 1
    },
    "Mipaquete": {
      "BaseUrl": "https://core.mipaquete.com",
      "QuotePath": "routes/quoteShipping",
      "TimeoutSeconds": 4,
      "CustomerKey": "",
      "OriginCountryCode": "170",
      "DestinyCountryCode": "170",
      "ApiKey": "",
      "SessionTracker": ""
    }
  },
  "Cloudinary": {
    "Enabled": true,
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": "",
    "Folder": "bean/products",
    "UploadPreset": "",
    "ApiBaseUrl": "https://api.cloudinary.com",
    "MaxImagesPerProduct": 6,
    "MaxFileSizeBytes": 5242880,
    "MinDimensionPx": 800,
    "AllowedFormats": [ "jpg", "jpeg", "png", "webp" ],
    "SignatureTtlSeconds": 600,
    "DeleteTimeoutSeconds": 6,
    "VerifyResponseSignature": true,
    "MaxTicketsPerMinute": 20
  },
  "Wompi": {
    "Enabled": true,
    "Environment": "Sandbox",
    "BaseUrl": "https://sandbox.wompi.co/v1",
    "CheckoutUrl": "https://checkout.wompi.co/p/",
    "PublicKey": "",
    "PrivateKey": "",
    "IntegritySecret": "",
    "EventsSecret": "",
    "Currency": "COP",
    "PaymentExpirationMinutes": 45,
    "TimeoutSeconds": 8,
    "ReferencePrefix": "BEAN"
  }
}
