@model Web.Models.ViewModels.CompanyProfileViewModel

@{
    ViewData["Title"] = "Editar Empresa";
    Layout = "_Layout";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Editar Información</h1>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Datos de la Empresa</h6>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="ProviderID" />
                <input type="hidden" asp-for="Name" /> <!-- Name read-only for now -->
                <input type="hidden" asp-for="NIT" /> <!-- NIT read-only -->
                <input type="hidden" asp-for="Email" /> <!-- Email read-only -->

                <div class="row">
                    <div class="col-md-6 mb-3">
                         <div class="form-floating text-muted">
                            <input asp-for="Name" class="form-control" placeholder="Nombre" disabled />
                            <label asp-for="Name"></label>
                            <small class="text-muted ps-2">El nombre no se puede editar.</small>
                        </div>
                    </div>
                     <div class="col-md-6 mb-3">
                         <div class="form-floating text-muted">
                            <input asp-for="NIT" class="form-control" placeholder="NIT" disabled />
                            <label asp-for="NIT"></label>
                            <small class="text-muted ps-2">El NIT no se puede editar.</small>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                         <div class="form-floating">
                            <input asp-for="Phone" class="form-control" placeholder="Teléfono" />
                            <label asp-for="Phone"></label>
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                    </div>
                     <div class="col-md-6 mb-3">
                        <div class="form-floating text-muted">
                            <input asp-for="Email" class="form-control" placeholder="Email" disabled />
                            <label asp-for="Email"></label>
                             <small class="text-muted ps-2">Contacte a soporte para cambiar el email.</small>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="Address" class="form-control" placeholder="Dirección" />
                        <label asp-for="Address"></label>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Guardar Cambios</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
