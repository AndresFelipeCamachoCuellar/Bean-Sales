@model Web.Models.ViewModels.CompanyProfileViewModel

@{
    ViewData["Title"] = "Perfil de la Empresa";
    Layout = "_Layout";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Perfil de la Empresa</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">Información General</h6>
            
            @using Web.Services
            @using Web.Constants
            @inject IPermissionService PermissionService
            @using Microsoft.AspNetCore.Identity
            @inject UserManager<ApplicationUser> UserManager
            
            @{
                var user = await UserManager.GetUserAsync(User);
                if (await PermissionService.HasPermissionAsync(user, Modules.CompanyProfile, Permissions.Update))
                {
                    <a asp-action="Edit" class="btn btn-primary btn-sm">
                        <i class="fas fa-edit"></i> Editar Información
                    </a>
                }
            }
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="small mb-1 font-weight-bold">Nombre de la Empresa</label>
                    <div class="form-control-plaintext border p-2 rounded bg-light">@Model.Name</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="small mb-1 font-weight-bold">NIT</label>
                    <div class="form-control-plaintext border p-2 rounded bg-light">@Model.NIT</div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="small mb-1 font-weight-bold">Email Corporativo</label>
                    <div class="form-control-plaintext border p-2 rounded bg-light">@Model.Email</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="small mb-1 font-weight-bold">Teléfono</label>
                    <div class="form-control-plaintext border p-2 rounded bg-light">@Model.Phone</div>
                </div>
            </div>
             <div class="row">
                <div class="col-md-12 mb-3">
                    <label class="small mb-1 font-weight-bold">Dirección</label>
                    <div class="form-control-plaintext border p-2 rounded bg-light">@Model.Address</div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="small mb-1 font-weight-bold">Estado en Plataforma</label>
                    <div>
                        @if (Model.ApprovalStatus == "Approved")
                        {
                            <span class="badge bg-success p-2">Aprobado</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark p-2">@Model.ApprovalStatus</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
