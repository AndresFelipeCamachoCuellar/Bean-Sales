@model Web.Models.ViewModels.PricingSettingsViewModel

@{
    ViewData["Title"] = "Configuración de márgenes";
    Layout = "_LayoutAdminTailwind";
}

<header class="flex flex-col gap-6 border-b border-ink/15 pb-7 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
        <h1 class="font-display text-3xl leading-none tracking-[-0.04em] text-ink sm:text-4xl">Configuración de márgenes</h1>
        <p class="mt-3 text-sm leading-6 text-ink/65 sm:text-base">Estos tres valores gobiernan el precio sugerido y la bandeja “Márgenes por revisar”. Guardar recalcula la alerta de todo el catálogo.</p>
    </div>
    <a asp-action="Index" class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 self-start border border-ink/20 bg-white px-5 py-3 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream lg:self-auto">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6"/></svg>
        Volver
    </a>
</header>

@if (TempData["PricingOk"] != null)
{
    <div class="mt-6 flex items-start gap-3 border border-leaf/30 bg-leaf/10 px-4 py-3 text-sm font-semibold leading-6 text-leaf" role="status">
        <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></svg>
        <div>@TempData["PricingOk"]</div>
    </div>
}

<div class="mt-8 border border-ink/15 bg-white p-4 sm:p-6 lg:p-8">
    <form asp-action="Settings" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="mb-6 hidden border border-clay bg-clay/10 p-4 text-sm font-semibold leading-6 text-clay-dark [&.validation-summary-errors]:block [&_ul]:space-y-1" role="alert" aria-live="polite"></div>

        <div class="grid gap-5 lg:grid-cols-3">
            <div>
                <label asp-for="TargetMarginPercent" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65"></label>
                <div class="relative mt-2">
                    <input asp-for="TargetMarginPercent" class="min-h-12 w-full border border-ink/25 bg-cream px-4 py-2 pr-10 text-base text-ink caret-clay outline-none transition-colors hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" type="number" step="0.01" min="0" max="99.99" />
                    <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center font-data text-xs font-semibold text-ink/45">%</span>
                </div>
                <span asp-validation-for="TargetMarginPercent" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
                <span class="mt-2 block text-xs font-medium leading-5 text-ink/50">Alimenta el precio sugerido. Es la meta.</span>
            </div>

            <div>
                <label asp-for="MinimumMarginPercent" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65"></label>
                <div class="relative mt-2">
                    <input asp-for="MinimumMarginPercent" class="min-h-12 w-full border border-ink/25 bg-cream px-4 py-2 pr-10 text-base text-ink caret-clay outline-none transition-colors hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" type="number" step="0.01" min="0" max="99.99" />
                    <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center font-data text-xs font-semibold text-ink/45">%</span>
                </div>
                <span asp-validation-for="MinimumMarginPercent" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
                <span class="mt-2 block text-xs font-medium leading-5 text-ink/50">Umbral de la alerta. Es el piso, no la meta.</span>
            </div>

            <div>
                <label asp-for="RoundingStep" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65"></label>
                <input asp-for="RoundingStep" class="mt-2 min-h-12 w-full border border-ink/25 bg-cream px-4 py-2 text-base text-ink caret-clay outline-none transition-colors hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" type="number" step="1" min="1" />
                <span asp-validation-for="RoundingStep" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
                <span class="mt-2 block text-xs font-medium leading-5 text-ink/50">El sugerido se redondea hacia arriba a este múltiplo.</span>
            </div>
        </div>

        <div class="mt-7 flex items-start gap-3 border border-honey/45 bg-honey/10 px-4 py-4 text-sm font-semibold leading-6 text-ink" role="note">
            <svg class="mt-0.5 size-5 shrink-0 text-honey" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7h.01"/></svg>
            <div>Con un margen del 15 % y la tarifa de Wompi (2,65 % + $700 + IVA), el neto real cae a ~10 % antes de bodega, empaque y logística. Por eso el 15 % es el umbral de alerta y el sugerido apunta al 30 %.</div>
        </div>

        <div class="mt-8 flex flex-col-reverse gap-3 border-t border-oat pt-6 sm:flex-row sm:justify-end">
            <a asp-action="Index" class="inline-flex min-h-12 cursor-pointer items-center justify-center border border-ink/20 px-6 py-3 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">Cancelar</a>
            <button type="submit" class="inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 bg-clay px-6 py-3 text-sm font-extrabold text-white transition-colors hover:bg-clay-light focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-white">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 4h12l2 2v14H5V4Z"/><path d="M8 4v6h8V4M8 20v-6h8v6"/></svg>
                Guardar configuración
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
