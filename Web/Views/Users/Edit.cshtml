@model Web.Models.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0"><i class="fas fa-user-edit me-2"></i>Editar Usuario</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Email" /> @* Email usually read-only or handled carefully *@
                
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <h5 class="text-muted mb-3">Información Personal</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="FirstName" class="form-control" placeholder="First Name" />
                            <label asp-for="FirstName"></label>
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="LastName" class="form-control" placeholder="Last Name" />
                            <label asp-for="LastName"></label>
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <select asp-for="DocumentTypeID" asp-items="Model.DocumentTypes" class="form-select">
                                <option value="">-- Seleccione --</option>
                            </select>
                            <label asp-for="DocumentTypeID"></label>
                            <span asp-validation-for="DocumentTypeID" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="DocumentNumber" class="form-control" placeholder="Document Number" />
                            <label asp-for="DocumentNumber"></label>
                            <span asp-validation-for="DocumentNumber" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <select asp-for="CountryID" asp-items="Model.Countries" class="form-select">
                                <option value="">-- Seleccione --</option>
                            </select>
                            <label asp-for="CountryID"></label>
                            <span asp-validation-for="CountryID" class="text-danger"></span>
                        </div>
                    </div>
                     <div class="col-md-6">
                        <div class="form-floating mb-3">
                             <select asp-for="Gender" class="form-select">
                                <option value="">-- Seleccione --</option>
                                <option value="Male">Masculino</option>
                                <option value="Female">Femenino</option>
                            </select>
                            <label asp-for="Gender"></label>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <h5 class="text-muted mt-4 mb-3">Cuenta y Permisos</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" placeholder="Email" disabled />
                            <label asp-for="Email"></label>
                            <span class="text-muted small">El email no se puede editar.</span>
                        </div>
                    </div>
                     <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <select asp-for="RoleID" asp-items="Model.Roles" class="form-select">
                                <option value="">-- Seleccione --</option>
                            </select>
                            <label asp-for="RoleID"></label>
                            <span asp-validation-for="RoleID" class="text-danger"></span>
                        </div>
                    </div>
                     <div class="col-md-6">
                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" asp-for="Status">
                            <label class="form-check-label" asp-for="Status">Usuario Activo</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                    <button type="submit" class="btn btn-warning">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
