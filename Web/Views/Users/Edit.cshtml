@model Web.Models.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="bean-panel-head">
    <div>
        <h1 class="bean-panel-title">Editar usuario</h1>
        <p class="bean-panel-sub">Actualiza los datos, el rol y el estado de acceso de la cuenta.</p>
    </div>
</div>

<div class="bean-form-card">
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Email" /> @* Email usually read-only or handled carefully *@

        <div asp-validation-summary="ModelOnly" class="bean-form-summary"></div>

        <h2 class="bean-form-section-title">Información personal</h2>
        <div class="bean-form-grid">
            <div class="bean-field">
                <label asp-for="FirstName" class="bean-label"></label>
                <input asp-for="FirstName" class="bean-input" placeholder="First Name" />
                <span asp-validation-for="FirstName" class="bean-form-error"></span>
            </div>
            <div class="bean-field">
                <label asp-for="LastName" class="bean-label"></label>
                <input asp-for="LastName" class="bean-input" placeholder="Last Name" />
                <span asp-validation-for="LastName" class="bean-form-error"></span>
            </div>

            <div class="bean-field">
                <label asp-for="DocumentTypeID" class="bean-label"></label>
                <select asp-for="DocumentTypeID" asp-items="Model.DocumentTypes" class="bean-select">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="DocumentTypeID" class="bean-form-error"></span>
            </div>
            <div class="bean-field">
                <label asp-for="DocumentNumber" class="bean-label"></label>
                <input asp-for="DocumentNumber" class="bean-input" placeholder="Document Number" />
                <span asp-validation-for="DocumentNumber" class="bean-form-error"></span>
            </div>

            <div class="bean-field">
                <label asp-for="CountryID" class="bean-label"></label>
                <select asp-for="CountryID" asp-items="Model.Countries" class="bean-select">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="CountryID" class="bean-form-error"></span>
            </div>
            <div class="bean-field">
                <label asp-for="Gender" class="bean-label"></label>
                <select asp-for="Gender" class="bean-select">
                    <option value="">-- Seleccione --</option>
                    <option value="Male">Masculino</option>
                    <option value="Female">Femenino</option>
                </select>
                <span asp-validation-for="Gender" class="bean-form-error"></span>
            </div>
        </div>

        <h2 class="bean-form-section-title">Cuenta y permisos</h2>
        <div class="bean-form-grid">
            <div class="bean-field">
                <label asp-for="Email" class="bean-label"></label>
                <input asp-for="Email" class="bean-input" placeholder="Email" disabled />
                <span class="bean-label" style="font-weight:500;">El email no se puede editar.</span>
            </div>
            <div class="bean-field">
                <label asp-for="RoleID" class="bean-label"></label>
                <select asp-for="RoleID" asp-items="Model.Roles" class="bean-select">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="RoleID" class="bean-form-error"></span>
            </div>
            <div class="bean-field">
                <div class="bean-switch-row">
                    <input class="form-check-input" type="checkbox" asp-for="Status">
                    <label class="form-check-label" asp-for="Status">Usuario Activo</label>
                </div>
            </div>
        </div>

        <div class="bean-form-actions">
            <a asp-action="Index" class="bean-btn-pill outline">Cancelar</a>
            <button type="submit" class="bean-btn-pill primary">Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
