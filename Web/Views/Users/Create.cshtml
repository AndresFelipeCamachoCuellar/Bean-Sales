@model Web.Models.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Crear Usuario";
    Layout = "_LayoutAdminTailwind";
}

<div class="mx-auto max-w-5xl space-y-6">
    <div class="border-b border-oat pb-6">
        <h1 class="text-2xl font-extrabold tracking-[-0.03em] text-ink sm:text-3xl">Crear nuevo usuario</h1>
        <p class="mt-2 text-sm leading-6 text-ink/65 sm:text-base">Registra una cuenta del equipo con su rol y credenciales.</p>
    </div>

    <div class="border border-oat bg-white">
        <form asp-action="Create" method="post" class="divide-y divide-oat">
            <div asp-validation-summary="ModelOnly" class="m-6 border border-clay/30 bg-clay/10 px-4 py-3 text-sm font-bold text-clay-dark empty:hidden [&_ul]:list-disc [&_ul]:pl-5"></div>

            <section class="p-5 sm:p-6 lg:p-8">
                <h2 class="text-lg font-extrabold text-ink">Información personal</h2>
                <div class="mt-5 grid gap-5 md:grid-cols-2">
                    <div>
                        <label asp-for="FirstName" class="mb-2 block text-sm font-bold text-ink"></label>
                        <input asp-for="FirstName" class="min-h-12 w-full border border-ink/20 bg-cream px-4 text-sm text-ink outline-none transition-colors placeholder:text-ink/40 hover:border-ink/40 focus:border-clay focus:ring-2 focus:ring-clay/20" placeholder="Nombre" />
                        <span asp-validation-for="FirstName" class="mt-1.5 block text-xs font-bold text-red-700"></span>
                    </div>
                    <div>
                        <label asp-for="LastName" class="mb-2 block text-sm font-bold text-ink"></label>
                        <input asp-for="LastName" class="min-h-12 w-full border border-ink/20 bg-cream px-4 text-sm text-ink outline-none transition-colors placeholder:text-ink/40 hover:border-ink/40 focus:border-clay focus:ring-2 focus:ring-clay/20" placeholder="Apellido" />
                        <span asp-validation-for="LastName" class="mt-1.5 block text-xs font-bold text-red-700"></span>
                    </div>

                    <div>
                        <label asp-for="DocumentTypeID" class="mb-2 block text-sm font-bold text-ink"></label>
                        <select asp-for="DocumentTypeID" asp-items="Model.DocumentTypes" class="min-h-12 w-full cursor-pointer border border-ink/20 bg-cream px-4 text-sm text-ink outline-none transition-colors hover:border-ink/40 focus:border-clay focus:ring-2 focus:ring-clay/20">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span asp-validation-for="DocumentTypeID" class="mt-1.5 block text-xs font-bold text-red-700"></span>
                    </div>
                    <div>
                        <label asp-for="DocumentNumber" class="mb-2 block text-sm font-bold text-ink"></label>
                        <input asp-for="DocumentNumber" class="min-h-12 w-full border border-ink/20 bg-cream px-4 text-sm text-ink outline-none transition-colors placeholder:text-ink/40 hover:border-ink/40 focus:border-clay focus:ring-2 focus:ring-clay/20" placeholder="Número de documento" />
                        <span asp-validation-for="DocumentNumber" class="mt-1.5 block text-xs font-bold text-red-700"></span>
                    </div>

                    <div>
                        <label asp-for="CountryID" class="mb-2 block text-sm font-bold text-ink"></label>
                        <select asp-for="CountryID" asp-items="Model.Countries" class="min-h-12 w-full cursor-pointer border border-ink/20 bg-cream px-4 text-sm text-ink outline-none transition-colors hover:border-ink/40 focus:border-clay focus:ring-2 focus:ring-clay/20">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span asp-validation-for="CountryID" class="mt-1.5 block text-xs font-bold text-red-700"></span>
                    </div>
                    <div>
                        <label asp-for="Gender" class="mb-2 block text-sm font-bold text-ink"></label>
                        <select asp-for="Gender" class="min-h-12 w-full cursor-pointer border border-ink/20 bg-cream px-4 text-sm text-ink outline-none transition-colors hover:border-ink/40 focus:border-clay focus:ring-2 focus:ring-clay/20">
                            <option value="">-- Seleccione --</option>
                            <option value="Male">Masculino</option>
                            <option value="Female">Femenino</option>
                        </select>
                        <span asp-validation-for="Gender" class="mt-1.5 block text-xs font-bold text-red-700"></span>
                    </div>
                    <div>
                        <label asp-for="DateOfBirth" class="mb-2 block text-sm font-bold text-ink"></label>
                        <input asp-for="DateOfBirth" class="min-h-12 w-full cursor-pointer border border-ink/20 bg-cream px-4 text-sm text-ink outline-none transition-colors hover:border-ink/40 focus:border-clay focus:ring-2 focus:ring-clay/20" type="date" />
                        <span asp-validation-for="DateOfBirth" class="mt-1.5 block text-xs font-bold text-red-700"></span>
                    </div>
                </div>
            </section>

            <section class="p-5 sm:p-6 lg:p-8">
                <h2 class="text-lg font-extrabold text-ink">Cuenta y seguridad</h2>
                <div class="mt-5 grid gap-5 md:grid-cols-2">
                    <div>
                        <label asp-for="Email" class="mb-2 block text-sm font-bold text-ink"></label>
                        <input asp-for="Email" class="min-h-12 w-full border border-ink/20 bg-cream px-4 text-sm text-ink outline-none transition-colors placeholder:text-ink/40 hover:border-ink/40 focus:border-clay focus:ring-2 focus:ring-clay/20" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Email" class="mt-1.5 block text-xs font-bold text-red-700"></span>
                    </div>
                    <div>
                        <label asp-for="RoleID" class="mb-2 block text-sm font-bold text-ink"></label>
                        <select asp-for="RoleID" asp-items="Model.Roles" class="min-h-12 w-full cursor-pointer border border-ink/20 bg-cream px-4 text-sm text-ink outline-none transition-colors hover:border-ink/40 focus:border-clay focus:ring-2 focus:ring-clay/20">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span asp-validation-for="RoleID" class="mt-1.5 block text-xs font-bold text-red-700"></span>
                    </div>

                    <div>
                        <label asp-for="Password" class="mb-2 block text-sm font-bold text-ink"></label>
                        <input asp-for="Password" class="min-h-12 w-full border border-ink/20 bg-cream px-4 text-sm text-ink outline-none transition-colors placeholder:text-ink/40 hover:border-ink/40 focus:border-clay focus:ring-2 focus:ring-clay/20" placeholder="Contraseña" />
                        <span asp-validation-for="Password" class="mt-1.5 block text-xs font-bold text-red-700"></span>
                    </div>
                    <div>
                        <label asp-for="ConfirmPassword" class="mb-2 block text-sm font-bold text-ink"></label>
                        <input asp-for="ConfirmPassword" class="min-h-12 w-full border border-ink/20 bg-cream px-4 text-sm text-ink outline-none transition-colors placeholder:text-ink/40 hover:border-ink/40 focus:border-clay focus:ring-2 focus:ring-clay/20" placeholder="Confirmar contraseña" />
                        <span asp-validation-for="ConfirmPassword" class="mt-1.5 block text-xs font-bold text-red-700"></span>
                    </div>
                </div>
            </section>

            <div class="flex flex-col-reverse gap-3 bg-cream/60 p-5 sm:flex-row sm:justify-end sm:p-6">
                <a asp-action="Index" class="inline-flex min-h-11 cursor-pointer items-center justify-center border border-ink/20 bg-white px-5 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">Cancelar</a>
                <button type="submit" class="inline-flex min-h-11 cursor-pointer items-center justify-center bg-clay px-5 text-sm font-extrabold text-white transition-colors hover:bg-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream">Crear usuario</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
