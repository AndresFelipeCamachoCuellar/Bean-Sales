@model Web.Models.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Editar Producto";
    Layout = "_Layout";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Editar Producto</h1>

    @if (Model.Status == Web.Models.Enums.ProductStatus.Rejected)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Este producto fue rechazado.</strong><br/>
            Motivo: @Model.RejectionReason <br/>
            Al guardar cambios, volverá a estado "Borrador" y podrás enviarlo de nuevo.
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Información del Producto</h6>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="ProductId" />
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                     <div class="col-md-3 mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                     <div class="col-md-3 mb-3">
                        <label asp-for="Stock" class="form-label"></label>
                        <input asp-for="Stock" class="form-control" type="number" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <hr />
                <h6 class="font-weight-bold text-primary mb-3">Trazabilidad y perfil de taza <small class="text-muted font-weight-normal">(opcional)</small></h6>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Origin" class="form-label"></label>
                        <input asp-for="Origin" class="form-control" placeholder="Ej: Huila" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Farm" class="form-label"></label>
                        <input asp-for="Farm" class="form-control" placeholder="Ej: Finca La Victoria" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Altitude" class="form-label"></label>
                        <input asp-for="Altitude" class="form-control" placeholder="Ej: 1.750 msnm" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Process" class="form-label"></label>
                        <select asp-for="Process" class="form-select" asp-items="Html.GetEnumSelectList<Web.Models.Enums.CoffeeProcess>()">
                            <option value="">— Sin especificar —</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Variety" class="form-label"></label>
                        <input asp-for="Variety" class="form-control" placeholder="Ej: Geisha" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Lot" class="form-label"></label>
                        <input asp-for="Lot" class="form-control" placeholder="Ej: SNG-2026-04" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="RoastDate" class="form-label"></label>
                        <input asp-for="RoastDate" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Rating" class="form-label"></label>
                        <input asp-for="Rating" class="form-control" type="number" step="0.1" min="0" max="5" />
                        <span asp-validation-for="Rating" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="ReviewCount" class="form-label"></label>
                        <input asp-for="ReviewCount" class="form-control" type="number" min="0" />
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="TastingNotes" class="form-label"></label>
                    <input asp-for="TastingNotes" class="form-control" placeholder="Ej: Jazmín, Durazno, Bergamota" />
                    <small class="text-muted">Separadas por coma.</small>
                </div>
                <hr />

                <div class="mb-3">
                   <label asp-for="SelectedCountryIds" class="form-label font-weight-bold"></label>
                   <p class="small text-muted mb-2">Selecciona los países donde deseas vender este producto.</p>
                   @if (Model.AvailableCountries != null)
                   {
                        <div class="row">
                        @foreach (var country in Model.AvailableCountries)
                        {
                            // Checking if selected
                            bool isSelected = Model.SelectedCountryIds.Contains(Guid.Parse(country.Value));
                            
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedCountryIds" value="@country.Value" id="country_@country.Value" @(isSelected ? "checked" : "") />
                                    <label class="form-check-label" for="country_@country.Value">
                                        @country.Text
                                    </label>
                                </div>
                            </div>
                        }
                        </div>
                   }
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Actualizar Borrador</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
