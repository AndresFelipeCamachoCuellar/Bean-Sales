@model Web.Models.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Editar Producto";
    Layout = "_LayoutAdminTailwind";
    var isSuperAdmin = User.IsInRole(Web.Constants.Roles.SuperAdmin);
    const string labelClass = "font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65";
    const string inputClass = "mt-2 min-h-12 w-full border border-ink/25 bg-cream px-4 py-2 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/40 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay";
    const string selectClass = "mt-2 min-h-12 w-full cursor-pointer border border-ink/25 bg-cream px-3 py-2 text-sm font-semibold text-ink outline-none transition-colors hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5";
    const string errorClass = "block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden";
    const string hintClass = "mt-2 block text-xs font-medium leading-5 text-ink/50";
}

<header class="flex flex-col gap-6 border-b border-ink/15 pb-7 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
        <h1 class="font-display text-3xl leading-none tracking-[-0.04em] text-ink sm:text-4xl">Editar lote</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-ink/65 sm:text-base">Actualiza los datos comerciales, la trazabilidad y los países objetivo antes de enviarlo a revisión.</p>
    </div>
    <a asp-action="Index" class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 self-start border border-ink/20 bg-white px-5 py-3 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream lg:self-auto">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6" /></svg>
        Volver
    </a>
</header>

@if (TempData["Flash"] is string flash && !string.IsNullOrWhiteSpace(flash))
{
    <div class="mt-6 flex items-start gap-3 border border-leaf/30 bg-leaf/10 px-4 py-3 text-sm font-semibold leading-6 text-leaf" role="status">
        <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg>
        <div>@flash</div>
    </div>
}

@if (Model.Status == Web.Models.Enums.ProductStatus.Rejected)
{
    <div class="mt-6 flex items-start gap-3 border border-clay/35 bg-clay/10 px-4 py-3 text-sm font-semibold leading-6 text-clay-dark" role="alert">
        <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 2.8 20h18.4L12 3Z" /><path d="M12 9v5M12 17h.01" /></svg>
        <div><strong>Este producto fue rechazado.</strong><br />Motivo: @Model.RejectionReason<br />Al guardar cambios volverá a Borrador y podrás enviarlo de nuevo.</div>
    </div>
}

<form asp-action="Edit" method="post" class="mt-8 space-y-8">
    <div asp-validation-summary="ModelOnly" class="hidden border border-clay bg-clay/10 p-4 text-sm font-semibold leading-6 text-clay-dark [&.validation-summary-errors]:block [&_ul]:space-y-1" role="alert" aria-live="polite"></div>
    <input type="hidden" asp-for="ProductId" />

    <section class="border border-ink/15 bg-white" aria-labelledby="producto-title">
        <div class="border-b border-oat px-4 py-5 sm:px-6"><h2 id="producto-title" class="text-xl font-extrabold tracking-[-0.03em] text-ink">Información del producto</h2><p class="mt-2 text-sm leading-6 text-ink/60">Nombre, costo para Bean, inventario inicial y descripción comercial.</p></div>
        <div class="grid gap-x-6 gap-y-5 p-4 sm:p-6 md:grid-cols-2">
            <div class="md:col-span-2"><label asp-for="Name" class="@labelClass"></label><input asp-for="Name" class="@inputClass" /><span asp-validation-for="Name" class="@errorClass" aria-live="polite"></span></div>
            @await Html.PartialAsync("_PricingFields", Model)
            <div><label asp-for="Stock" class="@labelClass"></label><input asp-for="Stock" class="@inputClass" type="number" /><span asp-validation-for="Stock" class="@errorClass" aria-live="polite"></span></div>
            <div class="md:col-span-2"><label asp-for="Description" class="@labelClass"></label><textarea asp-for="Description" class="@inputClass" rows="4" placeholder="Perfil del lote, recomendación de preparación, historia de la finca…"></textarea><span asp-validation-for="Description" class="@errorClass" aria-live="polite"></span></div>
        </div>
    </section>

    <section class="border border-ink/15 bg-white" aria-labelledby="trazabilidad-title">
        <div class="border-b border-oat px-4 py-5 sm:px-6"><h2 id="trazabilidad-title" class="text-xl font-extrabold tracking-[-0.03em] text-ink">Trazabilidad y perfil de taza</h2><p class="mt-2 text-sm leading-6 text-ink/60">Datos opcionales que ayudan a presentar y aprobar el lote.</p></div>
        <div class="grid gap-x-6 gap-y-5 p-4 sm:p-6 md:grid-cols-2 xl:grid-cols-3">
            <div><label asp-for="Origin" class="@labelClass"></label><input asp-for="Origin" class="@inputClass" placeholder="Ej: Huila" /></div>
            <div><label asp-for="Farm" class="@labelClass"></label><input asp-for="Farm" class="@inputClass" placeholder="Ej: Finca La Victoria" /></div>
            <div><label asp-for="Altitude" class="@labelClass"></label><input asp-for="Altitude" class="@inputClass" placeholder="Ej: 1.750 msnm" /></div>
            <div><label asp-for="Process" class="@labelClass"></label><select asp-for="Process" class="@selectClass" asp-items="Html.GetEnumSelectList<Web.Models.Enums.CoffeeProcess>()"><option value="">— Sin especificar —</option></select></div>
            <div><label asp-for="Variety" class="@labelClass"></label><input asp-for="Variety" class="@inputClass" placeholder="Ej: Geisha" /></div>
            <div><label asp-for="Lot" class="@labelClass"></label><input asp-for="Lot" class="@inputClass" placeholder="Ej: SNG-2026-04" /></div>
            <div><label asp-for="RoastDate" class="@labelClass"></label><input asp-for="RoastDate" class="@inputClass" type="date" asp-format="{0:yyyy-MM-dd}" /></div>
            @if (isSuperAdmin)
            {
                <div><label asp-for="Rating" class="@labelClass"></label><input asp-for="Rating" class="@inputClass" type="number" step="0.1" min="0" max="5" /><span asp-validation-for="Rating" class="@errorClass" aria-live="polite"></span><span class="@hintClass">Solo carga inicial; a futuro se calculará con reseñas reales.</span></div>
                <div><label asp-for="ReviewCount" class="@labelClass"></label><input asp-for="ReviewCount" class="@inputClass" type="number" min="0" /><span class="@hintClass">Solo carga inicial; a futuro se calculará con reseñas reales.</span></div>
            }
            else
            {
                <input type="hidden" asp-for="Rating" />
                <input type="hidden" asp-for="ReviewCount" />
            }
            <div class="md:col-span-2 xl:col-span-3"><label asp-for="TastingNotes" class="@labelClass"></label><input asp-for="TastingNotes" class="@inputClass" placeholder="Ej: Jazmín, Durazno, Bergamota" /><span class="@hintClass">Separa cada nota con una coma.</span></div>
        </div>
    </section>

    <section class="border border-ink/15 bg-white" aria-labelledby="empaque-title">
        <div class="border-b border-oat px-4 py-5 sm:px-6"><h2 id="empaque-title" class="text-xl font-extrabold tracking-[-0.03em] text-ink">Empaque y envío</h2><p class="mt-2 text-sm leading-6 text-ink/60">Opcional. Sin estos datos se estiman las medidas estándar de una bolsa de 500 g.</p></div>
        <div class="grid gap-x-6 gap-y-5 p-4 sm:p-6 md:grid-cols-2 xl:grid-cols-4">
            <div><label asp-for="ShippingWeightGrams" class="@labelClass"></label><input asp-for="ShippingWeightGrams" class="@inputClass" type="number" min="1" step="1" placeholder="Ej: 500" /><span asp-validation-for="ShippingWeightGrams" class="@errorClass" aria-live="polite"></span><span class="@hintClass">Peso de la bolsa empacada.</span></div>
            <div><label asp-for="LengthCm" class="@labelClass"></label><input asp-for="LengthCm" class="@inputClass" type="number" min="1" step="0.1" placeholder="Ej: 20" /><span asp-validation-for="LengthCm" class="@errorClass" aria-live="polite"></span></div>
            <div><label asp-for="WidthCm" class="@labelClass"></label><input asp-for="WidthCm" class="@inputClass" type="number" min="1" step="0.1" placeholder="Ej: 12" /><span asp-validation-for="WidthCm" class="@errorClass" aria-live="polite"></span></div>
            <div><label asp-for="HeightCm" class="@labelClass"></label><input asp-for="HeightCm" class="@inputClass" type="number" min="1" step="0.1" placeholder="Ej: 8" /><span asp-validation-for="HeightCm" class="@errorClass" aria-live="polite"></span></div>
        </div>
    </section>

    <section class="border border-ink/15 bg-white" aria-labelledby="paises-title">
        <div class="border-b border-oat px-4 py-5 sm:px-6"><h2 id="paises-title" class="text-xl font-extrabold tracking-[-0.03em] text-ink">Países objetivo</h2><p class="mt-2 text-sm leading-6 text-ink/60">Selecciona dónde deseas vender este producto.</p></div>
        @if (Model.AvailableCountries != null)
        {
            <div class="grid gap-3 p-4 sm:grid-cols-2 sm:p-6 lg:grid-cols-3">
                @foreach (var country in Model.AvailableCountries)
                {
                    bool isSelected = Model.SelectedCountryIds.Contains(Guid.Parse(country.Value));
                    <label for="country_@country.Value" class="flex min-h-12 cursor-pointer items-center gap-3 border border-ink/15 bg-cream px-4 py-3 text-sm font-extrabold text-ink transition-colors hover:border-clay">
                        <input class="size-4 cursor-pointer rounded-none accent-clay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream" type="checkbox" name="SelectedCountryIds" value="@country.Value" id="country_@country.Value" @(isSelected ? "checked" : "") />
                        <span>@country.Text</span>
                    </label>
                }
            </div>
        }
    </section>

    <div class="flex flex-col-reverse gap-3 border-t border-ink/15 pt-6 sm:flex-row sm:justify-end">
        <a asp-action="Index" class="inline-flex min-h-12 cursor-pointer items-center justify-center border border-ink/20 bg-white px-6 py-3 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">Cancelar</a>
        <button type="submit" class="inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 bg-clay px-6 py-3 text-sm font-extrabold text-white transition-colors hover:bg-clay-light focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-4 focus-visible:ring-offset-cream"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h12l2 2v14H5V4Z" /><path d="M8 4v6h8V4M8 20v-6h8v6" /></svg>Actualizar borrador</button>
    </div>
</form>

@* Debe permanecer fuera del formulario del producto: opera con POST independientes por AJAX. *@
@if (Model.ImageManager != null)
{
    <section class="mt-8 border border-ink/15 bg-white p-4 sm:p-6" aria-label="Gestor de fotos del lote">
        <partial name="_ProductImageManager" model="Model.ImageManager" />
    </section>
}

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/bean-media.js" asp-append-version="true"></script>
}
