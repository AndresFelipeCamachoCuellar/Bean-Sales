@model Web.Models.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Editar Producto";
    Layout = "_Layout";
    var isSuperAdmin = User.IsInRole(Web.Constants.Roles.SuperAdmin);
}

<div class="bean-panel-head">
    <div>
        <h1 class="bean-panel-title">Editar lote</h1>
        <p class="bean-panel-sub">Actualiza los datos comerciales, la trazabilidad y los países objetivo de este lote.</p>
    </div>
    <a asp-action="Index" class="bean-btn-pill outline"><i class="fas fa-arrow-left"></i> Volver</a>
</div>

@if (Model.Status == Web.Models.Enums.ProductStatus.Rejected)
{
    <div class="bean-panel-note danger">
        <i class="fas fa-exclamation-triangle"></i>
        <div>
            <strong>Este producto fue rechazado.</strong><br />
            Motivo: @Model.RejectionReason<br />
            Al guardar cambios, volverá a estado "Borrador" y podrás enviarlo de nuevo.
        </div>
    </div>
}

<div class="bean-form-card">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="bean-form-summary"></div>
        <input type="hidden" asp-for="ProductId" />

        <h2 class="bean-form-section-title">Información del producto</h2>
        <div class="bean-form-grid">
            <div class="bean-field col-span-2">
                <label asp-for="Name" class="bean-label"></label>
                <input asp-for="Name" class="bean-input" />
                <span asp-validation-for="Name" class="bean-form-error"></span>
            </div>

            <div class="bean-field">
                <label asp-for="Price" class="bean-label">Precio (COP)</label>
                <div class="bean-input-affix">
                    <span class="affix">$</span>
                    <input asp-for="Price" class="bean-input" type="number" step="0.01" />
                </div>
                <span asp-validation-for="Price" class="bean-form-error"></span>
                <span class="bean-field-hint">Valor unitario en pesos colombianos (COP).</span>
            </div>

            <div class="bean-field">
                <label asp-for="Stock" class="bean-label"></label>
                <input asp-for="Stock" class="bean-input" type="number" />
                <span asp-validation-for="Stock" class="bean-form-error"></span>
            </div>

            <div class="bean-field col-span-2">
                <label asp-for="Description" class="bean-label"></label>
                <textarea asp-for="Description" class="bean-input" rows="3" placeholder="Perfil del lote, recomendación de preparación, historia de la finca…"></textarea>
                <span asp-validation-for="Description" class="bean-form-error"></span>
            </div>
        </div>

        <h2 class="bean-form-section-title">Trazabilidad y perfil de taza (opcional)</h2>
        <div class="bean-form-grid cols-3">
            <div class="bean-field">
                <label asp-for="Origin" class="bean-label"></label>
                <input asp-for="Origin" class="bean-input" placeholder="Ej: Huila" />
            </div>
            <div class="bean-field">
                <label asp-for="Farm" class="bean-label"></label>
                <input asp-for="Farm" class="bean-input" placeholder="Ej: Finca La Victoria" />
            </div>
            <div class="bean-field">
                <label asp-for="Altitude" class="bean-label"></label>
                <input asp-for="Altitude" class="bean-input" placeholder="Ej: 1.750 msnm" />
            </div>

            <div class="bean-field">
                <label asp-for="Process" class="bean-label"></label>
                <select asp-for="Process" class="bean-select" asp-items="Html.GetEnumSelectList<Web.Models.Enums.CoffeeProcess>()">
                    <option value="">— Sin especificar —</option>
                </select>
            </div>
            <div class="bean-field">
                <label asp-for="Variety" class="bean-label"></label>
                <input asp-for="Variety" class="bean-input" placeholder="Ej: Geisha" />
            </div>
            <div class="bean-field">
                <label asp-for="Lot" class="bean-label"></label>
                <input asp-for="Lot" class="bean-input" placeholder="Ej: SNG-2026-04" />
            </div>

            <div class="bean-field">
                <label asp-for="RoastDate" class="bean-label"></label>
                <input asp-for="RoastDate" class="bean-input" type="date" asp-format="{0:yyyy-MM-dd}" />
            </div>

            @if (isSuperAdmin)
            {
                <div class="bean-field">
                    <label asp-for="Rating" class="bean-label"></label>
                    <input asp-for="Rating" class="bean-input" type="number" step="0.1" min="0" max="5" />
                    <span asp-validation-for="Rating" class="bean-form-error"></span>
                    <span class="bean-field-hint">Solo carga inicial; a futuro se calculará con reseñas reales.</span>
                </div>
                <div class="bean-field">
                    <label asp-for="ReviewCount" class="bean-label"></label>
                    <input asp-for="ReviewCount" class="bean-input" type="number" min="0" />
                    <span class="bean-field-hint">Solo carga inicial; a futuro se calculará con reseñas reales.</span>
                </div>
            }
            else
            {
                @* Se preservan los valores actuales para que el proveedor no los borre al guardar. *@
                <input type="hidden" asp-for="Rating" />
                <input type="hidden" asp-for="ReviewCount" />
            }

            <div class="bean-field col-span-2">
                <label asp-for="TastingNotes" class="bean-label"></label>
                <input asp-for="TastingNotes" class="bean-input" placeholder="Ej: Jazmín, Durazno, Bergamota" />
                <span class="bean-field-hint">Separadas por coma.</span>
            </div>
        </div>

        <h2 class="bean-form-section-title">Países objetivo</h2>
        <div class="bean-field">
            <label asp-for="SelectedCountryIds" class="bean-label"></label>
            <p class="bean-panel-sub" style="margin:0;">Selecciona los países donde deseas vender este producto.</p>
        </div>
        @if (Model.AvailableCountries != null)
        {
            <div class="bean-panel-checkgrid">
                @foreach (var country in Model.AvailableCountries)
                {
                    bool isSelected = Model.SelectedCountryIds.Contains(Guid.Parse(country.Value));

                    <div class="bean-panel-check">
                        <input class="form-check-input" type="checkbox" name="SelectedCountryIds" value="@country.Value" id="country_@country.Value" @(isSelected ? "checked" : "") />
                        <label for="country_@country.Value">@country.Text</label>
                    </div>
                }
            </div>
        }

        <div class="bean-form-actions">
            <a asp-action="Index" class="bean-btn-pill outline">Cancelar</a>
            <button type="submit" class="bean-btn-pill primary"><i class="fas fa-save"></i> Actualizar Borrador</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
