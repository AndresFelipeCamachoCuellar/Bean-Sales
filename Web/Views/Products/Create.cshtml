@model Web.Models.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Nuevo Producto";
    Layout = "_Layout";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Crear Nuevo Producto</h1>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Información del Producto</h6>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="Ej: Café Especial Recolección 2024" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                     <div class="col-md-3 mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                     <div class="col-md-3 mb-3">
                        <label asp-for="Stock" class="form-label"></label>
                        <input asp-for="Stock" class="form-control" type="number" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                   <label asp-for="SelectedCountryIds" class="form-label font-weight-bold"></label>
                   <p class="small text-muted mb-2">Selecciona los países donde deseas vender este producto.</p>
                   @if (Model.AvailableCountries != null)
                   {
                        <div class="row">
                        @foreach (var country in Model.AvailableCountries)
                        {
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedCountryIds" value="@country.Value" id="country_@country.Value" />
                                    <label class="form-check-label" for="country_@country.Value">
                                        @country.Text
                                    </label>
                                </div>
                            </div>
                        }
                        </div>
                   }
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Guardar Borrador</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
