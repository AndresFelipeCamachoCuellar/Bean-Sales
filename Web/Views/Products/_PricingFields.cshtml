@model Web.Models.ViewModels.ProductViewModel
@using Web.Services.Pricing

@* El proveedor edita SupplierPrice; Price solo se renderiza con Pricing/Update. El servidor vuelve a validar el permiso. *@
<div>
    <label asp-for="SupplierPrice" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65"></label>
    <div class="relative mt-2">
        <span class="pointer-events-none absolute inset-y-0 left-0 grid w-11 place-items-center border-r border-ink/15 font-data text-xs font-semibold text-ink/55">$</span>
        <input asp-for="SupplierPrice" id="beanSupplierPrice" class="min-h-12 w-full border border-ink/25 bg-cream py-2 pl-14 pr-4 text-base tabular-nums text-ink caret-clay outline-none transition-colors hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" type="number" step="0.01" min="0" />
    </div>
    <span asp-validation-for="SupplierPrice" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
    <span class="mt-2 block text-xs font-medium leading-5 text-ink/50">Lo que Bean te paga por unidad, en pesos colombianos (COP). El precio al que se vende en la tienda lo fija Bean.</span>
</div>

@if (Model.CanEditSalePrice)
{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var margin = PricingCalculator.CalculateMargin(Model.Price, Model.SupplierPrice);
    var suggested = PricingCalculator.SuggestPrice(Model.SupplierPrice, Model.TargetMarginPercent, Model.RoundingStep);
    var below = PricingCalculator.IsBelowMinimum(Model.Price, Model.SupplierPrice, Model.MinimumMarginPercent);
    var jsTarget = Model.TargetMarginPercent.ToString(inv);
    var jsMinimum = Model.MinimumMarginPercent.ToString(inv);
    var jsStep = Model.RoundingStep.ToString(inv);
    var marginAmountText = margin.IsCalculable ? margin.Amount.ToString("N0") : "—";
    var marginPercentText = margin.IsCalculable ? margin.Percent.ToString("N2") + " %" : "—";

    <div>
        <label asp-for="Price" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65"></label>
        <div class="relative mt-2">
            <span class="pointer-events-none absolute inset-y-0 left-0 grid w-11 place-items-center border-r border-ink/15 font-data text-xs font-semibold text-ink/55">$</span>
            <input asp-for="Price" id="beanSalePrice" class="min-h-12 w-full border border-ink/25 bg-cream py-2 pl-14 pr-4 text-base tabular-nums text-ink caret-clay outline-none transition-colors hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" type="number" step="0.01" min="0" />
        </div>
        <span asp-validation-for="Price" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
        <span class="mt-2 block text-xs font-medium leading-5 text-ink/50">Precio de venta al público. Un lote no puede activarse sin PVP fijado.</span>
    </div>

    <div class="md:col-span-2">
        <div id="beanMarginPanel" class="grid gap-5 border border-ink/15 bg-ink p-4 text-white sm:grid-cols-[1fr_auto] sm:items-center sm:p-5">
            <div>
                <p class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-clay-light">Margen calculado</p>
                <p class="mt-2 text-lg font-extrabold tabular-nums"><span id="beanMarginAmount">@marginAmountText</span> <span class="text-husk">(<span id="beanMarginPercent">@marginPercentText</span>)</span></p>
                <p class="mt-2 text-xs font-semibold leading-5 text-husk">Objetivo @Model.TargetMarginPercent.ToString("N0") % · Mínimo @Model.MinimumMarginPercent.ToString("N0") %</p>
                <p id="beanBelowWarning" class="mt-3 text-sm font-bold leading-6 text-clay-light" hidden="@(!below)">Este precio queda por debajo del margen mínimo. Escribe el motivo para poder guardarlo.</p>
            </div>
            <div id="beanSuggestedWrap" class="border border-white/15 bg-white/5 p-4 sm:min-w-52">
                <p class="font-data text-[10px] font-semibold uppercase tracking-[0.12em] text-husk">Precio sugerido</p>
                <p class="mt-2 text-xl font-extrabold tabular-nums">$ <span id="beanSuggestedValue">@suggested.ToString("N0")</span></p>
                <button type="button" id="beanUseSuggested" class="mt-3 inline-flex min-h-11 w-full cursor-pointer items-center justify-center border border-white/35 px-4 py-2 text-sm font-extrabold text-white transition-colors hover:border-clay-light hover:bg-clay hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-clay-light">Usar este precio</button>
            </div>
        </div>
    </div>

    <div id="beanReasonField" class="md:col-span-2" hidden="@(!below)">
        <label asp-for="SalePriceReason" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65">Motivo del precio bajo el mínimo</label>
        <input asp-for="SalePriceReason" class="mt-2 min-h-12 w-full border border-ink/25 bg-cream px-4 py-2 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/40 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5" placeholder="Ej: promoción de lanzamiento, liquidación de lote" />
        <span asp-validation-for="SalePriceReason" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
    </div>

    <script>
        (function () {
            var cost = document.getElementById('beanSupplierPrice');
            var price = document.getElementById('beanSalePrice');
            if (!cost || !price) return;

            var target = @jsTarget;
            var minimum = @jsMinimum;
            var step = @jsStep;
            var amountEl = document.getElementById('beanMarginAmount');
            var percentEl = document.getElementById('beanMarginPercent');
            var suggestedEl = document.getElementById('beanSuggestedValue');
            var warnEl = document.getElementById('beanBelowWarning');
            var reasonEl = document.getElementById('beanReasonField');
            var useBtn = document.getElementById('beanUseSuggested');

            function money(n) {
                return n.toLocaleString('es-CO', { maximumFractionDigits: 0 });
            }

            function suggest(c) {
                if (!(c > 0) || target < 0 || target >= 100) return 0;
                var s = step > 0 ? step : 50;
                return Math.ceil((c / (1 - target / 100)) / s) * s;
            }

            function refresh() {
                var c = parseFloat(cost.value) || 0;
                var p = parseFloat(price.value) || 0;
                var amount = p - c;
                var calculable = p > 0;
                var percent = calculable ? (amount / p) * 100 : 0;
                var sug = suggest(c);
                var belowMinimum = !calculable || percent < minimum;

                amountEl.textContent = calculable ? money(amount) : '—';
                percentEl.textContent = calculable ? percent.toFixed(2) + ' %' : '—';
                suggestedEl.textContent = sug > 0 ? money(sug) : '—';
                warnEl.hidden = !belowMinimum;
                if (reasonEl) reasonEl.hidden = !belowMinimum;
            }

            cost.addEventListener('input', refresh);
            price.addEventListener('input', refresh);
            if (useBtn) {
                useBtn.addEventListener('click', function () {
                    var sug = suggest(parseFloat(cost.value) || 0);
                    if (sug > 0) {
                        price.value = sug;
                        refresh();
                        price.focus();
                    }
                });
            }
            refresh();
        })();
    </script>
}
else
{
    <div class="flex min-h-12 items-center border border-ink/15 bg-oat/65 px-4 py-3 text-sm font-semibold leading-6 text-ink/65">
        El precio de venta al público lo fija el equipo de Bean al aprobar el lote.
    </div>
}
