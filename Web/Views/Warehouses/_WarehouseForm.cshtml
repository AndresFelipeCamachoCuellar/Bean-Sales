@model Web.Models.ViewModels.WarehouseViewModel

<div asp-validation-summary="ModelOnly" class="mb-6 hidden border border-clay bg-clay/10 p-4 text-sm font-semibold leading-6 text-clay-dark [&.validation-summary-errors]:block [&_ul]:space-y-1" role="alert" aria-live="polite"></div>

<div class="grid gap-x-6 gap-y-5 md:grid-cols-2">
    <div>
        <label asp-for="Code" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65"></label>
        <input asp-for="Code" class="mt-2 min-h-12 w-full border border-ink/25 bg-cream px-4 py-2 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/45 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" placeholder="CAL-01" maxlength="20" />
        <span class="mt-2 block text-xs font-medium leading-5 text-ink/50">Código corto y único. Es lo que se ve en la matriz de inventario.</span>
        <span asp-validation-for="Code" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
    </div>

    <div>
        <label asp-for="Name" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65"></label>
        <input asp-for="Name" class="mt-2 min-h-12 w-full border border-ink/25 bg-cream px-4 py-2 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/45 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" placeholder="Bodega Principal Cali" maxlength="100" />
        <span asp-validation-for="Name" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
    </div>

    <div>
        <label asp-for="CountryID" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65"></label>
        <select asp-for="CountryID" class="mt-2 min-h-12 w-full cursor-pointer border border-ink/25 bg-cream px-3 py-2 text-sm font-semibold text-ink outline-none transition-colors hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5">
            <option value="">Selecciona un país…</option>
            @foreach (var c in Model.CountryOptions)
            {
                <option value="@c.Id">@c.Label</option>
            }
        </select>
        <span asp-validation-for="CountryID" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
    </div>

    <div>
        <label asp-for="City" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65"></label>
        <input asp-for="City" class="mt-2 min-h-12 w-full border border-ink/25 bg-cream px-4 py-2 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/45 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" placeholder="Cali" maxlength="100" />
        <span asp-validation-for="City" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
    </div>

    <div>
        <label asp-for="DaneCode" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65"></label>
        <input asp-for="DaneCode" class="mt-2 min-h-12 w-full border border-ink/25 bg-cream px-4 py-2 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/45 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" placeholder="76001" maxlength="10" inputmode="numeric" />
        <span class="mt-2 block text-xs font-medium leading-5 text-ink/50">5 dígitos (DIVIPOLA). Cali es <strong class="text-ink">76001</strong>; 760001 es el código postal, no el DANE. Si se deja vacío, el envío se cotiza desde el origen configurado en <code class="bg-oat px-1 py-0.5 font-data text-xs text-ink">appsettings</code>.</span>
        <span asp-validation-for="DaneCode" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
    </div>

    <div>
        <label asp-for="Address" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65"></label>
        <input asp-for="Address" class="mt-2 min-h-12 w-full border border-ink/25 bg-cream px-4 py-2 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/45 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" maxlength="200" />
        <span asp-validation-for="Address" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
    </div>

    <div class="border border-ink/15 bg-cream p-4 md:col-span-2">
        <label class="inline-flex min-h-11 cursor-pointer items-center gap-3 text-sm font-extrabold text-ink">
            <input asp-for="IsDefault" type="checkbox" class="size-4 cursor-pointer rounded-none accent-clay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream" />
            <span>@Html.DisplayNameFor(model => model.IsDefault)</span>
        </label>
        <span class="mt-2 block text-xs font-medium leading-5 text-ink/55">Es la bodega que despacha en su país y fija el origen del envío. Al marcarla, la anterior se desmarca sola.</span>
        <span asp-validation-for="IsDefault" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
    </div>

    <div class="border border-ink/15 bg-cream p-4 md:col-span-2">
        <label class="inline-flex min-h-11 cursor-pointer items-center gap-3 text-sm font-extrabold text-ink">
            <input asp-for="IsActive" type="checkbox" class="size-4 cursor-pointer rounded-none accent-clay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream" />
            <span>@Html.DisplayNameFor(model => model.IsActive)</span>
        </label>
        <span class="mt-2 block text-xs font-medium leading-5 text-ink/55">
            Una bodega inactiva no aparece en la matriz ni se puede usar para recibir lotes.
            @if (!Model.IsNew && Model.UnitsOnHand > 0)
            {
                <strong class="text-clay-dark">Hoy tiene @Model.UnitsOnHand unidades físicas: no se puede desactivar hasta que queden en 0.</strong>
            }
        </span>
        <span asp-validation-for="IsActive" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
    </div>
</div>
