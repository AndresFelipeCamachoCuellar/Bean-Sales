@model Web.Models.ViewModels.InventoryMatrixViewModel
@using Web.Constants
@using Web.Models
@using Web.Models.Enums
@using Web.Models.ViewModels
@using Web.Services
@using Microsoft.AspNetCore.Identity
@inject IPermissionService PermissionService
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Inventario";
    Layout = "_LayoutAdminTailwind";

    var currentUser = await UserManager.GetUserAsync(User);
    var canManageWarehouses = currentUser != null
        && await PermissionService.HasPermissionAsync(currentUser, Modules.Warehouses, Permissions.Read);

    var estadosFiltrables = new[]
    {
        ProductStatus.Shipped,
        ProductStatus.Active,
        ProductStatus.ApprovedToShip,
        ProductStatus.PendingApproval,
        ProductStatus.Draft,
        ProductStatus.Rejected
    };

    string EstadoLabel(ProductStatus s) => s switch
    {
        ProductStatus.Draft => "Borrador",
        ProductStatus.PendingApproval => "Pendiente de aprobación",
        ProductStatus.ApprovedToShip => "Aprobado · por enviar",
        ProductStatus.Shipped => "Enviado · por recibir",
        ProductStatus.Active => "Activo · en venta",
        ProductStatus.Rejected => "Rechazado",
        _ => s.ToString()
    };
}

<header class="flex flex-col gap-6 border-b border-ink/15 pb-7 xl:flex-row xl:items-end xl:justify-between">
    <div class="max-w-3xl">
        <h1 class="font-display text-3xl leading-none tracking-[-0.04em] text-ink sm:text-4xl">Inventario</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-ink/65 sm:text-base">
            Disponibilidad por lote y por bodega. Cada celda muestra lo que se puede vender;
            consulta su detalle para comparar unidades en mano y reservadas.
        </p>
    </div>

    @if (canManageWarehouses)
    {
        <a asp-controller="Warehouses" asp-action="Index"
           class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 self-start border border-ink/20 bg-white px-5 py-3 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream xl:self-auto">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 21V8l9-5 9 5v13H3Z"/><path d="M7 21v-8h10v8M7 9h.01M12 9h.01M17 9h.01"/></svg>
            Bodegas
        </a>
    }
</header>

@if (TempData["InventoryOk"] != null)
{
    <div class="mt-6 flex items-start gap-3 border border-leaf/30 bg-leaf/10 px-4 py-3 text-sm font-semibold leading-6 text-leaf" role="status">
        <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></svg>
        <div>@TempData["InventoryOk"]</div>
    </div>
}
@if (TempData["InventoryError"] != null)
{
    <div class="mt-6 flex items-start gap-3 border border-clay/35 bg-clay/10 px-4 py-3 text-sm font-semibold leading-6 text-clay-dark" role="alert">
        <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 2.8 20h18.4L12 3Z"/><path d="M12 9v5M12 17h.01"/></svg>
        <div>@TempData["InventoryError"]</div>
    </div>
}

@if (Model.NoWarehouses)
{
    <section class="mt-8 grid min-h-80 place-items-center border border-oat bg-white px-6 py-14 text-center" aria-labelledby="sin-bodegas-title">
        <div class="max-w-xl">
            <svg class="mx-auto size-14 text-clay" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 21V8l9-5 9 5v13H3Z"/><path d="M7 21v-8h10v8M7 9h.01M12 9h.01M17 9h.01"/></svg>
            <h2 id="sin-bodegas-title" class="mt-6 text-2xl font-extrabold tracking-[-0.03em] text-ink">Todavía no hay bodegas operativas</h2>
            <p class="mx-auto mt-3 max-w-lg text-sm leading-6 text-ink/65">El inventario se organiza por bodega. Crea al menos una para recibir lotes y consultar su disponibilidad.</p>
            @if (canManageWarehouses)
            {
                <a asp-controller="Warehouses" asp-action="Create"
                   class="mt-7 inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 bg-clay px-6 py-3 text-sm font-extrabold text-white transition-colors hover:bg-clay-light focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-4 focus-visible:ring-offset-white">
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    Crear la primera bodega
                </a>
            }
        </div>
    </section>
}
else
{
    <div>
        <form method="get" asp-action="Index" class="mt-8 border border-ink/15 bg-white p-4 sm:p-6">
            <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
                <div>
                    <label class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65" for="f-bodega">Bodega</label>
                    <select id="f-bodega" name="bodega" class="mt-2 min-h-12 w-full cursor-pointer border border-ink/25 bg-cream px-3 py-2 text-sm font-semibold text-ink outline-none transition-colors hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25">
                        <option value="">Todas las bodegas</option>
                        @foreach (var opt in Model.WarehouseOptions)
                        {
                            <option value="@opt.Id" selected="@(Model.WarehouseID == opt.Id)">@opt.Label</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65" for="f-proveedor">Proveedor</label>
                    <select id="f-proveedor" name="proveedor" class="mt-2 min-h-12 w-full cursor-pointer border border-ink/25 bg-cream px-3 py-2 text-sm font-semibold text-ink outline-none transition-colors hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25">
                        <option value="">Todos los proveedores</option>
                        @foreach (var opt in Model.ProviderOptions)
                        {
                            <option value="@opt.Id" selected="@(Model.ProviderID == opt.Id)">@opt.Label</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65" for="f-estado">Estado del lote</label>
                    <select id="f-estado" name="estado" class="mt-2 min-h-12 w-full cursor-pointer border border-ink/25 bg-cream px-3 py-2 text-sm font-semibold text-ink outline-none transition-colors hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25">
                        <option value="">Todos los estados</option>
                        @foreach (var st in estadosFiltrables)
                        {
                            <option value="@st" selected="@(Model.Estado == st)">@(EstadoLabel(st))</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65" for="f-q">Buscar</label>
                    <input id="f-q" type="text" name="q" value="@Model.Query"
                           class="mt-2 min-h-12 w-full border border-ink/25 bg-cream px-4 py-2 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/45 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25"
                           placeholder="Nombre o número de lote…" />
                </div>
            </div>

            <div class="mt-5 flex flex-col gap-3 border-t border-oat pt-5 sm:flex-row sm:items-center sm:justify-between">
                <label class="inline-flex min-h-11 cursor-pointer items-center gap-3 text-sm font-bold text-ink/75">
                    <input type="checkbox" name="bajo" value="true" checked="@Model.SoloStockBajo" class="size-4 cursor-pointer rounded-none accent-clay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2" />
                    <span>Solo stock bajo</span>
                </label>
                <div class="flex flex-col gap-2 sm:flex-row">
                    <a asp-action="Index" class="inline-flex min-h-11 cursor-pointer items-center justify-center border border-ink/20 px-5 py-2 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">Limpiar</a>
                    <button type="submit" class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 bg-clay px-5 py-2 text-sm font-extrabold text-white transition-colors hover:bg-clay-light focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-white">
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
                        Filtrar
                    </button>
                </div>
            </div>
        </form>

        @if (Model.LowStockCount > 0 && !Model.SoloStockBajo)
        {
            <div class="mt-5 flex items-start gap-3 border border-honey/45 bg-honey/10 px-4 py-3 text-sm font-semibold leading-6 text-ink" role="status">
                <svg class="mt-0.5 size-5 shrink-0 text-honey" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 2.8 20h18.4L12 3Z"/><path d="M12 9v5M12 17h.01"/></svg>
                <div>
                    Hay <strong>@Model.LowStockCount</strong> @(Model.LowStockCount == 1 ? "lote" : "lotes") en el punto de reorden o por debajo.
                    <a asp-action="Index" asp-route-bajo="true" asp-route-bodega="@Model.WarehouseID" asp-route-proveedor="@Model.ProviderID" asp-route-estado="@Model.Estado" class="cursor-pointer font-extrabold text-clay-dark underline decoration-clay/40 underline-offset-4 hover:decoration-clay focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">Verlos</a>.
                </div>
            </div>
        }

        @if (Model.Rows.Count == 0)
        {
            <section class="mt-8 grid min-h-72 place-items-center border border-oat bg-white px-6 py-12 text-center" aria-labelledby="sin-lotes-title">
                <div class="max-w-lg">
                    <svg class="mx-auto size-12 text-clay" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 7 8-4 8 4-8 4-8-4Z"/><path d="m4 12 8 4 8-4M4 17l8 4 8-4"/></svg>
                    <h2 id="sin-lotes-title" class="mt-5 text-xl font-extrabold tracking-[-0.025em]">No hay lotes con estos filtros</h2>
                    <p class="mt-2 text-sm leading-6 text-ink/60">Ajusta el filtro, o registra la recepción de un lote desde la bandeja de aprobaciones.</p>
                </div>
            </section>
        }
        else
        {
            <div class="mt-8 overflow-x-auto border border-ink/15 bg-white shadow-tray">
                <table class="min-w-[920px] w-full border-collapse text-left text-sm tabular-nums">
                    <caption class="sr-only">Disponibilidad de cada lote por bodega</caption>
                    <thead class="bg-ink font-data text-[10px] font-semibold uppercase tracking-[0.12em] text-white">
                        <tr>
                            <th scope="col" class="sticky left-0 z-20 min-w-64 border-r border-white/15 bg-ink px-4 py-4">Lote</th>
                            @foreach (var col in Model.Columns)
                            {
                                <th scope="col" class="min-w-28 px-4 py-4 text-center" title="@col.Name · @col.City">
                                    @col.Code
                                    <span class="mt-1 block font-sans text-xs font-semibold normal-case tracking-normal text-husk">@col.City</span>
                                </th>
                            }
                            <th scope="col" class="min-w-24 bg-white/10 px-4 py-4 text-center">Total</th>
                            <th scope="col" class="w-20 px-4 py-4 text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-oat">
                        @foreach (var row in Model.Rows)
                        {
                            <tr class="group hover:bg-cream/70">
                                <th scope="row" class="sticky left-0 z-10 border-r border-oat bg-white px-4 py-4 group-hover:bg-cream">
                                    <a asp-action="Details" asp-route-id="@row.ProductID" class="cursor-pointer font-extrabold text-ink underline decoration-transparent underline-offset-4 transition-colors hover:text-clay-dark hover:decoration-clay focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">@row.Name</a>
                                    <span class="mt-1 block text-xs font-medium text-ink/55">
                                        @if (!string.IsNullOrWhiteSpace(row.Lot))
                                        {
                                            <span>Lote @row.Lot · </span>
                                        }
                                        <span>@(row.ProviderName ?? "Sin proveedor")</span>
                                    </span>
                                </th>

                                @foreach (var col in Model.Columns)
                                {
                                    var cell = row.CellFor(col.WarehouseID);

                                    <td class="px-4 py-4 text-center" title="@cell.Tooltip">
                                        @if (!cell.Exists)
                                        {
                                            <span class="text-ink/35">—</span>
                                        }
                                        else if (cell.State == "empty")
                                        {
                                            <span class="inline-flex items-center gap-2 font-data text-xs font-semibold text-clay-dark"><span class="size-2 rounded-full bg-clay" aria-hidden="true"></span>@cell.QuantityAvailable</span>
                                        }
                                        else if (cell.State == "low")
                                        {
                                            <span class="inline-flex items-center gap-2 font-data text-xs font-semibold text-honey"><span class="size-2 rounded-full bg-honey" aria-hidden="true"></span>@cell.QuantityAvailable</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-2 font-data text-xs font-semibold text-leaf"><span class="size-2 rounded-full bg-leaf" aria-hidden="true"></span>@cell.QuantityAvailable</span>
                                        }
                                        @if (cell.Exists && cell.QuantityReserved > 0)
                                        {
                                            <span class="mt-1 block text-xs font-semibold text-ink/45">@cell.QuantityReserved res.</span>
                                        }
                                    </td>
                                }

                                <td class="bg-cream/60 px-4 py-4 text-center">
                                    <strong class="font-data text-sm text-ink">@row.TotalAvailable</strong>
                                    @if (row.TotalReserved > 0)
                                    {
                                        <span class="mt-1 block text-xs font-semibold text-ink/45">@row.TotalOnHand en mano</span>
                                    }
                                </td>

                                <td class="px-4 py-3 text-center">
                                    <a asp-action="Details" asp-route-id="@row.ProductID"
                                       class="inline-grid size-11 cursor-pointer place-items-center border border-ink/20 text-ink transition-colors hover:border-clay hover:bg-clay hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-clay"
                                       title="Ver movimientos y ajustar" aria-label="Ver movimientos y ajustar @row.Name">
                                        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/></svg>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="border-t border-ink/20 bg-oat/65 font-data text-xs font-semibold text-ink">
                        <tr>
                            <th scope="row" class="sticky left-0 z-10 border-r border-ink/10 bg-oat px-4 py-4">Total por bodega</th>
                            @foreach (var col in Model.Columns)
                            {
                                <td class="px-4 py-4 text-center">@col.TotalAvailable</td>
                            }
                            <td class="bg-ink px-4 py-4 text-center text-white">@Model.GrandTotalAvailable</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="mt-4 flex flex-wrap gap-x-5 gap-y-3 text-xs font-semibold text-ink/65" aria-label="Leyenda del inventario">
                <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-leaf" aria-hidden="true"></span>Disponible</span>
                <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-honey" aria-hidden="true"></span>En el punto de reorden o por debajo</span>
                <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-clay" aria-hidden="true"></span>Agotado</span>
                <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-ink/25" aria-hidden="true"></span>No asignado a esa bodega</span>
                <span class="w-full text-ink/50 xl:ml-auto xl:w-auto">Los totales corresponden a todos los lotes del filtro, no solo a esta página.</span>
            </div>

            <nav class="mt-6 flex flex-col gap-4 border-t border-ink/15 pt-5 sm:flex-row sm:items-center sm:justify-between" aria-label="Paginación del inventario">
                <span class="text-sm font-semibold text-ink/55">Página @Model.Page de @Model.TotalPages · @Model.TotalCount lotes</span>
                <div class="flex gap-2">
                    @if (Model.HasPrev)
                    {
                        <a class="inline-flex min-h-11 cursor-pointer items-center justify-center border border-ink/20 bg-white px-4 py-2 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay" asp-action="Index" asp-route-bodega="@Model.WarehouseID"
                           asp-route-proveedor="@Model.ProviderID" asp-route-estado="@Model.Estado" asp-route-bajo="@Model.SoloStockBajo" asp-route-q="@Model.Query" asp-route-page="@(Model.Page - 1)">← Anterior</a>
                    }
                    @if (Model.HasNext)
                    {
                        <a class="inline-flex min-h-11 cursor-pointer items-center justify-center border border-ink/20 bg-white px-4 py-2 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay" asp-action="Index" asp-route-bodega="@Model.WarehouseID"
                           asp-route-proveedor="@Model.ProviderID" asp-route-estado="@Model.Estado" asp-route-bajo="@Model.SoloStockBajo" asp-route-q="@Model.Query" asp-route-page="@(Model.Page + 1)">Siguiente →</a>
                    }
                </div>
            </nav>
        }
    </div>
}
