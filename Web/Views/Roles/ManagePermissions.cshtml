@model Web.Models.ViewModels.ManagePermissionsViewModel
@{
    ViewData["Title"] = "Gestionar Permisos";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Permisos para el Rol: <strong>@Model.RoleName</strong></h5>
            <a asp-action="Index" class="btn btn-sm btn-light text-info">Volver</a>
        </div>
        <div class="card-body">
            <form asp-action="ManagePermissions">
                <input type="hidden" asp-for="RoleId" />
                
                <div class="row">
                    @for (int i = 0; i < Model.Modules.Count; i++)
                    {
                        <div class="col-md-6 mb-4">
                            <div class="card h-100">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0 font-weight-bold text-primary">@Model.Modules[i].ModuleName</h6>
                                </div>
                                <div class="card-body">
                                    <input type="hidden" asp-for="Modules[i].ModuleCode" />
                                    <input type="hidden" asp-for="Modules[i].ModuleName" />
                                    
                                    <div class="list-group list-group-flush">
                                        @for (int j = 0; j < Model.Modules[i].Permissions.Count; j++)
                                        {
                                            <div class="list-group-item">
                                                <div class="form-check form-switch">
                                                    <input type="hidden" asp-for="Modules[i].Permissions[j].ParametricPermissionID" />
                                                    <input type="hidden" asp-for="Modules[i].Permissions[j].PermissionName" />
                                                    <input class="form-check-input" type="checkbox" asp-for="Modules[i].Permissions[j].Selected" id="@($"perm_{i}_{j}")">
                                                    <label class="form-check-label" for="@($"perm_{i}_{j}")">
                                                        @Model.Modules[i].Permissions[j].PermissionName 
                                                        <small class="text-muted d-block">@Model.Modules[i].Permissions[j].Description</small>
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-3">
                    <button type="submit" class="btn btn-success"><i class="fas fa-save me-2"></i>Guardar Permisos</button>
                </div>
            </form>
        </div>
    </div>
</div>
