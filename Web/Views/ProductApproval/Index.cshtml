@model IEnumerable<Web.Models.Product>
@using Web.Models.Enums

@{
    ViewData["Title"] = "Aprobación de Productos";
    Layout = "_LayoutAdminTailwind";

    var items = Model.ToList();
    int nPending = items.Count(p => p.ProductStatus == ProductStatus.PendingApproval);
    int nApproved = items.Count(p => p.ProductStatus == ProductStatus.ApprovedToShip || p.ProductStatus == ProductStatus.Shipped || p.ProductStatus == ProductStatus.Active);
    int nRejected = items.Count(p => p.ProductStatus == ProductStatus.Rejected);

    string GroupOf(ProductStatus status) => status switch
    {
        ProductStatus.PendingApproval => "pending",
        ProductStatus.Rejected => "rejected",
        _ => "approved"
    };

    string StatusLabel(ProductStatus status) => status switch
    {
        ProductStatus.Draft => "Borrador",
        ProductStatus.PendingApproval => "Pendiente aprobación",
        ProductStatus.ApprovedToShip => "Esperando envío",
        ProductStatus.Shipped => "Enviado · por recibir",
        ProductStatus.Active => "Activo · en venta",
        ProductStatus.Rejected => "Rechazado",
        _ => status.ToString()
    };

    string StatusClass(ProductStatus status) => status switch
    {
        ProductStatus.Active => "bg-leaf/10 text-leaf",
        ProductStatus.PendingApproval => "bg-honey/15 text-ink",
        ProductStatus.ApprovedToShip => "bg-clay/10 text-clay-dark",
        ProductStatus.Shipped => "bg-ink/10 text-ink",
        ProductStatus.Rejected => "bg-clay/15 text-clay-dark",
        _ => "bg-oat text-ink/70"
    };
}

<header class="border-b border-ink/15 pb-7">
    <div class="max-w-3xl">
        <h1 class="font-display text-3xl leading-none tracking-[-0.04em] text-ink sm:text-4xl">Aprobación de productos</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-ink/65 sm:text-base">Valida datos, fotos y calidad antes de autorizar el envío de cada lote al patio de Bean.</p>
    </div>
    <div class="mt-6 flex gap-6 overflow-x-auto border-b border-ink/15" role="tablist" aria-label="Estados de aprobación">
        <button type="button" id="tab-pending" role="tab" aria-selected="true" aria-controls="beanApprList" data-approval-tab="pending" class="inline-flex min-h-11 shrink-0 cursor-pointer items-center border-b-2 border-clay px-1 py-3 text-sm font-extrabold text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">Pendientes <span class="ml-2 font-data text-[10px] text-clay-dark">@nPending</span></button>
        <button type="button" id="tab-approved" role="tab" aria-selected="false" aria-controls="beanApprList" data-approval-tab="approved" class="inline-flex min-h-11 shrink-0 cursor-pointer items-center border-b-2 border-transparent px-1 py-3 text-sm font-bold text-ink/55 transition-colors hover:border-ink/25 hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">Aprobados <span class="ml-2 font-data text-[10px] text-clay-dark">@nApproved</span></button>
        <button type="button" id="tab-rejected" role="tab" aria-selected="false" aria-controls="beanApprList" data-approval-tab="rejected" class="inline-flex min-h-11 shrink-0 cursor-pointer items-center border-b-2 border-transparent px-1 py-3 text-sm font-bold text-ink/55 transition-colors hover:border-ink/25 hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">Rechazados <span class="ml-2 font-data text-[10px] text-clay-dark">@nRejected</span></button>
    </div>
</header>

<div id="beanApprList" class="mt-8 space-y-4" role="tabpanel" aria-labelledby="tab-pending">
    @foreach (var item in items)
    {
        var group = GroupOf(item.ProductStatus);
        var photoCount = item.Images.Count(i => i.Status);
        <article data-approval-card data-group="@group" hidden="@(group != "pending")" class="border border-ink/15 bg-white p-4 shadow-tray sm:p-5">
            <div class="grid gap-5 lg:grid-cols-[7rem_minmax(0,1fr)_auto] lg:items-start">
                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="" class="aspect-square w-full object-cover sm:w-28" />
                }
                else
                {
                    <span class="grid aspect-square w-full place-items-center bg-clay-dark text-cream sm:w-28" aria-hidden="true"><svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M18.7 5.3C14.8 1.4 7.4 4.2 5 9.2c-2.3 4.8.1 9.4 4.6 9.8 5.3.5 10.2-5.2 9.4-10.1-.2-1.4-.3-2.5-.3-3.6Z" /><path d="M7.2 16.8c3.2-2 4.5-5.8 9.5-9.6" /></svg></span>
                }

                <div class="min-w-0">
                    <h2 class="text-lg font-extrabold tracking-[-0.025em] text-ink">@item.Name</h2>
                    <p class="mt-1 text-xs font-semibold leading-5 text-ink/55">
                        @(item.Provider?.Name ?? "Sin proveedor")
                        @if (!string.IsNullOrEmpty(item.Provider?.NIT))
                        {
                            <text> · NIT @item.Provider.NIT</text>
                        }
                    </p>
                    <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2 font-data text-[10px] font-semibold uppercase tracking-[0.08em] text-ink/60">
                        <span>Stock @item.Stock</span><span>@item.Price.ToString("C")</span>
                        @if (!string.IsNullOrEmpty(item.ShippingDetails))
                        {
                            <span class="inline-flex items-center gap-1.5"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z" /><circle cx="7" cy="18" r="2" /><circle cx="18" cy="18" r="2" /></svg>@item.ShippingDetails</span>
                        }
                    </div>
                    <div class="mt-3 flex flex-wrap gap-2">
                        @foreach (var pc in item.ProductCountries.Where(c => c.IsTargeted))
                        {
                            <span class="rounded-full bg-oat px-3 py-1 font-data text-[10px] font-semibold uppercase tracking-[0.08em] text-ink/70">@pc.Country?.Name</span>
                        }
                    </div>
                </div>

                <span class="inline-flex w-fit items-center gap-2 rounded-full px-3 py-1.5 font-data text-[10px] font-semibold uppercase tracking-[0.08em] @(StatusClass(item.ProductStatus))"><span class="size-2 rounded-full bg-current" aria-hidden="true"></span>@StatusLabel(item.ProductStatus)</span>
            </div>

            <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-oat pt-4 lg:justify-end">
                <a asp-controller="ProductImages" asp-action="Manage" asp-route-id="@item.ProductID" class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 border border-ink/20 px-4 py-2 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay" title="Gestionar fotos del lote">
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="6" width="18" height="14" /><path d="m3 16 5-5 4 4 3-3 6 6M9 6l1-2h4l1 2" /><circle cx="16.5" cy="10.5" r="1.5" /></svg>
                    Fotos · @photoCount
                </a>

                @if (item.ProductStatus == ProductStatus.PendingApproval)
                {
                    <form asp-action="Approve" asp-route-id="@item.ProductID" method="post" onsubmit="return confirm('¿Aprobar producto? El proveedor será notificado para enviar.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 bg-leaf px-4 py-2 text-sm font-extrabold text-white transition-colors hover:bg-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-leaf focus-visible:ring-offset-2 focus-visible:ring-offset-white">
                            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                            Aprobar
                        </button>
                    </form>
                    <button type="button" data-dialog-open="rejectDialog-@item.ProductID" class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 border border-clay/40 px-4 py-2 text-sm font-extrabold text-clay-dark transition-colors hover:bg-clay hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                        Rechazar
                    </button>

                    <dialog id="rejectDialog-@item.ProductID" class="m-auto w-[min(34rem,calc(100%-2rem))] max-w-none border border-ink/20 bg-cream p-0 text-ink shadow-lift backdrop:bg-ink/75">
                        <form asp-action="Reject" asp-route-id="@item.ProductID" method="post">
                            @Html.AntiForgeryToken()
                            <div class="flex items-start justify-between gap-5 border-b border-oat bg-white p-5 sm:p-6">
                                <div><h2 class="text-xl font-extrabold tracking-[-0.03em]">Rechazar producto</h2><p class="mt-2 text-sm leading-6 text-ink/60">@item.Name</p></div>
                                <button type="button" data-dialog-close class="grid size-11 shrink-0 cursor-pointer place-items-center border border-ink/20 text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay" aria-label="Cerrar"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
                            </div>
                            <div class="p-5 sm:p-6">
                                <label for="reason-@item.ProductID" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65">Motivo del rechazo</label>
                                <textarea id="reason-@item.ProductID" name="reason" required rows="4" class="mt-2 w-full border border-ink/25 bg-white px-4 py-3 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/40 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25" placeholder="Explica al proveedor qué debe corregir…"></textarea>
                            </div>
                            <div class="flex flex-col-reverse gap-2 border-t border-oat bg-white p-5 sm:flex-row sm:justify-end sm:p-6">
                                <button type="button" data-dialog-close class="inline-flex min-h-11 cursor-pointer items-center justify-center border border-ink/20 px-5 py-2 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">Cancelar</button>
                                <button type="submit" class="inline-flex min-h-11 cursor-pointer items-center justify-center bg-clay px-5 py-2 text-sm font-extrabold text-white transition-colors hover:bg-clay-light focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-white">Rechazar producto</button>
                            </div>
                        </form>
                    </dialog>
                }
                else if (item.ProductStatus == ProductStatus.Shipped || item.ProductStatus == ProductStatus.Active)
                {
                    <a asp-action="Receive" asp-route-id="@item.ProductID" class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 bg-clay px-4 py-2 text-sm font-extrabold text-white transition-colors hover:bg-clay-light focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-white">
                        @if (item.ProductStatus == ProductStatus.Active)
                        {
                            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" /></svg><text>Disponibilidad</text>
                        }
                        else
                        {
                            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m4 7 8-4 8 4-8 4-8-4Z" /><path d="M4 7v10l8 4 8-4V7M12 11v10" /></svg><text>Recibir</text>
                        }
                    </a>
                }
                else if (item.ProductStatus == ProductStatus.ApprovedToShip)
                {
                    <span class="text-sm font-semibold text-ink/55">Esperando envío del proveedor</span>
                }
            </div>
        </article>
    }
</div>

<section id="beanApprEmpty" class="mt-8 grid min-h-72 place-items-center border border-oat bg-white px-6 py-12 text-center" hidden aria-live="polite">
    <div class="max-w-lg"><svg class="mx-auto size-12 text-clay" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m5 12 4 4L19 6" /><circle cx="12" cy="12" r="10" /></svg><h2 class="mt-5 text-xl font-extrabold tracking-[-0.025em]">No hay productos en esta pestaña</h2><p class="mt-2 text-sm leading-6 text-ink/60">Cuando haya lotes en este estado aparecerán aquí.</p></div>
</section>

@section Scripts {
    <script>
        (function () {
            var list = document.getElementById('beanApprList');
            var empty = document.getElementById('beanApprEmpty');
            var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-approval-tab]'));

            function filter(group, selectedTab) {
                var visible = 0;
                document.querySelectorAll('[data-approval-card]').forEach(function (card) {
                    var show = card.getAttribute('data-group') === group;
                    card.hidden = !show;
                    if (show) visible++;
                });
                tabs.forEach(function (tab) {
                    var active = tab === selectedTab;
                    tab.setAttribute('aria-selected', active ? 'true' : 'false');
                    tab.classList.toggle('border-clay', active);
                    tab.classList.toggle('font-extrabold', active);
                    tab.classList.toggle('text-ink', active);
                    tab.classList.toggle('border-transparent', !active);
                    tab.classList.toggle('font-bold', !active);
                    tab.classList.toggle('text-ink/55', !active);
                });
                if (list) list.setAttribute('aria-labelledby', selectedTab.id);
                if (empty) empty.hidden = visible !== 0;
            }

            tabs.forEach(function (tab, index) {
                tab.addEventListener('click', function () { filter(tab.getAttribute('data-approval-tab'), tab); });
                tab.addEventListener('keydown', function (event) {
                    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
                    event.preventDefault();
                    var next = event.key === 'ArrowRight' ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
                    tabs[next].focus();
                    tabs[next].click();
                });
            });

            document.querySelectorAll('[data-dialog-open]').forEach(function (trigger) {
                trigger.addEventListener('click', function () {
                    var dialog = document.getElementById(trigger.getAttribute('data-dialog-open'));
                    if (dialog && typeof dialog.showModal === 'function') dialog.showModal();
                });
            });
            document.querySelectorAll('dialog').forEach(function (dialog) {
                dialog.querySelectorAll('[data-dialog-close]').forEach(function (button) {
                    button.addEventListener('click', function () { dialog.close(); });
                });
                dialog.addEventListener('click', function (event) {
                    if (event.target === dialog) dialog.close();
                });
            });

            if (tabs.length) filter('pending', tabs[0]);
        })();
    </script>
}
