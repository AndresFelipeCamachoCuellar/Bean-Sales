@model Web.Models.Product
@using Web.Models.Enums
@using Web.Constants
@using Web.Models
@using Web.Models.ViewModels
@using Web.Services
@using Web.Services.Pricing
@using Microsoft.AspNetCore.Identity
@inject IPermissionService PermissionService
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Recibir Producto";
    Layout = "_LayoutAdminTailwind";
    var isActive = Model.ProductStatus == ProductStatus.Active;
    var receiveWarehouses = ViewBag.ReceiveWarehouses as List<InventoryFilterOption> ?? new List<InventoryFilterOption>();
    var receiveBalances = ViewBag.ReceiveBalances as List<InventoryBalanceRowViewModel> ?? new List<InventoryBalanceRowViewModel>();
    var sinBodegas = receiveWarehouses.Count == 0;

    // Reception suma al libro. Solo se sugiere el stock declarado si aún no existe saldo.
    var yaTieneSaldo = receiveBalances.Any(b => b.QuantityOnHand != 0);
    var cantidadSugerida = (!isActive && !yaTieneSaldo && Model.Stock > 0) ? Model.Stock.ToString() : string.Empty;
    var co = System.Globalization.CultureInfo.GetCultureInfo("es-CO");

    var pricingUser = await UserManager.GetUserAsync(User);
    var canReadPricing = pricingUser != null && await PermissionService.HasPermissionAsync(pricingUser, Modules.Pricing, Permissions.Read);
    var canSetPrice = pricingUser != null && await PermissionService.HasPermissionAsync(pricingUser, Modules.Pricing, Permissions.Update);
    var targetMargin = ViewBag.TargetMarginPercent is decimal t ? t : 30m;
    var minimumMargin = ViewBag.MinimumMarginPercent is decimal m ? m : 15m;
    var roundingStep = ViewBag.RoundingStep is decimal r ? r : 50m;
    var receiveMargin = PricingCalculator.CalculateMargin(Model.Price, Model.SupplierPrice);
    var receiveSuggested = PricingCalculator.SuggestPrice(Model.SupplierPrice, targetMargin, roundingStep);
    var priceMissing = Model.Price <= 0m;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var receivePriceText = priceMissing ? "sin fijar" : Model.Price.ToString("C0", co);
    var receiveMarginText = receiveMargin.IsCalculable ? receiveMargin.Percent.ToString("N2") + " % · " + receiveMargin.Amount.ToString("C0", co) : "—";
    var receiveSuggestedText = receiveSuggested > 0 ? receiveSuggested.ToString("C0", co) : "—";
    const string labelClass = "font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65";
    const string inputClass = "mt-2 min-h-12 w-full border border-ink/25 bg-cream px-4 py-2 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/40 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25";
    const string selectClass = "mt-2 min-h-12 w-full cursor-pointer border border-ink/25 bg-cream px-3 py-2 text-sm font-semibold text-ink outline-none transition-colors hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25";
}

<header class="flex flex-col gap-6 border-b border-ink/15 pb-7 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
        <h1 class="font-display text-3xl leading-none tracking-[-0.04em] text-ink sm:text-4xl">@(isActive ? "Gestionar disponibilidad" : "Recibir producto")</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-ink/65 sm:text-base">@(isActive ? "Actualiza los países visibles y registra reposiciones cuando corresponda." : "Confirma la entrada física a bodega y publica el lote en los países aprobados.")</p>
    </div>
    <a asp-action="Index" class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 self-start border border-ink/20 bg-white px-5 py-3 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream lg:self-auto"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6" /></svg>Volver</a>
</header>

<dl class="mt-8 grid border border-ink/15 bg-white sm:grid-cols-2 xl:grid-cols-5">
    <div class="border-b border-oat p-4 sm:border-r xl:border-b-0"><dt class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/50">Producto</dt><dd class="mt-2 font-extrabold text-ink">@Model.Name</dd></div>
    <div class="border-b border-oat p-4 xl:border-b-0 xl:border-r"><dt class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/50">Proveedor</dt><dd class="mt-2 font-semibold text-ink">@(Model.Provider?.Name ?? "—")</dd></div>
    <div class="border-b border-oat p-4 sm:border-r xl:border-b-0"><dt class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/50">Estado</dt><dd class="mt-2"><span class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 font-data text-[10px] font-semibold uppercase tracking-[0.08em] @(isActive ? "bg-leaf/10 text-leaf" : "bg-ink/10 text-ink")"><span class="size-2 rounded-full bg-current" aria-hidden="true"></span>@(isActive ? "Activo · en venta" : Model.ProductStatus == ProductStatus.Shipped ? "Enviado · por recibir" : Model.ProductStatus.ToString())</span></dd></div>
    <div class="border-b border-oat p-4 sm:border-b-0 sm:border-r"><dt class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/50">Stock declarado</dt><dd class="mt-2 font-data text-sm font-semibold tabular-nums text-ink">@Model.Stock unidades</dd></div>
    <div class="p-4"><dt class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/50">Precio de venta</dt><dd class="mt-2 font-extrabold tabular-nums @(priceMissing ? "text-clay-dark" : "text-ink")">@receivePriceText</dd></div>
</dl>

@foreach (var notice in new[]
{
    (Key: "PricingError", Error: true), (Key: "PricingOk", Error: false),
    (Key: "ReceiveError", Error: true), (Key: "ReceiveOk", Error: false)
})
{
    if (TempData[notice.Key] != null)
    {
        <div class="mt-5 flex items-start gap-3 border px-4 py-3 text-sm font-semibold leading-6 @(notice.Error ? "border-clay/35 bg-clay/10 text-clay-dark" : "border-leaf/30 bg-leaf/10 text-leaf")" role="@(notice.Error ? "alert" : "status")">
            @if (notice.Error)
            {
                <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 2.8 20h18.4L12 3Z" /><path d="M12 9v5M12 17h.01" /></svg>
            }
            else
            {
                <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg>
            }
            <div>@TempData[notice.Key]</div>
        </div>
    }
}

@if (canReadPricing)
{
    <section class="mt-8 border border-ink/15 bg-white" aria-labelledby="pricing-title">
        <div class="border-b border-oat px-4 py-5 sm:px-6"><h2 id="pricing-title" class="text-xl font-extrabold tracking-[-0.03em] text-ink">Precio y margen</h2><p class="mt-2 text-sm leading-6 text-ink/60">Información interna de Bean. Sin PVP el lote no puede activarse.</p></div>
        <dl class="grid sm:grid-cols-2 xl:grid-cols-4">
            <div class="border-b border-oat p-4 sm:border-r xl:border-b-0 sm:p-5"><dt class="font-data text-[10px] font-semibold uppercase tracking-[0.12em] text-ink/50">Costo proveedor</dt><dd class="mt-2 font-extrabold tabular-nums">@Model.SupplierPrice.ToString("C0", co)</dd></div>
            <div class="border-b border-oat p-4 xl:border-b-0 xl:border-r sm:p-5"><dt class="font-data text-[10px] font-semibold uppercase tracking-[0.12em] text-ink/50">PVP</dt><dd class="mt-2 font-extrabold tabular-nums @(priceMissing ? "text-clay-dark" : "text-ink")">@receivePriceText</dd></div>
            <div class="border-b border-oat p-4 sm:border-b-0 sm:border-r sm:p-5"><dt class="font-data text-[10px] font-semibold uppercase tracking-[0.12em] text-ink/50">Margen</dt><dd class="mt-2 font-extrabold tabular-nums">@receiveMarginText</dd></div>
            <div class="p-4 sm:p-5"><dt class="font-data text-[10px] font-semibold uppercase tracking-[0.12em] text-ink/50">Sugerido · @targetMargin.ToString("N0") %</dt><dd class="mt-2 font-extrabold tabular-nums">@receiveSuggestedText</dd></div>
        </dl>

        @if (priceMissing)
        {
            <div class="m-4 flex items-start gap-3 border border-clay/35 bg-clay/10 px-4 py-3 text-sm font-semibold leading-6 text-clay-dark sm:m-6" role="alert"><svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="10" width="14" height="10" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg><div>Este lote todavía no tiene precio de venta. <strong>No se puede activar sin PVP.</strong></div></div>
        }

        @if (canSetPrice)
        {
            @* Formulario independiente del POST Receive. *@
            <form asp-controller="Pricing" asp-action="SetPrice" method="post" class="grid gap-4 border-t border-oat bg-cream p-4 sm:p-6 lg:grid-cols-[12rem_minmax(16rem,1fr)_auto] lg:items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ProductID" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div><label class="@labelClass" for="receive-price">Precio de venta (COP)</label><input id="receive-price" type="number" name="price" step="0.01" min="0" class="@inputClass" value="@(Model.Price > 0 ? Model.Price : receiveSuggested)" /></div>
                <div><label class="@labelClass" for="receive-reason">Motivo (si baja del mínimo @minimumMargin.ToString("N0") %)</label><input id="receive-reason" type="text" name="reason" class="@inputClass" maxlength="300" placeholder="Promoción, liquidación u otra justificación" /></div>
                <button type="submit" class="inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 bg-clay px-5 py-3 text-sm font-extrabold text-white transition-colors hover:bg-clay-light focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 13 11 22l-9-9V4h9l9 9Z" /><circle cx="7" cy="9" r="1" /></svg>Fijar precio</button>
            </form>
        }
    </section>
}

@* El gestor debe permanecer fuera de cualquier form: usa POST AJAX independientes. *@
@if (ViewBag.ImageManager is Web.Models.ViewModels.ProductImageManagerViewModel imageManager)
{
    <section class="mt-8 border border-ink/15 bg-white p-4 sm:p-6" aria-label="Gestor de fotos del lote"><partial name="_ProductImageManager" model="imageManager" /></section>
}

<form asp-action="Receive" method="post" class="mt-8 space-y-8">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.ProductID" />

    <section class="border border-ink/15 bg-white" aria-labelledby="bodega-title">
        <div class="border-b border-oat px-4 py-5 sm:px-6">
            <h2 id="bodega-title" class="text-xl font-extrabold tracking-[-0.03em] text-ink">Entrada a bodega</h2>
            <p class="mt-2 max-w-4xl text-sm leading-6 text-ink/60">
                @if (isActive)
                {
                    <text>Si registras una <strong class="text-ink">reposición</strong>, indica bodega y cantidad. Si solo ajustas países, deja la cantidad vacía.</text>
                }
                else
                {
                    <text>Indica dónde entra el lote, cuántas unidades llegaron y su costo unitario. <strong class="text-ink">Sin bodega no se puede recibir.</strong></text>
                }
            </p>
        </div>

        @if (sinBodegas)
        {
            <div class="m-4 flex items-start gap-3 border border-clay/35 bg-clay/10 px-4 py-3 text-sm font-semibold leading-6 text-clay-dark sm:m-6" role="alert"><svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 2.8 20h18.4L12 3Z" /><path d="M12 9v5M12 17h.01" /></svg><div>No hay bodegas operativas. Crea una en <strong>Bodegas</strong> antes de recibir este lote.</div></div>
        }
        else
        {
            <div class="grid gap-x-6 gap-y-5 p-4 sm:p-6 lg:grid-cols-3">
                <div><label class="@labelClass" for="rcv-wh">Bodega @(isActive ? "" : "(obligatoria)")</label><select id="rcv-wh" name="warehouseId" class="@selectClass">@if (isActive){<option value="">— Sin entrada de inventario —</option>}@foreach (var w in receiveWarehouses){<option value="@w.Id">@w.Label</option>}</select></div>
                <div><label class="@labelClass" for="rcv-qty">Cantidad recibida</label><input id="rcv-qty" type="number" name="receiveQuantity" min="0" step="1" class="@inputClass" value="@cantidadSugerida" placeholder="Ej: 120" /><span class="mt-2 block text-xs font-medium leading-5 text-ink/50">Unidades físicas recibidas. <strong class="text-ink">Se suman</strong> al saldo actual.</span></div>
                <div>
                    <label class="@labelClass" for="rcv-cost">Costo unitario (COP)</label>
                    <div class="relative mt-2"><span class="pointer-events-none absolute inset-y-0 left-0 grid w-11 place-items-center border-r border-ink/15 font-data text-xs font-semibold text-ink/55">$</span><input id="rcv-cost" type="number" name="receiveUnitCost" min="0" step="0.01" class="min-h-12 w-full border border-ink/25 bg-cream py-2 pl-14 pr-4 text-base tabular-nums text-ink caret-clay outline-none transition-colors hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25" value="@(Model.SupplierPrice > 0m ? Model.SupplierPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : string.Empty)" /></div>
                    <span class="mt-2 block text-xs font-medium leading-5 text-ink/50">Vacío usa el costo del proveedor. Alimenta la liquidación.</span>
                </div>
            </div>
            <div class="mx-4 mb-4 flex items-start gap-3 border border-ink/15 bg-cream px-4 py-3 text-sm font-semibold leading-6 text-ink/70 sm:mx-6 sm:mb-6"><svg class="mt-0.5 size-5 shrink-0 text-clay-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7h.01" /></svg><div>El catálogo publicará el inventario real disponible: <strong class="text-ink">en mano − reservado</strong>.</div></div>
        }

        @if (receiveBalances.Count > 0)
        {
            <div class="border-t border-oat bg-oat/45 p-4 sm:p-6">
                <div class="flex items-start gap-3 text-sm font-semibold leading-6 text-ink/70"><svg class="mt-0.5 size-5 shrink-0 text-honey" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 2.8 20h18.4L12 3Z" /><path d="M12 9v5M12 17h.01" /></svg><div><strong class="text-ink">Este lote ya tiene saldo.</strong> La cantidad nueva se suma. Déjala vacía si el inventario actual ya corresponde a esta recepción.</div></div>
                <dl class="mt-4 grid gap-px bg-ink/10 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var balance in receiveBalances)
                    {
                        <div class="bg-white p-4"><dt class="font-data text-[10px] font-semibold uppercase tracking-[0.12em] text-clay-dark">@balance.Code · @balance.City</dt><dd class="mt-2 text-sm font-extrabold tabular-nums text-ink">@balance.QuantityAvailable disponibles <span class="font-medium text-ink/50">(@balance.QuantityOnHand en mano)</span></dd></div>
                    }
                </dl>
            </div>
        }
    </section>

    <section class="border border-ink/15 bg-white" aria-labelledby="disponibilidad-title">
        <div class="border-b border-oat px-4 py-5 sm:px-6"><h2 id="disponibilidad-title" class="text-xl font-extrabold tracking-[-0.03em] text-ink">Disponibilidad por país</h2><p class="mt-2 text-sm leading-6 text-ink/60">Selecciona dónde estará visible. En la primera recepción se sugieren los países solicitados por el proveedor.</p></div>
        <div class="grid gap-3 p-4 sm:grid-cols-2 sm:p-6 lg:grid-cols-3">
            @foreach (var pc in Model.ProductCountries)
            {
                var isChecked = pc.IsAvailable;
                if (Model.ProductStatus == ProductStatus.Shipped && pc.IsTargeted)
                {
                    isChecked = true;
                }
                <label for="c_@pc.CountryID" class="flex min-h-14 cursor-pointer items-center gap-3 border border-ink/15 bg-cream px-4 py-3 text-sm font-extrabold text-ink transition-colors hover:border-clay">
                    <input class="size-4 shrink-0 cursor-pointer rounded-none accent-clay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream" type="checkbox" name="availableCountryIds" value="@pc.CountryID" id="c_@pc.CountryID" @(isChecked ? "checked" : "") />
                    <span class="min-w-0"><span>@pc.Country?.Name</span><span class="mt-1 flex flex-wrap gap-1.5">@if (pc.IsTargeted){<span class="rounded-full bg-oat px-2 py-0.5 font-data text-[10px] font-semibold uppercase tracking-[0.08em] text-ink/65">Solicitado</span>}@if (pc.IsAvailable){<span class="rounded-full bg-leaf/10 px-2 py-0.5 font-data text-[10px] font-semibold uppercase tracking-[0.08em] text-leaf">Activo</span>}</span></span>
                </label>
            }
        </div>
        <div class="mx-4 mb-4 flex items-start gap-3 border border-honey/40 bg-honey/10 px-4 py-3 text-sm font-semibold leading-6 text-ink sm:mx-6 sm:mb-6"><svg class="mt-0.5 size-5 shrink-0 text-honey" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 2.8 20h18.4L12 3Z" /><path d="M12 9v5M12 17h.01" /></svg><div>Al confirmar, el producto pasará a <strong>Activo</strong> y será visible en el catálogo de los países seleccionados.</div></div>
    </section>

    <div class="flex flex-col-reverse gap-3 border-t border-ink/15 pt-6 sm:flex-row sm:justify-end">
        <a asp-action="Index" class="inline-flex min-h-12 cursor-pointer items-center justify-center border border-ink/20 bg-white px-6 py-3 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">Cancelar</a>
        <button type="submit" class="inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 bg-clay px-6 py-3 text-sm font-extrabold text-white transition-colors hover:bg-clay-light focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-4 focus-visible:ring-offset-cream disabled:cursor-not-allowed disabled:bg-ink/25 disabled:text-white" @((priceMissing || sinBodegas) && !isActive ? "disabled" : "")><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg>Confirmar recepción</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/bean-media.js" asp-append-version="true"></script>
}
