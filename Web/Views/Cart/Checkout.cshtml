@using Web.Services.Shipping
@model List<Web.Models.ShoppingCartItem>

@{
    Layout = "_LayoutHome";
    ViewData["Title"] = "Checkout";
    var co = new System.Globalization.CultureInfo("es-CO");
    var subtotal = (decimal)ViewBag.Total;
    var shipping = (decimal)ViewBag.Shipping;
    var grandTotal = (decimal)ViewBag.GrandTotal;

    IEnumerable<string> departments = ViewBag.Departments ?? Enumerable.Empty<string>();
    IEnumerable<ShippingCityItem> cities = ViewBag.Cities ?? Enumerable.Empty<ShippingCityItem>();
    string? selectedDepartment = ViewBag.SelectedDepartment as string;
    string? selectedDane = ViewBag.SelectedCityDaneCode as string;
    string? selectedCity = ViewBag.SelectedCityName as string;

    var requiresCity = ViewBag.ShippingRequiresCity is bool requiresFlag && requiresFlag;
    var isDomestic = ViewBag.IsDomestic is bool domesticFlag ? domesticFlag : true;
    var shippingStatus = ViewBag.ShippingStatus is string status ? status : "Ok";
    string? shippingMessage = ViewBag.ShippingMessage as string;
    string? carrier = ViewBag.ShippingCarrier as string;
    int? shippingDays = ViewBag.ShippingDays is int days ? days : null;

    var noCoverage = shippingStatus is "NoCoverage" or "Invalid";
    var missingCity = requiresCity && string.IsNullOrEmpty(selectedDane);
    var paymentBlocked = noCoverage || missingCity;
    var paymentLabel = missingCity
        ? "Elige tu ciudad para continuar"
        : noCoverage
            ? "No disponible para este destino"
            : $"Pagar ${grandTotal.ToString("#,##0", co)} COP";

    Guid? pendingOrder = ViewBag.PendingOrderId as Guid?;
    string? pendingOrderShort = ViewBag.PendingOrderShort as string;
    int? pendingMinutes = ViewBag.PendingOrderMinutes as int?;

    var formFirstName = ViewBag.FormFirstName as string ?? string.Empty;
    var formLastName = ViewBag.FormLastName as string ?? string.Empty;
    var formAddress = ViewBag.FormAddress as string ?? string.Empty;
    var formZip = ViewBag.FormZip as string ?? string.Empty;
    var formPhone = ViewBag.FormPhone as string ?? string.Empty;
}

<section class="bg-cream px-4 pb-20 pt-8 sm:px-6 sm:pb-24 sm:pt-12 lg:px-10 lg:pb-32">
    <div class="mx-auto max-w-[90rem]">
        <ol class="grid grid-cols-[auto_1fr_auto_1fr_auto] items-center gap-2 border-y border-ink/15 py-5 sm:gap-4" aria-label="Progreso del checkout">
            <li class="flex items-center gap-2 text-xs font-extrabold text-ink sm:text-sm">
                <span class="grid size-7 place-items-center bg-clay font-data text-[10px] text-white">1</span>
                <span>Envío</span>
            </li>
            <li class="h-px bg-clay" aria-hidden="true"></li>
            <li class="flex items-center gap-2 text-xs font-extrabold text-ink sm:text-sm">
                <span class="grid size-7 place-items-center bg-clay font-data text-[10px] text-white">2</span>
                <span>Pago</span>
            </li>
            <li class="h-px bg-oat" aria-hidden="true"></li>
            <li class="flex items-center gap-2 text-xs font-bold text-ink/40 sm:text-sm">
                <span class="grid size-7 place-items-center border border-ink/20 font-data text-[10px]">3</span>
                <span class="hidden sm:inline">Confirmación</span>
                <span class="sm:hidden">Listo</span>
            </li>
        </ol>

        <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:items-start">
            <div class="min-w-0 lg:col-span-7">
                @if (TempData["CheckoutError"] != null)
                {
                    <div class="mb-6 flex items-start gap-3 border border-clay/30 bg-white px-5 py-4 text-sm font-semibold text-clay-dark" role="alert">
                        <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v6M12 17h.01" /></svg>
                        <span>@TempData["CheckoutError"]</span>
                    </div>
                }

                @if (pendingOrder.HasValue)
                {
                    <div class="mb-6 border border-honey/35 bg-white p-5" role="status">
                        <div class="flex items-start gap-3">
                            <svg class="mt-0.5 size-5 shrink-0 text-honey" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                            <p class="text-sm leading-6 text-ink/70">Tienes el pedido <strong class="text-ink">#@pendingOrderShort</strong> esperando pago@(pendingMinutes.HasValue ? $" (vence en {pendingMinutes.Value} min)" : "").</p>
                        </div>
                        <div class="mt-4 flex flex-wrap items-center gap-4 pl-8">
                            <a asp-controller="Cart" asp-action="Pay" asp-route-id="@pendingOrder.Value" class="cursor-pointer border-b border-ink pb-1 text-sm font-extrabold focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">Retomar el pago</a>
                            <form asp-controller="Cart" asp-action="CancelPayment" asp-route-id="@pendingOrder.Value" method="post">
                                <button type="submit" class="cursor-pointer text-sm font-bold text-clay-dark hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">Cancelar pedido</button>
                            </form>
                        </div>
                    </div>
                }

                <form id="beanCheckoutForm" asp-controller="Cart" asp-action="Checkout" method="post" novalidate>
                    <section class="border border-oat bg-white" aria-labelledby="shipping-address-title">
                        <div class="border-b border-oat px-5 py-5 sm:px-7">
                            <p class="font-data text-[10px] font-semibold uppercase tracking-[0.16em] text-clay-dark">Destino</p>
                            <h1 id="shipping-address-title" class="mt-2 font-display text-3xl leading-none tracking-[-0.04em] sm:text-4xl">Dirección de envío</h1>
                        </div>

                        <div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-7">
                            <div>
                                <label for="firstName" class="mb-2 block text-xs font-extrabold text-ink/65">Nombre</label>
                                <input type="text" id="firstName" name="firstName" value="@formFirstName" autocomplete="given-name" required class="min-h-12 w-full border border-oat bg-cream px-4 py-3 text-sm font-semibold outline-none transition-colors focus:border-clay focus:ring-2 focus:ring-clay/20" />
                            </div>
                            <div>
                                <label for="lastName" class="mb-2 block text-xs font-extrabold text-ink/65">Apellido</label>
                                <input type="text" id="lastName" name="lastName" value="@formLastName" autocomplete="family-name" required class="min-h-12 w-full border border-oat bg-cream px-4 py-3 text-sm font-semibold outline-none transition-colors focus:border-clay focus:ring-2 focus:ring-clay/20" />
                            </div>
                            <div class="sm:col-span-2">
                                <label for="address" class="mb-2 block text-xs font-extrabold text-ink/65">Dirección completa</label>
                                <input type="text" id="address" name="address" value="@formAddress" placeholder="Calle 123 #45-67" autocomplete="street-address" required class="min-h-12 w-full border border-oat bg-cream px-4 py-3 text-sm font-semibold outline-none transition-colors placeholder:text-ink/30 focus:border-clay focus:ring-2 focus:ring-clay/20" />
                            </div>
                            <div>
                                <label for="phone" class="mb-2 block text-xs font-extrabold text-ink/65">Celular</label>
                                <input type="tel" id="phone" name="phone" value="@formPhone" placeholder="3001234567" inputmode="tel" autocomplete="tel" minlength="7" maxlength="20" required aria-describedby="phoneHint" class="min-h-12 w-full border border-oat bg-cream px-4 py-3 text-sm font-semibold outline-none transition-colors placeholder:text-ink/30 focus:border-clay focus:ring-2 focus:ring-clay/20" />
                                <span id="phoneHint" class="mt-2 block text-xs leading-5 text-ink/45">Para coordinar la entrega. Solo números.</span>
                            </div>
                            <div>
                                <label for="country" class="mb-2 block text-xs font-extrabold text-ink/65">País</label>
                                <select id="country" name="country" required class="min-h-12 w-full cursor-pointer border border-oat bg-cream px-4 py-3 text-sm font-semibold outline-none focus:border-clay focus:ring-2 focus:ring-clay/20">
                                    <option value="Colombia" selected>Colombia</option>
                                </select>
                                <span class="mt-2 block text-xs leading-5 text-ink/45">Por ahora solo despachamos dentro de Colombia.</span>
                            </div>

                            @if (isDomestic)
                            {
                                <div>
                                    <label for="state" class="mb-2 block text-xs font-extrabold text-ink/65">Departamento</label>
                                    <select id="state" name="state" required class="min-h-12 w-full cursor-pointer border border-oat bg-cream px-4 py-3 text-sm font-semibold outline-none focus:border-clay focus:ring-2 focus:ring-clay/20">
                                        <option value="">Selecciona tu departamento</option>
                                        @foreach (var department in departments)
                                        {
                                            if (department == selectedDepartment)
                                            {
                                                <option value="@department" selected>@department</option>
                                            }
                                            else
                                            {
                                                <option value="@department">@department</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label for="cityDaneCode" class="mb-2 block text-xs font-extrabold text-ink/65">Ciudad</label>
                                    <select id="cityDaneCode" name="cityDaneCode" required disabled="@(string.IsNullOrEmpty(selectedDepartment))" class="min-h-12 w-full cursor-pointer border border-oat bg-cream px-4 py-3 text-sm font-semibold outline-none focus:border-clay focus:ring-2 focus:ring-clay/20 disabled:cursor-not-allowed disabled:opacity-50">
                                        <option value="">@(string.IsNullOrEmpty(selectedDepartment) ? "Elige primero el departamento" : "Selecciona tu ciudad")</option>
                                        @foreach (var city in cities)
                                        {
                                            if (city.DaneCode == selectedDane)
                                            {
                                                <option value="@city.DaneCode" selected>@city.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@city.DaneCode">@city.Name</option>
                                            }
                                        }
                                    </select>
                                    <input type="hidden" id="cityName" name="cityName" value="@selectedCity" />
                                </div>
                            }
                            else
                            {
                                <div class="sm:col-span-2">
                                    <label for="state" class="mb-2 block text-xs font-extrabold text-ink/65">Estado / Provincia</label>
                                    <input type="text" id="state" name="state" value="@selectedDepartment" required class="min-h-12 w-full border border-oat bg-cream px-4 py-3 text-sm font-semibold outline-none focus:border-clay focus:ring-2 focus:ring-clay/20" />
                                    <span class="mt-2 block text-xs leading-5 text-ink/45">Los envíos fuera de Colombia se cotizan con tarifa estándar.</span>
                                </div>
                            }

                            <div>
                                <label for="zip" class="mb-2 block text-xs font-extrabold text-ink/65">Código postal <span class="font-medium text-ink/35">(opcional)</span></label>
                                <input type="text" id="zip" name="zip" value="@formZip" placeholder="110111" autocomplete="postal-code" class="min-h-12 w-full border border-oat bg-cream px-4 py-3 text-sm font-semibold outline-none transition-colors placeholder:text-ink/30 focus:border-clay focus:ring-2 focus:ring-clay/20" />
                            </div>
                        </div>
                    </section>

                    <section class="mt-6 border border-oat bg-white" aria-labelledby="shipping-quote-title">
                        <div class="border-b border-oat px-5 py-4 sm:px-7">
                            <h2 id="shipping-quote-title" class="text-base font-extrabold tracking-[-0.02em]">Envío</h2>
                        </div>
                        <div id="beanShipBox" class="p-5 sm:p-7" aria-live="polite">
                            <div id="beanShipPending" class="flex items-start gap-3 text-sm font-semibold leading-6 text-ink/60 @(missingCity && !noCoverage ? "" : "hidden")" role="status">
                                <svg class="mt-0.5 size-5 shrink-0 text-clay" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 7h11v10H3V7Z" /><path d="M14 10h4l3 3v4h-7v-7Z" /><circle cx="7" cy="18" r="2" /><circle cx="17" cy="18" r="2" /></svg>
                                <span>Elige tu departamento y ciudad para calcular el costo del envío.</span>
                            </div>
                            <div id="beanShipAlert" class="flex items-start gap-3 text-sm font-semibold leading-6 text-clay-dark @(noCoverage ? "" : "hidden")" role="alert">
                                <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v6M12 17h.01" /></svg>
                                <span id="beanShipAlertText">@(shippingMessage ?? "Todavía no llegamos a esa ciudad. Escríbenos y lo gestionamos contigo.")</span>
                            </div>
                            <div id="beanShipOption" class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between @(paymentBlocked ? "hidden" : "")">
                                <div>
                                    <strong id="beanShipCarrier" class="block text-sm font-extrabold">@(carrier ?? "Envío estándar")</strong>
                                    <span id="beanShipEta" class="mt-1 block text-xs font-medium text-ink/50">@(shippingDays.HasValue ? $"Entrega estimada en {shippingDays.Value} días hábiles" : "Entrega estimada en días hábiles")</span>
                                </div>
                                <strong id="beanShipPrice" class="font-data text-sm text-clay-dark">$@shipping.ToString("#,##0", co)</strong>
                            </div>
                            <div id="beanShipNote" class="mt-4 flex items-start gap-3 border-t border-oat pt-4 text-xs font-semibold leading-5 text-ink/55 @(shippingStatus == "Fallback" ? "" : "hidden")" role="status">
                                <svg class="mt-0.5 size-4 shrink-0 text-honey" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg>
                                <span id="beanShipNoteText">No pudimos cotizar con la transportadora; se aplica una tarifa estándar.</span>
                            </div>
                        </div>
                    </section>

                    <section class="mt-6 border border-oat bg-white p-5 sm:p-7" aria-labelledby="payment-method-title">
                        <h2 id="payment-method-title" class="text-base font-extrabold tracking-[-0.02em]">Método de pago</h2>
                        <div class="mt-5 flex items-start gap-4 bg-cream p-5">
                            <span class="grid size-11 shrink-0 place-items-center bg-ink text-white" aria-hidden="true">
                                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="10" width="14" height="10" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                            </span>
                            <div>
                                <h3 class="text-sm font-extrabold">Pago seguro con Wompi</h3>
                                <p class="mt-2 text-sm leading-6 text-ink/55">Te llevamos a la pasarela de Bancolombia para elegir tu medio de pago y volver automáticamente.</p>
                                <div class="mt-4 flex flex-wrap gap-2">
                                    @foreach (var paymentBrand in new[] { "Tarjetas", "PSE", "Nequi", "Bancolombia" })
                                    {
                                        <span class="rounded-full border border-oat bg-white px-3 py-1.5 text-[10px] font-bold text-ink/60">@paymentBrand</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </section>

                    <button type="submit" id="beanPayBtn" disabled="@paymentBlocked" class="mt-6 inline-flex min-h-14 w-full cursor-pointer items-center justify-center gap-3 bg-clay px-6 py-4 text-sm font-extrabold text-white transition-colors hover:bg-clay-light focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-4 focus-visible:ring-offset-cream disabled:cursor-not-allowed disabled:bg-ink/15 disabled:text-ink/45">
                        <span id="beanPayLabel">@paymentLabel</span>
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                    </button>
                </form>
            </div>

            <aside class="bg-ink p-6 text-white shadow-tray sm:p-8 lg:sticky lg:top-28 lg:col-span-5" aria-labelledby="order-summary-title">
                <div class="flex items-center justify-between border-b border-white/15 pb-5">
                    <h2 id="order-summary-title" class="text-lg font-extrabold tracking-[-0.025em]">Tu orden</h2>
                    <span class="font-data text-[10px] font-semibold uppercase tracking-[0.16em] text-clay-light">@Model.Sum(item => item.Quantity) bolsas</span>
                </div>

                <div class="divide-y divide-white/10">
                    @foreach (var item in Model)
                    {
                        var productName = item.Product?.Name ?? "Producto";
                        var productInitial = string.IsNullOrWhiteSpace(productName) ? "B" : productName.Trim()[..1].ToUpperInvariant();
                        <article class="grid grid-cols-[3.75rem_minmax(0,1fr)_auto] items-center gap-3 py-5">
                            <div class="aspect-square overflow-hidden bg-clay-dark">
                                @if (!string.IsNullOrWhiteSpace(item.Product?.ImageUrl))
                                {
                                    <img src="@item.Product.ImageUrl" alt="" class="h-full w-full object-cover" />
                                }
                                else
                                {
                                    <span class="grid h-full place-items-center font-display text-xl text-cream">@productInitial</span>
                                }
                            </div>
                            <div class="min-w-0">
                                <h3 class="truncate text-sm font-extrabold">@productName</h3>
                                <p class="mt-1 text-xs font-semibold text-husk">Cantidad: @item.Quantity</p>
                            </div>
                            <strong class="whitespace-nowrap text-sm">$@((item.Quantity * (item.Product?.Price ?? 0)).ToString("#,##0", co))</strong>
                        </article>
                    }
                </div>

                <dl class="border-t border-white/15 pt-2 text-sm">
                    <div class="flex items-center justify-between gap-4 py-3">
                        <dt class="text-husk">Subtotal</dt>
                        <dd class="font-bold">$@subtotal.ToString("#,##0", co)</dd>
                    </div>
                    <div class="flex items-center justify-between gap-4 py-3">
                        <dt class="text-husk">Envío</dt>
                        <dd id="beanSummaryShipping" class="font-bold">@(paymentBlocked ? "—" : $"${shipping.ToString("#,##0", co)}")</dd>
                    </div>
                </dl>

                <div class="mt-3 flex items-end justify-between gap-4 border-t border-white/20 pt-6">
                    <span class="text-sm font-bold text-husk">Total</span>
                    <strong id="beanSummaryTotal" class="font-display text-3xl tracking-[-0.04em]">@(paymentBlocked ? "—" : $"${grandTotal.ToString("#,##0", co)}")</strong>
                </div>

                <p class="mt-6 flex items-start gap-2 text-xs font-semibold leading-5 text-husk">
                    <svg class="mt-0.5 size-4 shrink-0 text-clay-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6l-7-3Z" /><path d="m9 12 2 2 4-4" /></svg>
                    El monto definitivo se recalcula en el servidor antes de crear tu orden.
                </p>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var hasCitySelector = @(isDomestic ? "true" : "false");
            if (!hasCitySelector) return;

            var form = document.getElementById('beanCheckoutForm');
            var department = document.getElementById('state');
            var city = document.getElementById('cityDaneCode');
            var cityName = document.getElementById('cityName');
            var button = document.getElementById('beanPayBtn');
            var label = document.getElementById('beanPayLabel');
            var alertBox = document.getElementById('beanShipAlert');
            var alertText = document.getElementById('beanShipAlertText');
            var pendingBox = document.getElementById('beanShipPending');
            var option = document.getElementById('beanShipOption');
            var carrier = document.getElementById('beanShipCarrier');
            var eta = document.getElementById('beanShipEta');
            var price = document.getElementById('beanShipPrice');
            var note = document.getElementById('beanShipNote');
            var noteText = document.getElementById('beanShipNoteText');
            var summaryShipping = document.getElementById('beanSummaryShipping');
            var summaryTotal = document.getElementById('beanSummaryTotal');
            var requiresCity = @(requiresCity ? "true" : "false");
            var citiesUrl = '@Url.Action("Cities", "Cart")';
            var quoteUrl = '@Url.Action("QuoteShipping", "Cart")';
            var fallbackShipping = '$@shipping.ToString("#,##0", co)';
            var fallbackTotal = '$@grandTotal.ToString("#,##0", co)';

            if (!form || !department || !city || !button || !label) return;

            function show(element, visible) {
                if (element) element.classList.toggle('hidden', !visible);
            }

            function token() {
                var tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
                return tokenInput ? tokenInput.value : '';
            }

            function showAlert(message) {
                if (alertText) alertText.textContent = message;
                show(alertBox, true);
                show(pendingBox, false);
                show(option, false);
                show(note, false);
            }

            function block(message, buttonText) {
                showAlert(message);
                if (summaryShipping) summaryShipping.textContent = '—';
                if (summaryTotal) summaryTotal.textContent = '—';
                button.disabled = true;
                label.textContent = buttonText || 'No disponible para este destino';
            }

            function pending() {
                show(alertBox, false);
                show(pendingBox, true);
                show(option, false);
                show(note, false);
                if (summaryShipping) summaryShipping.textContent = '—';
                if (summaryTotal) summaryTotal.textContent = '—';
                button.disabled = true;
                label.textContent = 'Elige tu ciudad para continuar';
            }

            function loading() {
                show(alertBox, false);
                show(pendingBox, false);
                show(note, false);
                show(option, true);
                if (carrier) carrier.textContent = 'Calculando envío…';
                if (eta) eta.textContent = '';
                if (price) price.textContent = '…';
                if (summaryShipping) summaryShipping.textContent = '…';
                button.disabled = true;
                label.textContent = 'Calculando envío…';
            }

            function render(data) {
                if (!data || data.canCheckout !== true) {
                    block((data && data.message) || 'No pudimos calcular el envío a ese destino.');
                    return;
                }

                show(alertBox, false);
                show(pendingBox, false);
                show(option, true);
                if (carrier) carrier.textContent = data.carrier || 'Envío estándar';
                if (eta) eta.textContent = data.days ? 'Entrega estimada en ' + data.days + ' días hábiles' : 'Entrega estimada en días hábiles';
                if (price) price.textContent = '$' + data.shippingText;

                if (data.status === 'Fallback') {
                    if (noteText) noteText.textContent = data.message || 'No pudimos cotizar con la transportadora; se aplica una tarifa estándar.';
                    show(note, true);
                } else {
                    show(note, false);
                }

                if (summaryShipping) summaryShipping.textContent = '$' + data.shippingText;
                if (summaryTotal) summaryTotal.textContent = '$' + data.grandTotalText;
                button.disabled = false;
                label.textContent = 'Pagar $' + data.grandTotalText + ' COP';
            }

            function syncCityName() {
                var selectedOption = city.options[city.selectedIndex];
                if (cityName) cityName.value = city.value && selectedOption ? selectedOption.textContent : '';
            }

            async function quote() {
                syncCityName();
                var dane = city.value;
                if (!dane) {
                    if (requiresCity) pending();
                    return;
                }

                if (requiresCity) loading();

                try {
                    var body = new URLSearchParams({
                        daneCode: dane,
                        __RequestVerificationToken: token()
                    });
                    var response = await fetch(quoteUrl, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                            'RequestVerificationToken': token()
                        },
                        body: body.toString()
                    });
                    if (!response.ok) throw new Error('Shipping quote failed');
                    render(await response.json());
                } catch (error) {
                    show(alertBox, false);
                    show(pendingBox, false);
                    show(option, true);
                    if (carrier) carrier.textContent = 'Envío estándar';
                    if (eta) eta.textContent = 'Entrega estimada en días hábiles';
                    if (price) price.textContent = fallbackShipping;
                    if (noteText) noteText.textContent = 'No pudimos cotizar con la transportadora; se aplica una tarifa estándar.';
                    show(note, true);
                    if (summaryShipping) summaryShipping.textContent = fallbackShipping;
                    if (summaryTotal) summaryTotal.textContent = fallbackTotal;
                    button.disabled = false;
                    label.textContent = 'Pagar ' + fallbackTotal + ' COP';
                }
            }

            async function loadCities(departmentName, preselect) {
                city.replaceChildren(new Option(departmentName ? 'Cargando ciudades…' : 'Elige primero el departamento', ''));
                city.disabled = true;

                if (!departmentName) {
                    quote();
                    return;
                }

                try {
                    var response = await fetch(citiesUrl + '?' + new URLSearchParams({ department: departmentName }), { credentials: 'same-origin' });
                    if (!response.ok) throw new Error('Cities request failed');
                    var data = await response.json();
                    city.replaceChildren(new Option('Selecciona tu ciudad', ''));
                    data.forEach(function (item) {
                        city.add(new Option(item.name, item.dane));
                    });
                    city.disabled = false;
                    if (preselect) city.value = preselect;
                    quote();
                } catch (error) {
                    city.replaceChildren(new Option('No pudimos cargar las ciudades', ''));
                }
            }

            department.addEventListener('change', function () { loadCities(department.value, null); });
            city.addEventListener('change', quote);
            form.addEventListener('submit', function (event) {
                if (!city.value) {
                    event.preventDefault();
                    showAlert('Selecciona el departamento y la ciudad de destino para calcular el envío.');
                    city.focus();
                }
            });

            syncCityName();
        })();

        (function () {
            var form = document.getElementById('beanCheckoutForm');
            var input = document.getElementById('phone');
            var hint = document.getElementById('phoneHint');
            if (!form || !input) return;

            var helpText = hint ? hint.textContent : '';

            function digits(value) {
                return (value || '').replace(/\D/g, '');
            }

            function valid() {
                var value = digits(input.value);
                return value.length >= 7 && value.length <= 15;
            }

            function markError(message) {
                input.classList.add('border-clay', 'ring-2', 'ring-clay/20');
                input.setAttribute('aria-invalid', 'true');
                if (hint) {
                    hint.textContent = message;
                    hint.classList.add('text-clay-dark');
                }
            }

            function clearError() {
                input.classList.remove('border-clay', 'ring-2', 'ring-clay/20');
                input.removeAttribute('aria-invalid');
                if (hint) {
                    hint.textContent = helpText;
                    hint.classList.remove('text-clay-dark');
                }
            }

            input.addEventListener('input', function () {
                if (input.hasAttribute('aria-invalid') && valid()) clearError();
            });

            form.addEventListener('submit', function (event) {
                if (valid()) {
                    clearError();
                    return;
                }

                event.preventDefault();
                markError(input.value.trim() === ''
                    ? 'Escribe tu celular: la transportadora lo necesita para entregar.'
                    : 'Ese celular no parece válido (mínimo 7 dígitos).');
                input.focus();
            });
        })();

        (function () {
            var form = document.getElementById('beanCheckoutForm');
            var button = document.getElementById('beanPayBtn');
            var label = document.getElementById('beanPayLabel');
            if (!form || !button) return;

            form.addEventListener('submit', function (event) {
                if (event.defaultPrevented || button.disabled) return;
                button.disabled = true;
                if (label) label.textContent = 'Conectando con Wompi…';
            });
        })();
    </script>
}
