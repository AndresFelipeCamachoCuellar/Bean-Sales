@model List<Web.Models.ShoppingCartItem>

@{
    ViewData["Title"] = "Carrito de Compras";
    var co = new System.Globalization.CultureInfo("es-CO");
    var bolsas = Model.Sum(x => x.Quantity);
    var lotes = Model.Count;
    // Importes servidos por el controlador (fuente única del costo de envío).
    var envio = (decimal)ViewBag.Shipping;
    var granTotal = (decimal)ViewBag.GrandTotal;
}

<section class="bean-cart">
    <div class="bean-container">
        @if (!Model.Any())
        {
            <div class="bean-empty">
                <div class="ico"><i class="fas fa-shopping-basket"></i></div>
                <h3>Tu carrito está vacío</h3>
                <p>Aún no has agregado lotes. Explora nuestro catálogo de micro-lotes trazables.</p>
                <a asp-controller="Home" asp-action="Index" class="btn-bean">Explorar catálogo</a>
            </div>
        }
        else
        {
            <h1 class="bean-cart-title">Tu carrito <small>· @bolsas bolsas · @lotes lotes</small></h1>

            <div class="bean-cart-grid">
                <!-- ===== Lista de ítems ===== -->
                <div class="bean-cart-list">
                    @foreach (var item in Model)
                    {
                        <div class="bean-cart-item">
                            <div class="bean-cart-thumb bean-img o1" style="@(string.IsNullOrEmpty(item.Product?.ImageUrl) ? "" : $"background-image:url('{item.Product.ImageUrl}');background-size:cover;background-position:center;")"></div>
                            <div class="bean-cart-item-info">
                                <h3 class="bean-cart-item-name">
                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@item.ProductID">@item.Product?.Name</a>
                                </h3>
                                <div class="bean-cart-item-meta">@item.Product?.Provider?.Name · 340 g</div>
                            </div>

                            <form asp-action="UpdateQuantity" asp-route-id="@item.ShoppingCartItemID" method="post">
                                <div class="bean-stepper">
                                    <button class="minus" type="button" onclick="this.parentNode.querySelector('input[type=number]').stepDown(); this.form.submit();">−</button>
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" onchange="this.form.submit()">
                                    <button class="plus" type="button" onclick="this.parentNode.querySelector('input[type=number]').stepUp(); this.form.submit();">+</button>
                                </div>
                            </form>

                            <div class="bean-cart-item-sub">$@((item.Quantity * (item.Product?.Price ?? 0)).ToString("#,##0", co))</div>

                            <form asp-action="Remove" asp-route-id="@item.ShoppingCartItemID" method="post">
                                <button type="submit" class="bean-cart-remove" title="Eliminar"><i class="fas fa-trash-alt"></i></button>
                            </form>
                        </div>
                    }
                    <div class="bean-cart-continue">
                        <a asp-controller="Home" asp-action="Index">← Seguir comprando</a>
                    </div>
                </div>

                <!-- ===== Resumen ===== -->
                <aside class="bean-summary">
                    <h3>Resumen del pedido</h3>
                    <div class="bean-summary-row"><span>Subtotal</span><span class="val">$@(((decimal)ViewBag.Total).ToString("#,##0", co))</span></div>
                    <div class="bean-summary-row"><span>Envío a Colombia</span><span class="val">$@envio.ToString("#,##0", co)</span></div>
                    <div class="bean-summary-row"><span>Impuestos</span><span class="val">Incluidos</span></div>
                    <div class="bean-summary-sep"></div>
                    <div class="bean-summary-total">
                        <span class="lbl">Total</span>
                        <span class="amt">$@(granTotal.ToString("#,##0", co)) <small>COP</small></span>
                    </div>
                    <a asp-action="Checkout" class="btn-bean btn-bean-block">Proceder al pago →</a>
                    <div class="bean-secure-note">🔒 Pago seguro · Visa · Mastercard · PayPal · PSE</div>
                </aside>
            </div>
        }
    </div>
</section>
