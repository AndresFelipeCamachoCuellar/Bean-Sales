@model List<Web.Models.ShoppingCartItem>

@{
    ViewData["Title"] = "Carrito de Compras";
}

<div class="container py-5">
    <h1 class="mb-4">Tu Carrito de Compras</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <h4><i class="fas fa-shopping-basket me-2"></i> Tu carrito está vacío</h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Ir al Catálogo</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="border-0">Producto</th>
                                        <th class="border-0">Precio</th>
                                        <th class="border-0">Cantidad</th>
                                        <th class="border-0">Total</th>
                                        <th class="border-0"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="align-middle">
                                                <div class="d-flex align-items-center">
                                                     @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                                    {
                                                        <img src="@item.Product.ImageUrl" alt="" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                                    }
                                                    <div>
                                                        <h6 class="mb-0"><a asp-controller="Home" asp-action="Details" asp-route-id="@item.ProductID" class="text-dark">@item.Product?.Name</a></h6>
                                                        <small class="text-muted">@item.Product?.Provider?.Name</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="align-middle">@item.Product?.Price.ToString("C")</td>
                                            <td class="align-middle">
                                                <form asp-action="UpdateQuantity" asp-route-id="@item.ShoppingCartItemID" method="post" class="d-flex align-items-center">
                                                    <div class="input-group input-group-sm" style="width: 120px;">
                                                        <button class="btn btn-outline-secondary" type="button" onclick="this.parentNode.querySelector('input[type=number]').stepDown(); this.form.submit();">-</button>
                                                        <input type="number" name="quantity" class="form-control text-center" value="@item.Quantity" min="1" onchange="this.form.submit()">
                                                        <button class="btn btn-outline-secondary" type="button" onclick="this.parentNode.querySelector('input[type=number]').stepUp(); this.form.submit();">+</button>
                                                    </div>
                                                </form>
                                            </td>
                                            <td class="align-middle font-weight-bold">
                                                @((item.Quantity * (item.Product?.Price ?? 0)).ToString("C"))
                                            </td>
                                            <td class="align-middle text-end">
                                                <form asp-action="Remove" asp-route-id="@item.ShoppingCartItemID" method="post">
                                                    <button type="submit" class="btn btn-link text-danger p-0">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Resumen del Pedido</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span>@ViewBag.Total.ToString("C")</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <strong class="h5">Total</strong>
                            <strong class="h5 text-success">@ViewBag.Total.ToString("C")</strong>
                        </div>
                        
                        <a asp-action="Checkout" class="btn btn-success w-100 btn-lg rounded-pill">
                            Proceder al Pago <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2 rounded-pill">
                            Seguir Comprando
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
