@model Web.Services.Payments.PaymentCheckoutRequest

@{
    ViewData["Title"] = "Redirigiendo al pago seguro";
    Layout = "_LayoutHome";
    var co = new System.Globalization.CultureInfo("es-CO");
    var pedidoCorto = Model.OrderID.ToString("N").Substring(0, 8).ToUpperInvariant();
}

@*
    Puente hacia el Web Checkout de Wompi.

    Es el <form action="https://checkout.wompi.co/p/" method="GET"> LITERAL de la
    documentación: así se evita la incógnita de cómo codificar el parámetro
    "signature:integrity" en una URL construida a mano.

    Aquí NO hay ningún secreto: solo viajan la llave PÚBLICA, la referencia, el monto,
    la moneda, la expiración y el hash ya calculado en el servidor. Si alguien edita el
    monto desde DevTools, la firma deja de cuadrar y Wompi rechaza la transacción: ése
    es exactamente el propósito de la firma de integridad.
*@

<section class="relative isolate min-h-[72svh] overflow-hidden bg-ink px-4 py-12 text-white sm:px-6 sm:py-16 lg:px-10 lg:py-24">
    <svg class="pointer-events-none absolute inset-0 -z-10 h-full w-full text-clay-light/10" viewBox="0 0 1440 760" fill="none" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-120 118C215-48 478 226 814 95s566-62 790 48M-156 342C178 164 493 464 838 292s573-88 808 52M-128 586C222 376 522 708 884 528s575-91 791 39" stroke="currentColor" stroke-width="2" />
    </svg>

    <div class="mx-auto grid max-w-[90rem] gap-8 lg:grid-cols-12 lg:items-stretch">
        <div class="flex min-h-[24rem] flex-col justify-between border border-white/15 bg-roast p-6 sm:p-9 lg:col-span-7 lg:min-h-[34rem] lg:p-12">
            <div class="flex items-center justify-between gap-4 border-b border-white/15 pb-5">
                <span class="font-data text-[10px] font-semibold uppercase tracking-[0.18em] text-clay-light">Pago seguro</span>
                <span class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-husk">Pedido #@pedidoCorto</span>
            </div>

            <div class="py-12 sm:py-16">
                <div class="flex items-center gap-4" role="status" aria-live="polite">
                    <svg class="size-10 animate-spin text-clay-light motion-reduce:animate-none sm:size-12" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                        <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="2" opacity=".2" />
                        <path d="M24 4a20 20 0 0 1 20 20" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                    </svg>
                    <span class="font-data text-[10px] font-semibold uppercase tracking-[0.16em] text-husk">Conexión cifrada</span>
                </div>
                <h1 class="mt-8 max-w-4xl text-balance font-display text-4xl leading-[0.92] tracking-[-0.04em] sm:text-5xl lg:text-6xl">Te llevamos a completar el pago.</h1>
                <p class="mt-6 max-w-2xl text-base leading-7 text-husk">
                    Wompi, de Bancolombia, procesará <strong class="font-extrabold text-white">$@Model.AmountInPesos.ToString("#,##0", co) @Model.Currency</strong>.
                    No cierres esta ventana mientras establecemos la conexión.
                </p>
            </div>

            <div class="grid gap-px bg-white/15 sm:grid-cols-3">
                <div class="bg-roast px-4 py-4">
                    <p class="font-data text-[10px] font-semibold uppercase tracking-[0.15em] text-husk">Destino</p>
                    <p class="mt-2 text-sm font-extrabold">Wompi</p>
                </div>
                <div class="bg-roast px-4 py-4">
                    <p class="font-data text-[10px] font-semibold uppercase tracking-[0.15em] text-husk">Moneda</p>
                    <p class="mt-2 text-sm font-extrabold">@Model.Currency</p>
                </div>
                <div class="bg-roast px-4 py-4">
                    <p class="font-data text-[10px] font-semibold uppercase tracking-[0.15em] text-husk">Protección</p>
                    <p class="mt-2 text-sm font-extrabold">Integridad firmada</p>
                </div>
            </div>
        </div>

        <aside class="flex flex-col justify-between bg-cream p-6 text-ink shadow-lift sm:p-9 lg:col-span-5 lg:p-10" aria-labelledby="payment-fallback-title">
            <div>
                <div class="grid size-14 place-items-center bg-clay text-white">
                    <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="10" width="14" height="10" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v2" /></svg>
                </div>
                <h2 id="payment-fallback-title" class="mt-7 text-2xl font-extrabold tracking-[-0.035em]">Si no avanzas automáticamente</h2>
                <p class="mt-4 text-sm leading-6 text-ink/60">Usa el botón para abrir la pasarela. Permanecerá disponible si el navegador regresa a esta pantalla.</p>

                <form id="beanWompiForm" action="@Model.CheckoutUrl" method="GET" class="mt-8">
                    <!-- OBLIGATORIOS -->
                    <input type="hidden" name="public-key" value="@Model.PublicKey" />
                    <input type="hidden" name="currency" value="@Model.Currency" />
                    <input type="hidden" name="amount-in-cents" value="@Model.AmountInCents" />
                    <input type="hidden" name="reference" value="@Model.Reference" />
                    <input type="hidden" name="signature:integrity" value="@Model.IntegritySignature" />

                    <!-- OPCIONALES -->
                    <input type="hidden" name="redirect-url" value="@Model.RedirectUrl" />
                    @if (!string.IsNullOrWhiteSpace(Model.ExpirationTimeIso))
                    {
                        <input type="hidden" name="expiration-time" value="@Model.ExpirationTimeIso" />
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                    {
                        <input type="hidden" name="customer-data:email" value="@Model.CustomerEmail" />
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CustomerFullName))
                    {
                        <input type="hidden" name="customer-data:full-name" value="@Model.CustomerFullName" />
                    }
                    @if (Model.CanSendCustomerPhone)
                    {
                        <input type="hidden" name="customer-data:phone-number" value="@Model.CustomerPhone" />
                        <input type="hidden" name="customer-data:phone-number-prefix" value="@Model.CustomerPhonePrefix" />
                    }

                    @*
                        shipping-address es TODO-O-NADA: Wompi exige address-line-1, city, region,
                        country Y phone-number en cuanto se manda uno de ellos. Si falta alguno se
                        omite el bloque completo (es opcional) en vez de arriesgar un rechazo del
                        tipo "Parámetro «shipping-address:phone-number» no proveído".
                    *@
                    @if (Model.CanSendShippingAddress)
                    {
                        <input type="hidden" name="shipping-address:address-line-1" value="@Model.ShippingAddressLine1" />
                        <input type="hidden" name="shipping-address:city" value="@Model.ShippingCity" />
                        <input type="hidden" name="shipping-address:region" value="@Model.ShippingRegion" />
                        <input type="hidden" name="shipping-address:country" value="@Model.ShippingCountry" />
                        <input type="hidden" name="shipping-address:phone-number" value="@Model.ShippingPhone" />
                        @if (!string.IsNullOrWhiteSpace(Model.ShippingName))
                        {
                            <input type="hidden" name="shipping-address:name" value="@Model.ShippingName" />
                        }
                    }

                    <button type="submit" id="beanWompiBtn" class="inline-flex min-h-13 w-full cursor-pointer items-center justify-center gap-3 bg-clay px-6 py-4 text-sm font-extrabold text-white transition-colors hover:bg-clay-light focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-4 focus-visible:ring-offset-cream disabled:cursor-wait disabled:bg-clay/60">
                        Continuar al pago seguro
                    </button>
                </form>

                @* Salidas siempre visibles: el cliente nunca queda encerrado en el puente. *@
                <nav class="mt-7 grid border-t border-ink/15 text-sm font-bold" aria-label="Opciones del pedido">
                    <a asp-controller="Cart" asp-action="Checkout" class="flex min-h-11 cursor-pointer items-center justify-between border-b border-ink/15 py-3 transition-colors hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">
                        Volver al checkout
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" /></svg>
                    </a>
                    <a asp-controller="Cart" asp-action="Confirmation" asp-route-id="@Model.OrderID" class="flex min-h-11 cursor-pointer items-center justify-between border-b border-ink/15 py-3 transition-colors hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">
                        Ver este pedido
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                    </a>
                    <a asp-controller="Orders" asp-action="Index" class="flex min-h-11 cursor-pointer items-center justify-between py-3 transition-colors hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">
                        Ver mis pedidos
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                    </a>
                </nav>
            </div>

            <p class="mt-9 flex items-start gap-3 border-t border-ink/15 pt-5 text-xs font-semibold leading-5 text-ink/55">
                <svg class="mt-0.5 size-4 shrink-0 text-leaf" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6l-7-3Z" /><path d="m9 12 2 2 4-4" /></svg>
                <span>Wompi procesa el cobro. Tus datos de tarjeta nunca pasan por Bean y tus lotes permanecen reservados mientras completas el pago.</span>
            </p>
        </aside>
    </div>
</section>

@section Scripts {
    <script>
        // Auto-submit: el botón queda como respaldo si el navegador no ejecuta JS.
        // El botón se rearma si la salida falla o el cliente vuelve por historial.
        (function () {
            var form = document.getElementById('beanWompiForm');
            var btn = document.getElementById('beanWompiBtn');
            if (!form) { return; }

            var etiquetaOriginal = btn ? btn.textContent.trim() : '';
            var rearmar = null;

            function liberar() {
                if (rearmar) { clearTimeout(rearmar); rearmar = null; }
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = etiquetaOriginal;
                }
            }

            function saliendo() {
                if (!btn) { return; }
                btn.disabled = true;
                btn.textContent = 'Conectando con Wompi…';
                if (rearmar) { clearTimeout(rearmar); }
                rearmar = setTimeout(liberar, 3000);
            }

            form.addEventListener('submit', saliendo);
            window.addEventListener('pageshow', liberar);
            window.addEventListener('popstate', liberar);

            var auto = setTimeout(function () {
                saliendo();
                form.submit();
            }, 400);

            if (btn) {
                btn.addEventListener('click', function () { clearTimeout(auto); });
            }
        })();
    </script>
}
