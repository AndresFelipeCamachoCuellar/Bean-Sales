@model Web.Models.ViewModels.RoleViewModel

@{
    ViewData["Title"] = "Editar Rol (Empresa)";
    Layout = "_Layout";
}

<div class="bean-panel-head">
    <div>
        <h1 class="bean-panel-title">Editar rol</h1>
        <p class="bean-panel-sub">Actualiza el nombre y la descripción del rol.</p>
    </div>
</div>

<div class="bean-form-card narrow">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="bean-form-summary"></div>
        <input type="hidden" asp-for="Id" />

        <div class="bean-field">
            <label asp-for="Name" class="bean-label"></label>
            <input asp-for="Name" class="bean-input" />
            <span asp-validation-for="Name" class="bean-form-error"></span>
        </div>

        <div class="bean-field" style="margin-top:16px;">
            <label asp-for="Description" class="bean-label"></label>
            <textarea asp-for="Description" class="bean-input" rows="3"></textarea>
            <span asp-validation-for="Description" class="bean-form-error"></span>
        </div>

        <div class="bean-form-actions">
            <a asp-action="Index" class="bean-btn-pill outline">Cancelar</a>
            <button type="submit" class="bean-btn-pill primary"><i class="fas fa-save"></i> Actualizar</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
