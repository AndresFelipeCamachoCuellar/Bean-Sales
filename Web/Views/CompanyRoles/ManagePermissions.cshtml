@model Web.Models.ViewModels.ManagePermissionsViewModel

@{
    ViewData["Title"] = "Gestionar Permisos (Empresa)";
    Layout = "_LayoutAdminTailwind";
}

<div class="flex flex-col gap-6 border-b border-ink/15 pb-7 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-3xl">
        <h1 class="font-display text-3xl leading-none tracking-[-0.04em] text-ink sm:text-4xl">Permisos de @Model.RoleName</h1>
        <p class="mt-3 text-sm leading-6 text-ink/65 sm:text-base">Activa o desactiva los permisos granulares por módulo para este rol.</p>
    </div>
    <a asp-action="Index" class="inline-flex min-h-11 shrink-0 cursor-pointer items-center justify-center gap-2 border border-ink/25 px-5 py-3 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        Volver
    </a>
</div>

<div class="mt-6">
    <form asp-action="ManagePermissions" method="post">
        <div asp-validation-summary="ModelOnly" class="mb-6 hidden border border-clay bg-clay/10 p-4 text-sm font-semibold leading-6 text-clay-dark [&.validation-summary-errors]:block [&_ul]:space-y-1" role="alert" aria-live="assertive"></div>
        <input type="hidden" asp-for="RoleId" />

        <div class="grid gap-4 lg:grid-cols-2">
            @for (int i = 0; i < Model.Modules.Count; i++)
            {
                <section class="border border-ink/15 bg-white" aria-labelledby="@($"module_{i}_title")">
                    <div class="flex items-center justify-between gap-4 border-b border-ink/15 bg-ink px-5 py-4 text-white">
                        <h2 id="@($"module_{i}_title")" class="text-sm font-extrabold">@Model.Modules[i].ModuleName</h2>
                        <span class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-husk">@Model.Modules[i].Permissions.Count permisos</span>
                    </div>

                    <input type="hidden" asp-for="@Model.Modules[i].ModuleName" />
                    <input type="hidden" asp-for="@Model.Modules[i].ModuleCode" />

                    <div class="divide-y divide-ink/10">
                        @for (int j = 0; j < Model.Modules[i].Permissions.Count; j++)
                        {
                            <div class="relative">
                                <input type="hidden" asp-for="@Model.Modules[i].Permissions[j].ParametricPermissionID" />
                                <input type="hidden" asp-for="@Model.Modules[i].Permissions[j].PermissionName" />
                                <input type="checkbox" asp-for="@Model.Modules[i].Permissions[j].Selected" id="@($"perm_{i}_{j}")" class="peer absolute left-5 top-5 size-5 cursor-pointer accent-clay focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2" />
                                <label for="@($"perm_{i}_{j}")" class="block min-h-20 cursor-pointer py-4 pl-14 pr-5 transition-colors hover:bg-cream/75 peer-checked:bg-clay/5">
                                    <span class="block text-sm font-extrabold text-ink">@Model.Modules[i].Permissions[j].PermissionName</span>
                                    <span class="mt-1 block text-xs leading-5 text-ink/60">@Model.Modules[i].Permissions[j].Description</span>
                                </label>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>

        <div class="sticky bottom-0 mt-6 flex flex-col-reverse gap-3 border border-ink/15 bg-cream/95 p-4 shadow-lift sm:flex-row sm:justify-end">
            <a asp-action="Index" class="inline-flex min-h-11 cursor-pointer items-center justify-center border border-ink/25 bg-cream px-5 py-3 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">Cancelar</a>
            <button type="submit" class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 bg-clay px-5 py-3 text-sm font-extrabold text-white transition-colors hover:bg-clay-light focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h12l2 2v14H5V4Z" /><path d="M8 4v6h8V4M8 20v-6h8v6" /></svg>
                Guardar permisos
            </button>
        </div>
    </form>
</div>
