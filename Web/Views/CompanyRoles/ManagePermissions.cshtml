@model Web.Models.ViewModels.ManagePermissionsViewModel

@{
    ViewData["Title"] = "Gestionar Permisos (Empresa)";
    Layout = "_Layout";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Permisos para: @Model.RoleName</h1>

    <form asp-action="ManagePermissions" method="post">
        <input type="hidden" asp-for="RoleId" />

        <div class="row">
            @for (int i = 0; i < Model.Modules.Count; i++)
            {
                <div class="col-xl-6 col-md-6 mb-4">
                    <div class="card shadow h-100 py-2">
                        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                            <h6 class="m-0 font-weight-bold text-primary">@Model.Modules[i].ModuleName</h6>
                        </div>
                        <div class="card-body">
                            <input type="hidden" asp-for="@Model.Modules[i].ModuleName" />
                            <input type="hidden" asp-for="@Model.Modules[i].ModuleCode" />
                            
                             @for (int j = 0; j < Model.Modules[i].Permissions.Count; j++)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="@Model.Modules[i].Permissions[j].Selected" />
                                    <label class="form-check-label" asp-for="@Model.Modules[i].Permissions[j].Selected">
                                        @Model.Modules[i].Permissions[j].PermissionName - <small class="text-muted">@Model.Modules[i].Permissions[j].Description</small>
                                    </label>
                                    <input type="hidden" asp-for="@Model.Modules[i].Permissions[j].ParametricPermissionID" />
                                    <input type="hidden" asp-for="@Model.Modules[i].Permissions[j].PermissionName" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="form-group mt-3">
             <button type="submit" class="btn btn-success btn-lg"><i class="fas fa-save me-1"></i> Guardar Permisos</button>
             <a asp-action="Index" class="btn btn-secondary btn-lg">Cancelar</a>
        </div>
    </form>
</div>
