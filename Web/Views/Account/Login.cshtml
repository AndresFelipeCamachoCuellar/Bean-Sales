@using Web.Models.ViewModels
@model LoginViewModel

@{
    Layout = "_LayoutAuthTailwind";
    ViewData["Title"] = "Entrar";
}

<nav class="grid grid-cols-2 border border-ink/20" aria-label="Opciones de acceso">
    <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" aria-current="page" class="flex min-h-12 cursor-pointer items-center justify-center bg-ink px-4 text-sm font-extrabold text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-inset">Entrar</a>
    <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="flex min-h-12 cursor-pointer items-center justify-center bg-white px-4 text-sm font-extrabold text-ink transition-colors hover:bg-oat focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-inset">Crear cuenta</a>
</nav>

<h1 class="mt-10 text-balance font-display text-4xl leading-[0.95] tracking-[-0.04em] sm:text-5xl">Inicia sesión</h1>
<p class="mt-4 text-base leading-7 text-ink/65">Accede a tus lotes, pedidos y envíos.</p>

<form id="account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="mt-8" novalidate>
    <div asp-validation-summary="ModelOnly" class="mb-6 hidden border border-clay bg-clay/10 p-4 text-sm font-semibold leading-6 text-clay-dark [&.validation-summary-errors]:block [&_ul]:space-y-1" role="alert" aria-live="polite"></div>

    <div>
        <label asp-for="Email" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/70">Correo electrónico</label>
        <input asp-for="Email" class="mt-2 min-h-13 w-full border border-ink/25 bg-white px-4 py-3 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/55 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" autocomplete="username" aria-required="true" placeholder="nombre@correo.com" />
        <span asp-validation-for="Email" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
    </div>

    <div class="mt-5">
        <label asp-for="Password" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/70">Contraseña</label>
        <input asp-for="Password" class="mt-2 min-h-13 w-full border border-ink/25 bg-white px-4 py-3 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/55 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" autocomplete="current-password" aria-required="true" placeholder="Tu contraseña" />
        <span asp-validation-for="Password" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
    </div>

    <div class="mt-5">
        <label class="inline-flex min-h-11 cursor-pointer items-center gap-3 text-sm font-semibold text-ink/75">
            <input asp-for="RememberMe" class="size-4 cursor-pointer rounded-none border-ink/30 text-clay accent-clay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream" />
            <span>Mantener sesión iniciada</span>
        </label>
    </div>

    <button id="login-submit" type="submit" class="mt-6 inline-flex min-h-13 w-full cursor-pointer items-center justify-center gap-3 bg-clay px-7 py-4 text-sm font-extrabold text-white transition-colors hover:bg-clay-light focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-4 focus-visible:ring-offset-cream">
        Entrar
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
    </button>
</form>

<div class="my-9 flex items-center gap-4 text-center font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/55 before:h-px before:flex-1 before:bg-ink/15 after:h-px after:flex-1 after:bg-ink/15">¿Compras para tu negocio?</div>

<a asp-action="RegisterProvider" class="group flex min-h-24 cursor-pointer items-center gap-4 border border-ink/20 bg-white p-4 transition-colors hover:border-clay hover:bg-oat/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-4 focus-visible:ring-offset-cream sm:p-5">
    <span class="grid size-11 shrink-0 place-items-center bg-ink text-clay-light" aria-hidden="true">
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20V9l8-5 8 5v11H4Z" /><path d="M8 20v-6h8v6M7.5 10h.01M12 10h.01M16.5 10h.01" /></svg>
    </span>
    <span class="min-w-0 flex-1">
        <strong class="block text-sm font-extrabold text-ink">Registra tu empresa</strong>
        <span class="mt-1 block text-xs leading-5 text-ink/60">Precios de mayoreo, cupo mensual y facturación.</span>
    </span>
    <svg class="size-5 shrink-0 text-clay transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
</a>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
