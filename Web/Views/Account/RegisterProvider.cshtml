@model Web.Models.ViewModels.RegisterProviderViewModel
@{
    ViewData["Title"] = "Onboarding de empresa";
    ViewData["AuthWide"] = "wide";
}

@section AuthAside {
    <div class="bean-auth-panel-top">
        <a class="bean-brand" asp-controller="Home" asp-action="Index"><span class="bean-drop"></span> Bean</a>
        <span class="bean-auth-badge-emp">Empresas</span>
    </div>
    <div class="bean-auth-panel-body">
        <ol class="bean-auth-stepper">
            <li class="bean-auth-step done">
                <span class="bean-auth-step-dot">✓</span>
                <span class="bean-auth-step-txt"><strong>Datos de la empresa</strong><small>Razón social, NIT y país</small></span>
            </li>
            <li class="bean-auth-step active">
                <span class="bean-auth-step-dot">2</span>
                <span class="bean-auth-step-txt"><strong>Tipo de cuenta</strong><small>¿Compras al por mayor o vendes tu café?</small></span>
            </li>
            <li class="bean-auth-step">
                <span class="bean-auth-step-dot">3</span>
                <span class="bean-auth-step-txt"><strong>Verificación</strong><small>Revisamos tus documentos en 1 día hábil</small></span>
            </li>
        </ol>
        <div class="bean-auth-quote">
            <p>"Registramos la cafetería en 10 minutos y el primer pedido de mayoreo llegó esa misma semana."</p>
            <cite>Café Norte · Toronto</cite>
        </div>
    </div>
}

<div class="bean-auth-step-eyebrow">Paso 2 de 3</div>
<h1 class="bean-auth-title">Registra tu empresa</h1>
<p class="bean-auth-sub">¿Cómo usará Bean tu empresa? Esto define tu panel, precios y verificación. Verificación de documentos: 1 día hábil.</p>

@* Radio-cards VISUALES (no corresponden a ningún campo del modelo — no se envían en el POST) *@
<div id="bean-account-type" aria-hidden="true">
    <div class="bean-auth-radiocard selected" data-account-type="wholesale">
        <span class="ico">🏪</span>
        <span class="txt"><strong>Comprar al por mayor</strong><span>Cafeterías, restaurantes y tiendas. Precios por volumen y cupo mensual.</span></span>
        <span class="dot"></span>
    </div>
    <div class="bean-auth-radiocard" data-account-type="sell">
        <span class="ico">🌱</span>
        <span class="txt"><strong>Vender mi café</strong><span>Fincas y cooperativas. Publica lotes, define precios por país y recibe pago directo.</span></span>
        <span class="dot"></span>
    </div>
</div>

<form asp-action="RegisterProvider" method="post">
    <div asp-validation-summary="ModelOnly" class="bean-auth-validation"></div>

    <div class="bean-auth-section-h">Datos de la empresa</div>
    <div class="bean-auth-grid2">
        <div class="bean-auth-field">
            <label asp-for="CompanyName" class="bean-auth-label">Nombre de la empresa</label>
            <input asp-for="CompanyName" class="bean-auth-input" placeholder="Razón social" />
            <span asp-validation-for="CompanyName" class="text-danger"></span>
        </div>
        <div class="bean-auth-field">
            <label asp-for="NIT" class="bean-auth-label">NIT / Tax ID</label>
            <input asp-for="NIT" class="bean-auth-input" placeholder="NIT" />
            <span asp-validation-for="NIT" class="text-danger"></span>
        </div>
    </div>
    <div class="bean-auth-grid2">
        <div class="bean-auth-field">
            <label asp-for="CompanyEmail" class="bean-auth-label">Email corporativo</label>
            <input asp-for="CompanyEmail" class="bean-auth-input" placeholder="empresa@correo.com" />
            <span asp-validation-for="CompanyEmail" class="text-danger"></span>
        </div>
        <div class="bean-auth-field">
            <label asp-for="CompanyPhone" class="bean-auth-label">Teléfono</label>
            <input asp-for="CompanyPhone" class="bean-auth-input" placeholder="Teléfono" />
            <span asp-validation-for="CompanyPhone" class="text-danger"></span>
        </div>
    </div>
    <div class="bean-auth-field">
        <label asp-for="Address" class="bean-auth-label">Dirección</label>
        <input asp-for="Address" class="bean-auth-input" placeholder="Dirección" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="bean-auth-section-h">Datos del administrador</div>
    <div class="bean-auth-grid2">
        <div class="bean-auth-field">
            <label asp-for="FirstName" class="bean-auth-label">Nombre</label>
            <input asp-for="FirstName" class="bean-auth-input" placeholder="Nombre" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="bean-auth-field">
            <label asp-for="LastName" class="bean-auth-label">Apellido</label>
            <input asp-for="LastName" class="bean-auth-input" placeholder="Apellido" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
    </div>
    <div class="bean-auth-grid2">
        <div class="bean-auth-field">
            <label asp-for="DocumentTypeID" class="bean-auth-label">Tipo de documento</label>
            <select asp-for="DocumentTypeID" class="bean-auth-input" asp-items="Model.DocumentTypes">
                <option value="">-- Seleccione --</option>
            </select>
            <span asp-validation-for="DocumentTypeID" class="text-danger"></span>
        </div>
        <div class="bean-auth-field">
            <label asp-for="DocumentNumber" class="bean-auth-label">Número de documento</label>
            <input asp-for="DocumentNumber" class="bean-auth-input" placeholder="Número" />
            <span asp-validation-for="DocumentNumber" class="text-danger"></span>
        </div>
    </div>
    <div class="bean-auth-field">
        <label asp-for="UserEmail" class="bean-auth-label">Email del usuario (login)</label>
        <input asp-for="UserEmail" class="bean-auth-input" placeholder="admin@correo.com" />
        <span asp-validation-for="UserEmail" class="text-danger"></span>
        <div class="bean-auth-hint">Este correo será tu usuario para ingresar al sistema.</div>
    </div>
    <div class="bean-auth-grid2">
        <div class="bean-auth-field">
            <label asp-for="Password" class="bean-auth-label">Contraseña</label>
            <input asp-for="Password" class="bean-auth-input" placeholder="Mínimo 6 caracteres" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="bean-auth-field">
            <label asp-for="ConfirmPassword" class="bean-auth-label">Confirmar contraseña</label>
            <input asp-for="ConfirmPassword" class="bean-auth-input" placeholder="Repite la contraseña" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
    </div>

    <div class="bean-auth-actions">
        <a asp-action="Login" class="bean-auth-btn-outline">← Atrás</a>
        <button type="submit" class="bean-auth-cta">Continuar →</button>
    </div>
</form>

<p class="bean-auth-foot">¿Ya tienes cuenta? <a class="bean-auth-link" asp-action="Login">Inicia sesión</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Radio-cards de tipo de cuenta: selección puramente visual (no se envía en el POST).
        (function () {
            var group = document.getElementById('bean-account-type');
            if (!group) return;
            group.querySelectorAll('.bean-auth-radiocard').forEach(function (card) {
                card.addEventListener('click', function () {
                    group.querySelectorAll('.bean-auth-radiocard').forEach(function (c) { c.classList.remove('selected'); });
                    card.classList.add('selected');
                });
            });
        })();
    </script>
}
