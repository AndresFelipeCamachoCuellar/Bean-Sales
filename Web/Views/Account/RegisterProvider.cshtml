@model Web.Models.ViewModels.RegisterProviderViewModel
@{
    ViewData["Title"] = "Registro de Empresa";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-lg border-0 rounded-lg mt-5">
            <div class="card-header bg-primary text-white">
                <h3 class="font-weight-light my-2 text-center">Registro de Nueva Empresa</h3>
            </div>
            <div class="card-body">
                <form asp-action="RegisterProvider" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <h5 class="text-secondary mb-3"><i class="fas fa-building me-2"></i>Datos de la Empresa</h5>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating mb-3 mb-md-0">
                                <input asp-for="CompanyName" class="form-control" placeholder="Nombre de la Empresa" />
                                <label asp-for="CompanyName"></label>
                                <span asp-validation-for="CompanyName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="NIT" class="form-control" placeholder="NIT" />
                                <label asp-for="NIT"></label>
                                <span asp-validation-for="NIT" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating mb-3 mb-md-0">
                                <input asp-for="CompanyEmail" class="form-control" placeholder="Email Corporativo" />
                                <label asp-for="CompanyEmail"></label>
                                <span asp-validation-for="CompanyEmail" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="CompanyPhone" class="form-control" placeholder="Teléfono" />
                                <label asp-for="CompanyPhone"></label>
                                <span asp-validation-for="CompanyPhone" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Address" class="form-control" placeholder="Dirección" />
                        <label asp-for="Address"></label>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <hr />
                    
                    <h5 class="text-secondary mb-3"><i class="fas fa-user-tie me-2"></i>Datos del Administrador</h5>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating mb-3 mb-md-0">
                                <input asp-for="FirstName" class="form-control" placeholder="Nombre" />
                                <label asp-for="FirstName"></label>
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="LastName" class="form-control" placeholder="Apellido" />
                                <label asp-for="LastName"></label>
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                             <div class="form-floating mb-3 mb-md-0">
                                <select asp-for="DocumentTypeID" class="form-select" asp-items="Model.DocumentTypes">
                                    <option value="">-- Seleccione --</option>
                                </select>
                                <label asp-for="DocumentTypeID"></label>
                                <span asp-validation-for="DocumentTypeID" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="DocumentNumber" class="form-control" placeholder="Número Documento" />
                                <label asp-for="DocumentNumber"></label>
                                <span asp-validation-for="DocumentNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="UserEmail" class="form-control" placeholder="Email Usuario (Login)" />
                        <label asp-for="UserEmail"></label>
                        <span asp-validation-for="UserEmail" class="text-danger"></span>
                        <small class="text-muted">Este correo será su usuario para ingresar al sistema.</small>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating mb-3 mb-md-0">
                                <input asp-for="Password" class="form-control" placeholder="Contraseña" />
                                <label asp-for="Password"></label>
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3 mb-md-0">
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirmar" />
                                <label asp-for="ConfirmPassword"></label>
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 mb-0">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-block py-3">Registrar Empresa</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="card-footer text-center py-3">
                <div class="small"><a asp-action="Login">¿Ya tienes cuenta? Inicia Sesión</a></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
