@model Web.Models.ViewModels.RegisterProviderViewModel

@{
    Layout = "_LayoutAuthTailwind";
    ViewData["Title"] = "Registrar empresa";
    ViewData["AuthWide"] = "wide";
}

<div class="flex flex-col gap-4 border-b border-ink/20 pb-8 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="text-balance font-display text-4xl leading-[0.95] tracking-[-0.04em] sm:text-5xl">Registra tu empresa</h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-ink/65">Crea el perfil de la empresa y su usuario administrador. El acceso al panel quedará pendiente mientras Bean revisa la información.</p>
    </div>
    <a asp-action="Login" class="inline-flex min-h-11 shrink-0 cursor-pointer items-center gap-2 self-start text-sm font-extrabold text-clay-dark underline decoration-clay/40 underline-offset-4 transition-colors hover:text-clay focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream sm:self-auto">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        Volver a iniciar sesión
    </a>
</div>

<section class="mt-8" aria-labelledby="modalidades-title">
    <div class="flex items-start gap-4 border border-ink/20 bg-oat/45 p-5 sm:p-6">
        <span class="mt-1 hidden h-px w-10 shrink-0 bg-clay sm:block" aria-hidden="true"></span>
        <div>
            <h2 id="modalidades-title" class="text-sm font-extrabold text-ink">Un registro para operar con Bean</h2>
            <p class="mt-1 text-sm leading-6 text-ink/65">La plataforma reúne compras de mayoreo y publicación de lotes. Estas modalidades son informativas; no necesitas elegir una para enviar el registro.</p>
        </div>
    </div>

    @* Estas tarjetas son contexto visual. No representan campos del modelo ni envían datos. *@
    <div class="mt-3 grid gap-3 sm:grid-cols-2" aria-hidden="true">
        <div class="flex min-h-28 items-center gap-4 border border-ink/20 bg-white p-4 sm:p-5">
            <span class="grid size-11 shrink-0 place-items-center bg-ink text-clay-light">
                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20V9l8-5 8 5v11H4Z" /><path d="M8 20v-6h8v6M7.5 10h.01M12 10h.01M16.5 10h.01" /></svg>
            </span>
            <span class="min-w-0 flex-1">
                <strong class="block text-sm font-extrabold text-ink">Comprar al por mayor</strong>
                <span class="mt-1 block text-xs leading-5 text-ink/60">Para cafeterías, restaurantes y tiendas.</span>
            </span>
            <span class="grid size-5 shrink-0 place-items-center rounded-full border border-ink/30"><span class="size-2 rounded-full bg-clay"></span></span>
        </div>
        <div class="flex min-h-28 items-center gap-4 border border-ink/20 bg-white p-4 sm:p-5">
            <span class="grid size-11 shrink-0 place-items-center bg-clay-dark text-white">
                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 20V9" /><path d="M12 14c-5 0-7-3-7-7 4 0 7 2 7 7ZM12 11c0-4 3-7 7-7 0 4-2 7-7 7Z" /></svg>
            </span>
            <span class="min-w-0 flex-1">
                <strong class="block text-sm font-extrabold text-ink">Vender café</strong>
                <span class="mt-1 block text-xs leading-5 text-ink/60">Para fincas, marcas y cooperativas.</span>
            </span>
            <span class="size-5 shrink-0 rounded-full border border-ink/30"></span>
        </div>
    </div>
</section>

<form asp-action="RegisterProvider" method="post" asp-antiforgery="true" class="mt-10" novalidate>
    <div asp-validation-summary="ModelOnly" class="mb-6 hidden border border-clay bg-clay/10 p-4 text-sm font-semibold leading-6 text-clay-dark [&.validation-summary-errors]:block [&_ul]:space-y-1" role="alert" aria-live="polite"></div>

    <fieldset>
        <legend class="w-full border-b border-ink/20 pb-3 font-data text-[10px] font-semibold uppercase tracking-[0.16em] text-ink/70">Datos de la empresa</legend>

        <div class="mt-6 grid gap-x-5 gap-y-5 sm:grid-cols-2">
            <div>
                <label asp-for="CompanyName" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/70">Nombre de la empresa</label>
                <input asp-for="CompanyName" class="mt-2 min-h-13 w-full border border-ink/25 bg-white px-4 py-3 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/55 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" autocomplete="organization" aria-required="true" placeholder="Razón social" />
                <span asp-validation-for="CompanyName" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            <div>
                <label asp-for="NIT" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/70">NIT / Tax ID</label>
                <input asp-for="NIT" class="mt-2 min-h-13 w-full border border-ink/25 bg-white px-4 py-3 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/55 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" aria-required="true" placeholder="Número de identificación tributaria" />
                <span asp-validation-for="NIT" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            <div>
                <label asp-for="CompanyEmail" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/70">Correo corporativo</label>
                <input asp-for="CompanyEmail" class="mt-2 min-h-13 w-full border border-ink/25 bg-white px-4 py-3 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/55 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" autocomplete="email" aria-required="true" placeholder="empresa@correo.com" />
                <span asp-validation-for="CompanyEmail" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            <div>
                <label asp-for="CompanyPhone" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/70">Teléfono</label>
                <input asp-for="CompanyPhone" class="mt-2 min-h-13 w-full border border-ink/25 bg-white px-4 py-3 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/55 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" autocomplete="tel" placeholder="Teléfono de contacto" />
                <span asp-validation-for="CompanyPhone" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            <div class="sm:col-span-2">
                <label asp-for="Address" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/70">Dirección</label>
                <input asp-for="Address" class="mt-2 min-h-13 w-full border border-ink/25 bg-white px-4 py-3 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/55 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" autocomplete="street-address" placeholder="Dirección de la empresa" />
                <span asp-validation-for="Address" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
        </div>
    </fieldset>

    <fieldset class="mt-10">
        <legend class="w-full border-b border-ink/20 pb-3 font-data text-[10px] font-semibold uppercase tracking-[0.16em] text-ink/70">Usuario administrador</legend>
        <p class="mt-4 text-sm leading-6 text-ink/60">Esta persona administrará el perfil de la empresa y usará su correo para iniciar sesión cuando el acceso sea aprobado.</p>

        <div class="mt-6 grid gap-x-5 gap-y-5 sm:grid-cols-2">
            <div>
                <label asp-for="FirstName" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/70">Nombre</label>
                <input asp-for="FirstName" class="mt-2 min-h-13 w-full border border-ink/25 bg-white px-4 py-3 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/55 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" autocomplete="given-name" aria-required="true" placeholder="Nombre" />
                <span asp-validation-for="FirstName" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            <div>
                <label asp-for="LastName" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/70">Apellido</label>
                <input asp-for="LastName" class="mt-2 min-h-13 w-full border border-ink/25 bg-white px-4 py-3 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/55 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" autocomplete="family-name" aria-required="true" placeholder="Apellido" />
                <span asp-validation-for="LastName" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            <div>
                <label asp-for="DocumentTypeID" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/70">Tipo de documento</label>
                <select asp-for="DocumentTypeID" asp-items="Model.DocumentTypes" class="mt-2 min-h-13 w-full cursor-pointer border border-ink/25 bg-white px-4 py-3 text-base text-ink outline-none transition-colors hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" aria-required="true">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="DocumentTypeID" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            <div>
                <label asp-for="DocumentNumber" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/70">Número de documento</label>
                <input asp-for="DocumentNumber" class="mt-2 min-h-13 w-full border border-ink/25 bg-white px-4 py-3 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/55 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" aria-required="true" placeholder="Número" />
                <span asp-validation-for="DocumentNumber" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            <div class="sm:col-span-2">
                <label asp-for="UserEmail" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/70">Correo para iniciar sesión</label>
                <input asp-for="UserEmail" class="mt-2 min-h-13 w-full border border-ink/25 bg-white px-4 py-3 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/55 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" autocomplete="username" aria-required="true" placeholder="admin@correo.com" />
                <span asp-validation-for="UserEmail" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            <div>
                <label asp-for="Password" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/70">Contraseña</label>
                <input asp-for="Password" class="mt-2 min-h-13 w-full border border-ink/25 bg-white px-4 py-3 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/55 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" autocomplete="new-password" aria-required="true" placeholder="Mínimo 6 caracteres" />
                <span asp-validation-for="Password" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/70">Confirmar contraseña</label>
                <input asp-for="ConfirmPassword" class="mt-2 min-h-13 w-full border border-ink/25 bg-white px-4 py-3 text-base text-ink caret-clay outline-none transition-colors placeholder:text-ink/55 hover:border-ink/45 focus-visible:border-clay focus-visible:ring-2 focus-visible:ring-clay/25 [&.input-validation-error]:border-clay [&.input-validation-error]:bg-clay/5 [&.input-validation-error]:ring-1 [&.input-validation-error]:ring-clay" autocomplete="new-password" aria-required="true" placeholder="Repite la contraseña" />
                <span asp-validation-for="ConfirmPassword" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
        </div>
    </fieldset>

    <button type="submit" class="mt-8 inline-flex min-h-13 w-full cursor-pointer items-center justify-center gap-3 bg-clay px-7 py-4 text-sm font-extrabold text-white transition-colors hover:bg-clay-light focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-4 focus-visible:ring-offset-cream sm:w-auto sm:min-w-64">
        Enviar registro para revisión
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
    </button>
</form>

<p class="mt-8 border-t border-ink/15 pt-6 text-sm leading-6 text-ink/65">¿Ya tienes cuenta? <a asp-action="Login" class="cursor-pointer font-extrabold text-clay-dark underline decoration-clay/40 underline-offset-4 transition-colors hover:text-clay focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream">Inicia sesión</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
