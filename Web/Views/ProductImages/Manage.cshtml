@model Web.Models.ViewModels.ProductImageManagerViewModel
@using Web.Models.Enums
@{
    ViewData["Title"] = "Fotos del lote";
    Layout = "_LayoutAdminTailwind";
    var product = ViewBag.Product as Web.Models.Product;
    var backToApprovals = ViewBag.ReturnToApprovals is bool b && b;

    string StatusLabel(ProductStatus status) => status switch
    {
        ProductStatus.Draft => "Borrador",
        ProductStatus.PendingApproval => "Pendiente aprobación",
        ProductStatus.ApprovedToShip => "Esperando envío",
        ProductStatus.Shipped => "Enviado · por recibir",
        ProductStatus.Active => "Activo · en venta",
        ProductStatus.Rejected => "Rechazado",
        _ => status.ToString()
    };

    string StatusClass(ProductStatus status) => status switch
    {
        ProductStatus.Active => "bg-leaf/10 text-leaf",
        ProductStatus.PendingApproval => "bg-honey/15 text-ink",
        ProductStatus.ApprovedToShip => "bg-clay/10 text-clay-dark",
        ProductStatus.Shipped => "bg-ink/10 text-ink",
        ProductStatus.Rejected => "bg-clay/15 text-clay-dark",
        _ => "bg-oat text-ink/70"
    };
}

<header class="flex flex-col gap-6 border-b border-ink/15 pb-7 lg:flex-row lg:items-end lg:justify-between">
    <div class="min-w-0 max-w-3xl">
        <h1 class="font-display text-3xl leading-none tracking-[-0.04em] text-ink sm:text-4xl">Fotos del lote</h1>
        <p class="mt-3 truncate text-sm font-semibold leading-6 text-ink/60 sm:text-base">
            @Model.ProductName
            @if (product?.Provider is not null)
            {
                <text> · @product.Provider.Name</text>
            }
        </p>
    </div>
    @if (backToApprovals)
    {
        <a asp-controller="ProductApproval" asp-action="Index" class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 self-start border border-ink/20 bg-white px-5 py-3 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream lg:self-auto">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6" /></svg>
            Volver a aprobaciones
        </a>
    }
    else
    {
        <a asp-controller="Products" asp-action="Index" class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 self-start border border-ink/20 bg-white px-5 py-3 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream lg:self-auto">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6" /></svg>
            Volver a mis lotes
        </a>
    }
</header>

@if (product is not null)
{
    <dl class="mt-8 grid border border-ink/15 bg-white sm:grid-cols-2 xl:grid-cols-4">
        <div class="border-b border-oat p-4 sm:border-r xl:border-b-0"><dt class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/50">Producto</dt><dd class="mt-2 font-extrabold text-ink">@product.Name</dd></div>
        <div class="border-b border-oat p-4 xl:border-b-0 xl:border-r"><dt class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/50">Proveedor</dt><dd class="mt-2 font-semibold text-ink">@(product.Provider?.Name ?? "—")</dd></div>
        <div class="border-b border-oat p-4 sm:border-b-0 sm:border-r"><dt class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/50">Estado</dt><dd class="mt-2"><span class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 font-data text-[10px] font-semibold uppercase tracking-[0.08em] @(StatusClass(product.ProductStatus))"><span class="size-2 rounded-full bg-current" aria-hidden="true"></span>@StatusLabel(product.ProductStatus)</span></dd></div>
        <div class="p-4"><dt class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/50">Origen</dt><dd class="mt-2 font-semibold text-ink">@(string.IsNullOrWhiteSpace(product.Origin) ? "—" : product.Origin)</dd></div>
    </dl>
}

@* La partial debe permanecer suelta: contiene su propio token y sus POST independientes. *@
<section class="mt-8 border border-ink/15 bg-white p-4 sm:p-6" aria-label="Gestor de fotos del lote">
    <partial name="_ProductImageManager" model="Model" />
</section>

@section Scripts {
    <script src="~/js/bean-media.js" asp-append-version="true"></script>
}
