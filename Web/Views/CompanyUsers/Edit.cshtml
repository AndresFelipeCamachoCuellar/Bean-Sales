@model Web.Models.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Editar Usuario (Empresa)";
    Layout = "_LayoutAdminTailwind";
}

<div class="max-w-3xl border-b border-ink/15 pb-7">
    <h1 class="font-display text-3xl leading-none tracking-[-0.04em] text-ink sm:text-4xl">Editar usuario</h1>
    <p class="mt-3 text-sm leading-6 text-ink/65 sm:text-base">Actualiza los datos, el rol y el estado de la cuenta.</p>
</div>

<div class="mt-6 max-w-5xl border border-ink/15 bg-white">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="m-5 hidden border border-clay bg-clay/10 p-4 text-sm font-semibold leading-6 text-clay-dark [&.validation-summary-errors]:block [&_ul]:space-y-1 sm:m-6" role="alert" aria-live="polite"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Email" />

        <fieldset class="p-5 sm:p-6">
            <legend class="w-full border-b border-ink/15 pb-3 text-base font-extrabold text-ink">Cuenta</legend>
            <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <div>
                <label asp-for="Email" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65"></label>
                <input asp-for="Email" class="mt-2 block min-h-12 w-full border border-ink/15 bg-oat/45 px-4 py-3 text-sm font-semibold text-ink/55 disabled:cursor-not-allowed" placeholder="Email" disabled aria-describedby="email-help" />
                <span id="email-help" class="mt-2 block text-xs leading-5 text-ink/55">El email de acceso no se puede cambiar aquí.</span>
            </div>
            <div>
                <label asp-for="RoleID" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65">Rol asignado</label>
                <select asp-for="RoleID" asp-items="Model.Roles" class="mt-2 block min-h-12 w-full cursor-pointer border border-ink/25 bg-white px-4 py-3 text-sm font-semibold text-ink outline-none transition-colors hover:border-ink/45 focus:border-clay focus:ring-2 focus:ring-clay/20">
                    <option value="">Selecciona un rol</option>
                </select>
                <span asp-validation-for="RoleID" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            </div>
        </fieldset>

        <fieldset class="border-t border-ink/15 p-5 sm:p-6">
            <legend class="w-full pb-3 text-base font-extrabold text-ink">Información personal</legend>
            <div class="mt-3 grid gap-5 sm:grid-cols-2">
            <div>
                <label asp-for="FirstName" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65">Nombres</label>
                <input asp-for="FirstName" class="mt-2 block min-h-12 w-full border border-ink/25 bg-white px-4 py-3 text-sm font-semibold text-ink outline-none transition-colors placeholder:text-ink/40 hover:border-ink/45 focus:border-clay focus:ring-2 focus:ring-clay/20" placeholder="Nombres" autocomplete="given-name" />
                <span asp-validation-for="FirstName" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            <div>
                <label asp-for="LastName" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65">Apellidos</label>
                <input asp-for="LastName" class="mt-2 block min-h-12 w-full border border-ink/25 bg-white px-4 py-3 text-sm font-semibold text-ink outline-none transition-colors placeholder:text-ink/40 hover:border-ink/45 focus:border-clay focus:ring-2 focus:ring-clay/20" placeholder="Apellidos" autocomplete="family-name" />
                <span asp-validation-for="LastName" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            <div>
                <label asp-for="DocumentTypeID" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65">Tipo de documento</label>
                <select asp-for="DocumentTypeID" asp-items="Model.DocumentTypes" class="mt-2 block min-h-12 w-full cursor-pointer border border-ink/25 bg-white px-4 py-3 text-sm font-semibold text-ink outline-none transition-colors hover:border-ink/45 focus:border-clay focus:ring-2 focus:ring-clay/20">
                    <option value="">Selecciona un tipo</option>
                </select>
                <span asp-validation-for="DocumentTypeID" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            <div>
                <label asp-for="DocumentNumber" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65">Número de documento</label>
                <input asp-for="DocumentNumber" class="mt-2 block min-h-12 w-full border border-ink/25 bg-white px-4 py-3 text-sm font-semibold text-ink outline-none transition-colors placeholder:text-ink/40 hover:border-ink/45 focus:border-clay focus:ring-2 focus:ring-clay/20" placeholder="Número de documento" />
                <span asp-validation-for="DocumentNumber" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            <div>
                <label asp-for="CountryID" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65">País</label>
                <select asp-for="CountryID" asp-items="Model.Countries" class="mt-2 block min-h-12 w-full cursor-pointer border border-ink/25 bg-white px-4 py-3 text-sm font-semibold text-ink outline-none transition-colors hover:border-ink/45 focus:border-clay focus:ring-2 focus:ring-clay/20">
                    <option value="">Selecciona un país</option>
                </select>
                <span asp-validation-for="CountryID" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            <div>
                <label asp-for="Gender" class="font-data text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/65">Género</label>
                <select asp-for="Gender" class="mt-2 block min-h-12 w-full cursor-pointer border border-ink/25 bg-white px-4 py-3 text-sm font-semibold text-ink outline-none transition-colors hover:border-ink/45 focus:border-clay focus:ring-2 focus:ring-clay/20">
                    <option value="">Selecciona una opción</option>
                    <option value="Male">Masculino</option>
                    <option value="Female">Femenino</option>
                    <option value="Other">Otro</option>
                </select>
                <span asp-validation-for="Gender" class="block pt-2 text-xs font-bold leading-5 text-clay-dark [&.field-validation-valid]:hidden" aria-live="polite"></span>
            </div>
            </div>
        </fieldset>

        <fieldset class="border-t border-ink/15 p-5 sm:p-6">
            <legend class="text-base font-extrabold text-ink">Estado</legend>
            <label class="mt-4 flex min-h-12 cursor-pointer items-center gap-3 border border-ink/15 bg-cream/55 px-4 py-3 transition-colors hover:border-clay">
                <input class="size-5 cursor-pointer accent-clay focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2" type="checkbox" asp-for="Status">
                <span>
                    <span class="block text-sm font-extrabold text-ink">Usuario activo</span>
                    <span class="mt-0.5 block text-xs leading-5 text-ink/55">Permite que esta cuenta siga accediendo a la plataforma.</span>
                </span>
            </label>
        </fieldset>

        <div class="flex flex-col-reverse gap-3 border-t border-ink/15 bg-cream/55 p-5 sm:flex-row sm:justify-end sm:p-6">
            <a asp-action="Index" class="inline-flex min-h-11 cursor-pointer items-center justify-center border border-ink/25 px-5 py-3 text-sm font-extrabold text-ink transition-colors hover:border-clay hover:text-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay">Cancelar</a>
            <button type="submit" class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 bg-clay px-5 py-3 text-sm font-extrabold text-white transition-colors hover:bg-clay-light focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2 focus-visible:ring-offset-cream">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h12l2 2v14H5V4Z" /><path d="M8 4v6h8V4M8 20v-6h8v6" /></svg>
                Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
