@model IEnumerable<Web.Models.Country>

<form asp-controller="Home" asp-action="SetCountry" method="post" class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100 navbar-search">
    <div class="input-group">
        <label class="d-none d-lg-inline small text-gray-600 me-2">País de Envío:</label>
        <select name="countryId" class="form-control bg-light border-0 small" onchange="this.form.submit()" style="max-width: 150px;">
            @foreach (var country in Model)
            {
                if (ViewBag.SelectedCountryId != null && (Guid)ViewBag.SelectedCountryId == country.CountryID)
                {
                    <option value="@country.CountryID" selected>@country.Name</option>
                }
                else
                {
                    <option value="@country.CountryID">@country.Name</option>
                }
            }
        </select>
         <div class="input-group-append">
            <button class="btn btn-primary" type="button">
                <i class="fas fa-globe fa-sm"></i>
            </button>
        </div>
    </div>
</form>
