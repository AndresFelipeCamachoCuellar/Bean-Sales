@{
    var signedIn = User.Identity?.IsAuthenticated ?? false;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Bean Panel</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
    <!-- Google Fonts: Bitter (titulares) + DM Sans (cuerpo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <!-- Design system del rediseño aprobado -->
    <link rel="stylesheet" href="~/css/bean-theme.css" asp-append-version="true" />
</head>
<body class="bean-admin">

    @if (signedIn)
    {
        <partial name="_Sidebar" />
    }

    <div class="bean-admin-main @(signedIn ? "" : "no-sidebar")">
        <div class="bean-admin-topbar">
            @if (signedIn)
            {
                <button type="button" id="adminSidebarToggle" class="bean-admin-hamburger" aria-label="Menú">
                    <i class="fas fa-bars"></i>
                </button>
            }
            else
            {
                <a class="bean-admin-brand" asp-area="" asp-controller="Home" asp-action="Index" style="padding-bottom:0;">
                    <span class="bean-drop"></span>
                    <span class="wm" style="color:var(--bean-ink);">Bean</span>
                </a>
            }

            <div class="spacer"></div>

            <!-- Selector de país (ViewComponent existente: postea a Home/SetCountry) -->
            <div class="bean-admin-country">
                <i class="fas fa-globe fa-sm"></i>
                @await Component.InvokeAsync("CountrySelector")
            </div>

            @if (signedIn)
            {
                <button type="button" class="bean-admin-bell" title="Notificaciones">
                    <i class="far fa-bell"></i>
                    <span class="dot"></span>
                </button>
            }

            <div class="bean-admin-userbar">
                <partial name="_LoginPartial" />
            </div>
        </div>

        <main role="main">
            <div class="bean-admin-surface">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Toggle del sidebar del panel en móvil.
        (function () {
            var btn = document.getElementById('adminSidebarToggle');
            var side = document.getElementById('adminSidebar');
            if (btn && side) {
                btn.addEventListener('click', function () { side.classList.toggle('open'); });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
