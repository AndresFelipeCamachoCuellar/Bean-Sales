<footer class="bg-ink text-white">
    <div class="mx-auto max-w-[90rem] px-4 py-14 sm:px-6 lg:px-10 lg:py-20">
        <div class="grid gap-12 border-b border-white/10 pb-14 md:grid-cols-12">
            <div class="md:col-span-5">
                <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-3 font-display text-2xl tracking-[-0.04em] focus:outline-none focus-visible:ring-2 focus-visible:ring-clay-light">
                    <span class="size-7 rotate-45 rounded-[65%_65%_65%_20%] bg-clay" aria-hidden="true"></span> BEAN
                </a>
                <p class="mt-5 max-w-md text-base leading-7 text-husk">Café colombiano de especialidad, reunido lote por lote y entregado con su origen intacto.</p>
            </div>
            <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-7">
                <div>
                    <h2 class="font-data text-[11px] uppercase tracking-[0.18em] text-clay-light">Comprar</h2>
                    <div class="mt-4 flex flex-col gap-3 text-sm font-semibold text-husk">
                        <a asp-controller="Home" asp-action="Index" asp-fragment="lotes" class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-clay-light">Catálogo</a>
                        <a asp-controller="Home" asp-action="Origenes" class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-clay-light">Orígenes</a>
                        <a asp-controller="Cart" asp-action="Index" class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-clay-light">Carrito</a>
                    </div>
                </div>
                <div>
                    <h2 class="font-data text-[11px] uppercase tracking-[0.18em] text-clay-light">Bean</h2>
                    <div class="mt-4 flex flex-col gap-3 text-sm font-semibold text-husk">
                        <a asp-controller="Home" asp-action="Nosotros" class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-clay-light">Nosotros</a>
                        <a asp-controller="Account" asp-action="RegisterProvider" class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-clay-light">Para negocios</a>
                    </div>
                </div>
                <div>
                    <h2 class="font-data text-[11px] uppercase tracking-[0.18em] text-clay-light">Legal</h2>
                    <div class="mt-4 flex flex-col gap-3 text-sm font-semibold text-husk">
                        <a asp-controller="Home" asp-action="Privacy" class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-clay-light">Privacidad</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="flex flex-col gap-3 pt-6 font-data text-[10px] uppercase tracking-[0.14em] text-husk sm:flex-row sm:items-center sm:justify-between">
            <span>&copy; @DateTime.Now.Year Bean</span>
            <span>Café colombiano · Colombia</span>
        </div>
    </div>
</footer>
