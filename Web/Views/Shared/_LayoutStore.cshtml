@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Web.Models
@using Web.Models.Enums
@using Web.Services
@using Web.Constants
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IPermissionService PermissionService
@inject Web.Data.ApplicationDbContext Context
@{
    // Contador de la bolsa (placeholder: se muestra sólo si el controlador lo expone en ViewBag.CartCount).
    var cartCount = ViewBag.CartCount as int?;

    // --- Puente storefront -> back-office -------------------------------
    // Detección de rol por claims (sin tocar la BD).
    var isSignedIn = SignInManager.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && User.IsInRole(Web.Constants.Roles.SuperAdmin);
    var isProviderRole = isSignedIn && User.IsInRole(Web.Constants.Roles.ProviderAdmin);
    var isStaff = isSuperAdmin || isProviderRole;

    // Las consultas (UserManager / PermissionService / DbContext) se ejecutan
    // SÓLO para staff: un cliente o un anónimo no dispara ninguna query aquí.
    ApplicationUser? navUser = null;
    var canReadUsers = false;
    var canReadRoles = false;
    var canReadApprovals = false;
    var canReadProducts = false;
    var canReadCompanyProfile = false;
    var pendingApprovals = 0;

    if (isStaff)
    {
        navUser = await UserManager.GetUserAsync(User);
        if (navUser != null)
        {
            if (isSuperAdmin)
            {
                canReadUsers = await PermissionService.HasPermissionAsync(navUser, Modules.Users, Permissions.Read);
                canReadRoles = await PermissionService.HasPermissionAsync(navUser, Modules.Roles, Permissions.Read);
                canReadApprovals = await PermissionService.HasPermissionAsync(navUser, Modules.ProductApprovals, Permissions.Read);
            }
            else
            {
                canReadProducts = await PermissionService.HasPermissionAsync(navUser, Modules.Products, Permissions.Read);
                canReadCompanyProfile = await PermissionService.HasPermissionAsync(navUser, Modules.CompanyProfile, Permissions.Read);
            }
        }

        if (canReadApprovals)
        {
            pendingApprovals = await Context.Products
                .CountAsync(p => p.ProductStatus == ProductStatus.PendingApproval && p.Status);
        }
    }

    // La píldora sólo aparece si el destino es realmente accesible (evita 403).
    var showPanelPill = isSuperAdmin || (isProviderRole && canReadProducts);

    // Nombre visible: FirstName si lo tenemos cargado (staff), si no el UserName del claim.
    var navDisplayName = !string.IsNullOrWhiteSpace(navUser?.FirstName)
        ? navUser!.FirstName
        : (User.Identity?.Name ?? "Mi cuenta");
    var navInitial = navDisplayName.Trim().Length > 0 ? navDisplayName.Trim().Substring(0, 1) : "U";
    var navRoleLabel = isSuperAdmin ? "Administrador" : (isProviderRole ? "Proveedor verificado" : "Cliente");
    // Dashboard es [Authorize(Roles = SuperAdmin)]: el proveedor va a su propio panel.
    var panelController = isSuperAdmin ? "Dashboard" : "Products";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Bean</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Google Fonts: Bitter (titulares) + DM Sans (cuerpo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <!-- Design system del rediseño aprobado -->
    <link rel="stylesheet" href="~/css/bean-theme.css" asp-append-version="true" />
</head>
<body class="bean-store">
    <header>
        <nav class="bean-nav">
            <div class="bean-container bean-nav-inner">
                <a class="bean-brand" asp-controller="Home" asp-action="Index">
                    <span class="bean-drop"></span> Bean
                </a>
                <div class="bean-nav-links">
                    <a class="bean-nav-link active" asp-controller="Home" asp-action="Index">Catálogo</a>
                    <a class="bean-nav-link" asp-controller="Home" asp-action="Index">Orígenes</a>
                    <a class="bean-nav-link" asp-controller="Home" asp-action="Index">Mayoreo</a>
                    <a class="bean-nav-link" asp-controller="Home" asp-action="Privacy">Nosotros</a>
                </div>

                <div class="bean-nav-spacer"></div>

                <div class="bean-nav-actions">
                    <!-- Selector de país (ViewComponent existente: postea a Home/SetCountry) -->
                    <div class="bean-country">
                        <span class="bean-dot-pulse"></span>
                        @await Component.InvokeAsync("CountrySelector")
                    </div>

                    <!-- Toggle idioma (placeholder de UI bilingüe ES/EN) -->
                    <button type="button" class="bean-lang-toggle" title="Idioma">
                        <span class="on">ES</span>·<span>EN</span>
                    </button>

                    @if (isSignedIn)
                    {
                        // Píldora "Panel": sólo staff (SuperAdmin al Dashboard, proveedor a sus productos).
                        if (showPanelPill)
                        {
                            <a class="bean-nav-panel" asp-controller="@panelController" asp-action="Index" title="Ir al panel">
                                <i class="fas fa-th-large"></i>
                                <span class="lbl">Panel</span>
                                @if (isSuperAdmin && pendingApprovals > 0)
                                {
                                    <span class="bean-nav-panel-count">@pendingApprovals</span>
                                }
                            </a>
                        }

                        <div class="bean-usermenu dropdown">
                            <button class="bean-usermenu-trigger" type="button" id="beanUserMenu"
                                    data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
                                <span class="bean-usermenu-avatar">@navInitial</span>
                                <span class="bean-usermenu-name">@navDisplayName</span>
                                <i class="fas fa-chevron-down"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end bean-usermenu-panel" aria-labelledby="beanUserMenu">
                                <div class="bean-usermenu-head">
                                    <div class="nm">@navDisplayName</div>
                                    <div class="rl">@navRoleLabel</div>
                                </div>
                                <div class="bean-usermenu-sep"></div>

                                @if (isSuperAdmin)
                                {
                                    <a class="bean-usermenu-item primary" asp-controller="Dashboard" asp-action="Index">
                                        <i class="fas fa-th-large"></i> Ir al panel
                                    </a>
                                    if (canReadApprovals)
                                    {
                                        <a class="bean-usermenu-item" asp-controller="ProductApproval" asp-action="Index">
                                            <i class="fas fa-check-double"></i> Aprobaciones
                                            @if (pendingApprovals > 0)
                                            {
                                                <span class="bean-usermenu-count">@pendingApprovals</span>
                                            }
                                        </a>
                                    }
                                    <a class="bean-usermenu-item" asp-controller="Providers" asp-action="Index">
                                        <i class="fas fa-building"></i> Empresas
                                    </a>
                                    if (canReadUsers)
                                    {
                                        <a class="bean-usermenu-item" asp-controller="Users" asp-action="Index">
                                            <i class="fas fa-users"></i> Usuarios
                                        </a>
                                    }
                                    if (canReadRoles)
                                    {
                                        <a class="bean-usermenu-item" asp-controller="Roles" asp-action="Index">
                                            <i class="fas fa-user-shield"></i> Roles
                                        </a>
                                    }
                                    <div class="bean-usermenu-sep"></div>
                                }
                                else if (isProviderRole)
                                {
                                    if (canReadProducts)
                                    {
                                        <a class="bean-usermenu-item primary" asp-controller="Products" asp-action="Index">
                                            <i class="fas fa-th-large"></i> Ir a mi panel
                                        </a>
                                        <a class="bean-usermenu-item" asp-controller="Products" asp-action="Index">
                                            <i class="fas fa-box-open"></i> Mis productos
                                        </a>
                                        <a class="bean-usermenu-item" asp-controller="SupplierOrders" asp-action="Index">
                                            <i class="fas fa-inbox"></i> Pedidos entrantes
                                        </a>
                                    }
                                    if (canReadCompanyProfile)
                                    {
                                        <a class="bean-usermenu-item" asp-controller="CompanyProfile" asp-action="Index">
                                            <i class="fas fa-building"></i> Mi empresa
                                        </a>
                                    }
                                    if (canReadProducts || canReadCompanyProfile)
                                    {
                                        <div class="bean-usermenu-sep"></div>
                                    }
                                }

                                <a class="bean-usermenu-item" asp-controller="Orders" asp-action="Index">
                                    <i class="fas fa-box"></i> Mis pedidos
                                </a>
                                <div class="bean-usermenu-sep"></div>
                                <form asp-controller="Account" asp-action="Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="bean-usermenu-form">
                                    <button type="submit" class="bean-usermenu-item bean-usermenu-logout">
                                        <i class="fas fa-sign-out-alt"></i> Salir
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a class="bean-nav-simple-right" asp-controller="Account" asp-action="Login">Entrar</a>
                    }

                    <a class="bean-bag" asp-controller="Cart" asp-action="Index" title="Ver carrito">
                        <i class="fas fa-shopping-bag"></i> Bolsa
                        @if (cartCount.HasValue && cartCount.Value > 0)
                        {
                            <span class="badge-count">@cartCount.Value</span>
                        }
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="bean-main">
        @RenderBody()
    </main>

    <footer class="bean-footer">
        <div class="bean-container">
            <div class="bean-footer-grid">
                <div class="brand-col">
                    <a class="bean-brand" asp-controller="Home" asp-action="Index"><span class="bean-drop"></span> Bean</a>
                    <p>Comercio internacional de café de origen, del productor a tu taza.</p>
                </div>
                <div>
                    <h4>Tienda</h4>
                    <a asp-controller="Home" asp-action="Index">Catálogo</a>
                    <a asp-controller="Home" asp-action="Index">Orígenes</a>
                    <a asp-controller="Home" asp-action="Index">Mayoreo</a>
                </div>
                <div>
                    <h4>Empresa</h4>
                    <a asp-controller="Home" asp-action="Privacy">Nosotros</a>
                    <a asp-controller="Home" asp-action="Index">Productores</a>
                    <a asp-controller="Home" asp-action="Index">Contacto</a>
                </div>
                <div>
                    <h4>Ayuda</h4>
                    <a asp-controller="Home" asp-action="Index">Envíos</a>
                    <a asp-controller="Home" asp-action="Index">Devoluciones</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
