@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Web.Models
@using Web.Models.Enums
@using Web.Services
@using Web.Constants
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IPermissionService PermissionService

@inject Web.Data.ApplicationDbContext Context

@{
    var currentUser = await UserManager.GetUserAsync(User);
    string? providerName = null;
    if (currentUser?.ProviderID != null)
    {
        var provider = await Context.Providers.FindAsync(currentUser.ProviderID);
        providerName = provider?.Name;
    }

    // Rol para el badge del wordmark: PROVEEDOR (verde) si el usuario pertenece a una empresa; ADMIN (terracota) si no.
    var isProvider = currentUser?.ProviderID != null;
    var roleLabel = isProvider ? "Proveedor" : "Admin";
    var roleClass = isProvider ? "provider" : "admin";

    // Controlador actual para marcar el ítem activo.
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string ActiveIf(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? " active" : "";

    // Nombre + avatar del usuario.
    var displayName = providerName ?? currentUser?.UserName ?? User.Identity?.Name ?? "Usuario";
    var avatarInitial = !string.IsNullOrEmpty(displayName) ? displayName.Trim().Substring(0, 1) : "U";

    // Contador de productos pendientes de aprobación (solo relevante para admin).
    var isSuperAdmin = User.IsInRole(Web.Constants.Roles.SuperAdmin);
    int pendingApprovals = 0;
    if (isSuperAdmin)
    {
        pendingApprovals = await Context.Products
            .CountAsync(p => p.ProductStatus == ProductStatus.PendingApproval && p.Status);
    }
}

@if (SignInManager.IsSignedIn(User) && currentUser != null)
{
    <aside id="adminSidebar" class="bean-admin-sidebar">
        <a class="bean-admin-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="bean-drop"></span>
            <span class="wm">Bean</span>
            <span class="bean-admin-rolebadge @roleClass">@roleLabel</span>
        </a>

        <nav class="bean-admin-nav">
            @* Dashboard: solo admin (SuperAdmin). Enlace principal arriba. *@
            @if (isSuperAdmin)
            {
                <a class="bean-admin-navlink@(ActiveIf("Dashboard"))" asp-area="" asp-controller="Dashboard" asp-action="Index">
                    <i class="fas fa-chart-line"></i> <span>Dashboard</span>
                </a>
            }
            @if (await PermissionService.HasPermissionAsync(currentUser, Modules.Users, Permissions.Read))
            {
                <a class="bean-admin-navlink@(ActiveIf("Users"))" asp-area="" asp-controller="Users" asp-action="Index">
                    <i class="fas fa-users"></i> <span>Usuarios</span>
                </a>
            }
            @if (await PermissionService.HasPermissionAsync(currentUser, Modules.Roles, Permissions.Read))
            {
                <a class="bean-admin-navlink@(ActiveIf("Roles"))" asp-area="" asp-controller="Roles" asp-action="Index">
                    <i class="fas fa-user-shield"></i> <span>Roles</span>
                </a>
            }
            @if (await PermissionService.HasPermissionAsync(currentUser, Modules.CompanyProfile, Permissions.Read))
            {
                <a class="bean-admin-navlink@(ActiveIf("CompanyProfile"))" asp-area="" asp-controller="CompanyProfile" asp-action="Index">
                    <i class="fas fa-building"></i> <span>Mi Empresa</span>
                </a>
            }
            @if (await PermissionService.HasPermissionAsync(currentUser, Modules.Products, Permissions.Read))
            {
                <a class="bean-admin-navlink@(ActiveIf("Products"))" asp-area="" asp-controller="Products" asp-action="Index">
                    <i class="fas fa-box-open"></i> <span>Mis Productos</span>
                </a>
            }
            @* Pedidos entrantes: solo para proveedores (usa el mismo permiso Products/Read). *@
            @if (isProvider && await PermissionService.HasPermissionAsync(currentUser, Modules.Products, Permissions.Read))
            {
                <a class="bean-admin-navlink@(ActiveIf("SupplierOrders"))" asp-area="" asp-controller="SupplierOrders" asp-action="Index">
                    <i class="fas fa-inbox"></i> <span>Pedidos entrantes</span>
                </a>
            }

            @if (await PermissionService.HasPermissionAsync(currentUser, Modules.CompanyUsers, Permissions.Read))
            {
                <a class="bean-admin-navlink@(ActiveIf("CompanyUsers"))" asp-area="" asp-controller="CompanyUsers" asp-action="Index">
                    <i class="fas fa-users-cog"></i> <span>Usuarios (Empresa)</span>
                </a>
            }
            @if (await PermissionService.HasPermissionAsync(currentUser, Modules.CompanyRoles, Permissions.Read))
            {
                <a class="bean-admin-navlink@(ActiveIf("CompanyRoles"))" asp-area="" asp-controller="CompanyRoles" asp-action="Index">
                    <i class="fas fa-user-shield"></i> <span>Roles (Empresa)</span>
                </a>
            }
            @if (isSuperAdmin)
            {
                <a class="bean-admin-navlink@(ActiveIf("Providers"))" asp-area="" asp-controller="Providers" asp-action="Index">
                    <i class="fas fa-building"></i> <span>Empresas</span>
                </a>
                <a class="bean-admin-navlink@(ActiveIf("ProductApproval"))" asp-area="" asp-controller="ProductApproval" asp-action="Index">
                    <i class="fas fa-check-double"></i> <span>Aprobaciones</span>
                    @if (pendingApprovals > 0)
                    {
                        <span class="bean-admin-navcount">@pendingApprovals</span>
                    }
                </a>
            }
        </nav>

        <div class="bean-admin-user">
            <span class="bean-admin-avatar">@avatarInitial</span>
            <div>
                <div class="nm">@displayName</div>
                <div class="rl">@(isProvider ? "Proveedor verificado" : "Administrador")</div>
            </div>
        </div>
    </aside>
}
