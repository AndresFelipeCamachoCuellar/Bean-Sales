@using Microsoft.AspNetCore.Identity
@using Web.Models
@using Web.Services
@using Web.Constants
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IPermissionService PermissionService

@inject Web.Data.ApplicationDbContext Context

@{
    var currentUser = await UserManager.GetUserAsync(User);
    string? providerName = null;
    if (currentUser?.ProviderID != null)
    {
        var provider = await Context.Providers.FindAsync(currentUser.ProviderID);
        providerName = provider?.Name;
    }
}

@if (SignInManager.IsSignedIn(User) && currentUser != null)
{
    <div id="floating-sidebar" class="sidebar-right">
        <div class="sidebar-header">
            <div>
                <h5 class="m-0">Menú</h5>
                @if (!string.IsNullOrEmpty(providerName))
                {
                   <small class="text-white-50" style="font-size: 0.8rem;">@providerName</small>
                }
            </div>
            <button id="sidebar-toggle" class="btn btn-link text-white text-decoration-none">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="sidebar-content">
            <ul class="nav flex-column">
                @if (await PermissionService.HasPermissionAsync(currentUser, Modules.Users, Permissions.Read)) 
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="" asp-controller="Users" asp-action="Index">
                            <i class="fas fa-users me-2"></i> Usuarios
                        </a>
                    </li>
                }
                @if (await PermissionService.HasPermissionAsync(currentUser, Modules.Roles, Permissions.Read)) 
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="" asp-controller="Roles" asp-action="Index">
                            <i class="fas fa-user-shield me-2"></i> Roles
                        </a>
                    </li>
                }
                @if (await PermissionService.HasPermissionAsync(currentUser, Modules.CompanyProfile, Permissions.Read)) 
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="" asp-controller="CompanyProfile" asp-action="Index">
                            <i class="fas fa-building me-2"></i> Mi Empresa
                        </a>
                    </li>
                }
                @if (await PermissionService.HasPermissionAsync(currentUser, Modules.Products, Permissions.Read)) 
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="" asp-controller="Products" asp-action="Index">
                             <i class="fas fa-box-open me-2"></i> Mis Productos
                        </a>
                    </li>
                }
                
                @if (await PermissionService.HasPermissionAsync(currentUser, Modules.CompanyUsers, Permissions.Read)) 
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="" asp-controller="CompanyUsers" asp-action="Index">
                            <i class="fas fa-users-cog me-2"></i> Usuarios (Empresa)
                        </a>
                    </li>
                }
                @if (await PermissionService.HasPermissionAsync(currentUser, Modules.CompanyRoles, Permissions.Read)) 
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="" asp-controller="CompanyRoles" asp-action="Index">
                            <i class="fas fa-user-shield me-2"></i> Roles (Empresa)
                        </a>
                    </li>
                }
                @if (User.IsInRole(Web.Constants.Roles.SuperAdmin))
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="" asp-controller="Providers" asp-action="Index">
                            <i class="fas fa-building me-2"></i> Empresas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="" asp-controller="ProductApproval" asp-action="Index">
                            <i class="fas fa-check-double me-2"></i> Aprobaciones
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
    
    <!-- Floating Toggle Button (Visible when sidebar is closed) -->
    <button id="sidebar-open-btn" class="btn btn-primary floating-btn">
        <i class="fas fa-bars"></i>
    </button>
}
