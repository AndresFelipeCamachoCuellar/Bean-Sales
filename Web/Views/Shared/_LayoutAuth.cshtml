@*
    Layout de páginas de acceso / registro (handoff vistas 7 y 14).
    Split-screen: panel oscuro con patrón de granos a la izquierda + formulario a la derecha.
    Cada vista provee el contenido del panel via @section AuthAside (con fallback por defecto).
*@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Bean</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <link rel="stylesheet" href="~/css/bean-theme.css" asp-append-version="true" />
</head>
<body class="bean-auth-body">
    <div class="bean-auth-shell">
        <aside class="bean-auth-panel">
            @if (IsSectionDefined("AuthAside"))
            {
                @await RenderSectionAsync("AuthAside", required: false)
            }
            else
            {
                <div class="bean-auth-panel-top">
                    <a class="bean-brand" asp-controller="Home" asp-action="Index"><span class="bean-drop"></span> Bean</a>
                </div>
                <div class="bean-auth-panel-body">
                    <h2>Tu café te está esperando.</h2>
                    <p>Guarda tus lotes favoritos, sigue tus envíos y recibe primero el tueste de cada semana.</p>
                    <div class="bean-auth-panel-checks">
                        <span>Trazabilidad total</span>
                        <span>Comercio justo</span>
                    </div>
                </div>
            }
        </aside>
        <section class="bean-auth-form-side">
            <div class="bean-auth-card @(ViewData["AuthWide"] as string)">
                @RenderBody()
            </div>
        </section>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
