@model Web.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-5">
    <div class="row">
        <!-- Product Image -->
        <div class="col-md-6 mb-4">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/600x400?text=Bean+Sales" : Model.ImageUrl)" class="img-fluid rounded shadow" alt="@Model.Name" style="width: 100%; object-fit: cover;">
        </div>

        <!-- Product Details -->
        <div class="col-md-6">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Catálogo</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
                </ol>
            </nav>

            <h1 class="fw-bold mb-2">@Model.Name</h1>
            <p class="text-muted mb-4">
                Vendido por: <strong>@Model.Provider?.Name</strong>
            </p>

            <h2 class="text-success fw-bold mb-3">@Model.Price.ToString("C")</h2>

            <div class="mb-4">
                <p class="lead">@Model.Description</p>
            </div>

            <div class="card bg-light border-0 mb-4">
                <div class="card-body">
                    <h5 class="card-title">Detalles de Disponibilidad</h5>
                    <p class="card-text mb-1"><i class="fas fa-box me-2"></i> Stock Disponible: <strong>@Model.Stock</strong> unidades</p>
                    <p class="card-text mb-1"><i class="fas fa-globe me-2"></i> Países Disponibles:</p>
                    <div class="mt-2">
                        @foreach(var pc in Model.ProductCountries.Where(c => c.IsAvailable))
                        {
                            <span class="badge bg-secondary me-1">@pc.Country?.Name</span>
                        }
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2">
                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                    <input type="hidden" name="productId" value="@Model.ProductID" />
                    <!-- Quantity Selector could go here -->
                    <button class="btn btn-primary btn-lg rounded-pill w-100" type="submit">
                        <i class="fas fa-cart-plus me-2"></i> Agregar al Carrito
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                    Seguir Comprando
                </a>
            </div>
        </div>
    </div>
</div>
