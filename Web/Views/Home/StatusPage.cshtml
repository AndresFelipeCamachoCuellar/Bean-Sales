@{
    Layout = "_LayoutHome";
    var statusCode = ViewBag.StatusCode is int code ? code : 404;
    var forbidden = statusCode == 403;
    ViewData["Title"] = forbidden ? "Acceso restringido" : "Página no encontrada";
}

<section class="grid min-h-[70svh] place-items-center bg-cream px-4 py-16 sm:px-6 lg:px-10">
    <div class="grid w-full max-w-[70rem] border border-oat bg-white lg:grid-cols-12">
        <div class="bg-ink p-8 text-white sm:p-12 lg:col-span-5">
            <p class="font-data text-[10px] font-semibold uppercase tracking-[0.18em] text-clay-light">@(forbidden ? "Acceso restringido" : "Ruta sin lote")</p>
            <div class="mt-10 font-display text-8xl leading-none tracking-[-0.07em] text-clay-light" aria-hidden="true">@statusCode</div>
        </div>
        <div class="p-8 sm:p-12 lg:col-span-7">
            <h1 class="text-balance font-display text-4xl leading-[0.94] tracking-[-0.04em] sm:text-5xl">@(forbidden ? "No tienes permiso para entrar aquí." : "Esta ruta ya no está en el patio.")</h1>
            <p class="mt-6 max-w-xl text-base leading-7 text-ink/60">@(forbidden ? "Vuelve a una sección disponible para tu cuenta." : "El enlace pudo cambiar o el contenido ya no está disponible. El catálogo sigue abierto.")</p>
            <a asp-controller="Home" asp-action="Index" class="mt-8 inline-flex min-h-13 cursor-pointer items-center justify-center gap-3 bg-clay px-7 py-4 text-sm font-extrabold text-white transition-colors hover:bg-clay-light focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-4 focus-visible:ring-offset-white">
                Volver al inicio
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" /></svg>
            </a>
        </div>
    </div>
</section>
