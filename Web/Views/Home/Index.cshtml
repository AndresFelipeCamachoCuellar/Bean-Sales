@model IEnumerable<Web.Models.Product>

@{
    ViewData["Title"] = "Catálogo de Café";
}

<div class="text-center mb-5">
    <h1 class="display-4 fw-bold">Nuestro Catálogo</h1>
    <p class="lead text-muted">Los mejores granos, directamente de nuestros productores a tu taza.</p>
</div>

<div class="container">
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-search me-2"></i> No hay productos disponibles en tu región seleccionada por el momento.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm hover-shadow transition-all">
                        <!-- Placeholder Image -->
                        <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://via.placeholder.com/300x200?text=Bean+Sales" : product.ImageUrl)" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;">
                        
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@product.Name</h5>
                            <p class="card-text text-muted small">
                                <i class="fas fa-store me-1"></i> @product.Provider?.Name
                            </p>
                            <!-- Description Removed for Listing -->
                            
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-3">
                                <span class="h5 mb-0 text-success">@product.Price.ToString("C")</span>
                                <small class="text-muted">Stock: @product.Stock</small>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0 pb-3 pt-0">
                            <div class="d-grid gap-2">
                                <a asp-action="Details" asp-route-id="@product.ProductID" class="btn btn-outline-primary rounded-pill">
                                    <i class="fas fa-eye me-2"></i> Ver Detalle
                                </a>
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline w-100">
                                    <input type="hidden" name="productId" value="@product.ProductID" />
                                    <button type="submit" class="btn btn-primary rounded-pill w-100">
                                        <i class="fas fa-cart-plus me-2"></i> Agregar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    .transition-all {
        transition: all 0.3s ease;
    }
</style>
